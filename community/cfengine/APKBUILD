# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=cfengine
# Upgrade to LTS versions only: https://cfengine.com/supported-versions/
pkgver=3.23.0
pkgrel=1
pkgdesc="A systems administration tool for networks"
url="https://www.cfengine.com/"
arch="all"
license="GPL-3.0-only"
install="$pkgname.post-install"
makedepends="lmdb-dev openssl-dev>3 bison flex-dev
	acl-dev pcre-dev linux-headers libxml2-dev"
checkdepends="bash perl"
depends="procps"
subpackages="$pkgname-doc $pkgname-masterfiles::noarch"
source="https://cfengine-package-repos.s3.amazonaws.com/tarballs/cfengine-community-$pkgver.tar.gz
	https://cfengine-package-repos.s3.amazonaws.com/tarballs/cfengine-masterfiles-$pkgver.tar.gz
	alpine.patch
	"

_builddirmasterfiles="$srcdir"/cfengine-masterfiles-${pkgver%_p*}

# secfixes:
#   3.12.2-r0:
#     - CVE-2019-9929

prepare() {
	default_prepare
	update_config_sub

	# glibc specific
	rm examples/strftime.cf
	# FIXME tests fail
	rm tests/acceptance/01_vars/01_basic/os_version_major.cf
	rm tests/acceptance/01_vars/02_functions/shuffle-exact.cf
	rm tests/acceptance/05_processes/01_matching/owner.cf
	rm tests/acceptance/05_processes/01_matching/process_select_fncalls.cf
	rm tests/acceptance/05_processes/01_matching/tty.cf
	rm tests/acceptance/10_files/11_xml_edits/CFE-3806.cf
	rm tests/acceptance/22_cf-runagent/serial/cfruncommand_open.cf
	rm tests/acceptance/25_cf-execd/slow/dies_in_time.cf
	# without yaml-dev
	rm tests/acceptance/01_vars/02_functions/parseyaml_with_unquoted_values_starting_with_digits.cf
	rm examples/inline-yaml.cf

	cd "$_builddirmasterfiles"
	update_config_guess
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--with-pic \
		--prefix=/usr \
		--enable-fhs \
		--localstatedir=/var \
		--mandir=/usr/share/man \
		--with-lmdb \
		--without-pam \
		--with-libxml2
	make

	cd "$_builddirmasterfiles"
	./configure \
		--prefix=/var/lib/cfengine
	make
}

check() {
	make check || {
		cat tests/acceptance/test.log
		return 1
	}
}

package() {
	make install DESTDIR="$pkgdir"

	# not FHS but the tools seems to require those
	install -d "$pkgdir"/var/lib/cfengine/bin
	for i in "$pkgdir"/usr/bin/*; do
		ln -s ../../../../usr/bin/${i##*/} "$pkgdir"/var/lib/cfengine/bin/
	done
}

masterfiles() {
	pkgdesc="Cfengine default masterfiles"
	depends="cfengine"

	cd "$_builddirmasterfiles"
	make install DESTDIR="$subpkgdir"
}

