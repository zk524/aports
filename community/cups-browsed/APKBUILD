# Maintainer: Sertonix <sertonix@posteo.net>
pkgname=cups-browsed
pkgver=2.1.0
pkgrel=0
pkgdesc="helper daemon to browse the network for remote CUPS queues and IPP network printers"
url="https://github.com/OpenPrinting/cups-browsed"
arch="all"
license="Apache-2.0 WITH LLVM-exception"
pkggroups="lp"
makedepends="
	avahi-dev
	cups-dev
	dbus-dev
	glib-dev
	libcupsfilters-dev
	libppd-dev
	openldap-dev
	"
subpackages="$pkgname-doc"
source="https://github.com/OpenPrinting/cups-browsed/releases/download/$pkgver/cups-browsed-$pkgver.tar.xz"
# FIXME checks get stuck
options="!check"

# secfixes:
#   2.1.0-r0:
#     - CVE-2024-47176
#     - CVE-2024-47850

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var \
		--disable-static \
		--with-rcdir=no
	make
}

check() {
	make check
}

package() {
	make -j1 DESTDIR="$pkgdir" install
	chgrp -R lp "$pkgdir"/etc/cups
}

sha512sums="
