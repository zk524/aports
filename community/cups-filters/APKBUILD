# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=cups-filters
pkgver=2.0.1
pkgrel=0
pkgdesc="OpenPrinting CUPS filters"
url="https://github.com/OpenPrinting/cups-filters"
arch="all"
license="Apache-2.0 WITH LLVM-exception"
# TODO check if busybox bc is enough
depends="bc"
makedepends="
	cups-dev
	ghostscript
	libcupsfilters-dev
	libppd-dev
	linux-headers
	mupdf-tools
	"
subpackages="$pkgname-doc"
source="https://github.com/OpenPrinting/cups-filters/releases/download/$pkgver/cups-filters-$pkgver.tar.xz"

# secfixes:
#   1.28.17-r3:
#     - CVE-2023-24805

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var \
		--disable-static \
		--with-shell=/bin/sh
	make
}

check() {
	make check
}

package() {
	make -j1 DESTDIR="$pkgdir" install
}

sha512sums="
