# Maintainer: Sertonix <sertonix@posteo.net>
pkgname=libcupsfilters
pkgver=2.1.0
pkgrel=0
pkgdesc="OpenPrinting CUPS Filters - contains all the code of the filters of the former cups-filters package as library functions"
url="https://github.com/OpenPrinting/libcupsfilters"
arch="all"
license="Apache-2.0 WITH LLVM-exception"
# For compatibility
provides="cups-filters-libs=$pkgver-r$pkgrel"
# textopdf requires a monospace font. Using FreeMono here
depends="font-freefont"
makedepends="
	cups-dev
	dbus-dev
	font-dejavu
	fontconfig-dev
	ghostscript
	lcms2-dev
	libexif-dev
	libjpeg-turbo-dev
	libpng-dev
	linux-headers
	mupdf-tools
	poppler-dev
	qpdf-dev
	tiff-dev
	"
subpackages="$pkgname-dev $pkgname-doc"
source="https://github.com/OpenPrinting/libcupsfilters/releases/download/$pkgver/libcupsfilters-$pkgver.tar.xz
	bash.patch
	"


# secfixes:
#   2.1.0-r0:
#     - CVE-2024-47076

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var \
		--disable-static \
		--enable-poppler \
		--enable-dbus \
		--with-test-font-path=/usr/share/fonts/dejavu/DejaVuSans.ttf
	make
}

check() {
	make check
}

package() {
	make -j1 DESTDIR="$pkgdir" install
	#the pdf.utf-8 symlink isn't quite good enough
	ln -s pdf.utf-8.simple "$pkgdir"/usr/share/cups/charsets/pdf.UTF-8
}

