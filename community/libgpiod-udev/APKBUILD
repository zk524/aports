pkgname=libgpiod-udev
pkgver=2.2
pkgrel=1
pkgdesc="C library and tools for interacting with the linux GPIO character device - udev rules"
url="https://git.kernel.org/pub/scm/libs/libgpiod/libgpiod.git/"
arch="noarch"
license="LGPL-2.1-or-later"
depends="udev"
source="https://git.kernel.org/pub/scm/libs/libgpiod/libgpiod.git/snapshot/libgpiod-$pkgver.tar.gz"
options="!check" # no test suite

package() {
	install -Dm644 90-gpio.rules -t "$pkgdir"/usr/lib/udev/rules.d/
}

