# Maintainer: Sertonix <sertonix@posteo.net>
pkgname=libppd
pkgver=2.1.0
pkgrel=0
pkgdesc="OpenPrinting - legacy support library for PPD files"
url="https://github.com/OpenPrinting/libppd"
arch="all"
license="Apache-2.0 WITH LLVM-exception"
makedepends="
	cups-dev
	ghostscript
	libcupsfilters-dev
	mupdf-tools
	poppler-utils
	zlib-dev
	"
subpackages="$pkgname-dev $pkgname-doc"
source="https://github.com/OpenPrinting/libppd/releases/download/$pkgver/libppd-$pkgver.tar.xz"

# secfixes:
#   2.1.0-r0:
#     - CVE-2024-47175

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var \
		--disable-static
	make
}

check() {
	make check
}

package() {
	make -j1 DESTDIR="$pkgdir" install
}

sha512sums="
