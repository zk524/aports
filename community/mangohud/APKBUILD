# Maintainer: Marian Buschsieweke <marian.buschsieweke@posteo.net>
pkgname=mangohud
pkgver=0.8.1
pkgrel=0
pkgdesc="Vulkan and OpenGL overlay for monitoring FPS, temperatures, CPU/GPU load and more"
url="https://github.com/flightlessmango/MangoHud"
# s390x: See https://github.com/flightlessmango/MangoHud/issues/1330
arch="all !s390x"
license="MIT"
subpackages="$pkgname-doc"
makedepends="
	appstream
	dbus-dev
	glew-dev
	glfw-dev
	glslang-dev
	libx11-dev
	libxkbcommon-dev
	libxrandr-dev
	mesa-dev
	meson
	ninja
	nlohmann-json
	py3-mako
	sdl2-dev
	spdlog-dev
	vulkan-headers
	vulkan-loader-dev
	wayland-dev
	"
checkdepends="
	cmocka-dev
	"
source="
	https://github.com/flightlessmango/MangoHud/releases/download/v$pkgver/MangoHud-v$pkgver-Source.tar.xz
	"
builddir="$srcdir/MangoHud-v$pkgver"

build() {
	abuild-meson \
		-Dappend_libdir_mangohud=false \
		-Dimgui:glfw=enabled \
		-Dimgui:opengl=enabled \
		-Dimgui:sdl2=enabled \
		-Dimgui:vulkan=enabled \
		-Dmangoapp=true \
		-Dmangohudctl=true \
		-Dtests=enabled \
		-Dwith_dbus=enabled \
		-Dwith_wayland=enabled \
		-Dwith_xnvctrl=disabled \
		. output
	meson compile -C output
}

check() {
	meson test --no-rebuild -v -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
88c18e82dbfb1355168813cc299108a27c0472d6837fceacb08bb16130310f47494f2b75316a054f919990d5d1c524c24d94ac4897156865d23999547ce00392  MangoHud-v0.8.1-Source.tar.xz
"
