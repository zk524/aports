# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=nimble
pkgver=0.18.2
pkgrel=0
pkgdesc="Package manager for the Nim programming language"
url="https://github.com/nim-lang/nimble"
arch="all !s390x" # blocked by nim
license="BSD-3-Clause"
depends="nim libssl3"
subpackages="$pkgname-bash-completion $pkgname-zsh-completion"
_nimbleReleaseCommit="6ba10a435bac800f5fd18bd4afa2870b0bfb7f14"
_checksumsStableCommit="3fa15df7d27ecef624ed932d60f63d6a8949618d"
_satStableCommit="faf1617f44d7632ee9601ebc13887644925dcc01"
_zippyStableCommit="a99f6a7d8a8e3e0213b3cad0daf0ea974bf58e3f"
source="https://github.com/nim-lang/nimble/archive/v$pkgver/nimble-$pkgver.tar.gz
	https://github.com/nim-lang/checksums/archive/$_checksumsStableCommit.tar.gz
	https://github.com/nim-lang/sat/archive/$_satStableCommit.tar.gz
	https://github.com/guzba/zippy/archive/$_zippyStableCommit.tar.gz
"

# TODO: Fix tests
options="!check"

prepare() {
	default_prepare

	cp -r ../sat-$_satStableCommit/* vendor/sat
	cp -r ../checksums-$_checksumsStableCommit/* vendor/checksums
	cp -r ../zippy-$_zippyStableCommit/* vendor/zippy

	# XXX: This is a workaround for missing option in unittest to skip/exclude
	# particular suite(s).
	# - Remove test suite "issues" - some tests require additional dependencies
	#   and/or are too complex and takes eternity to complete.
	# - Additionaly, we have to remove test "compile without warnings" because
	#   it runs tester.nim with linter; after we removed the "issues" test
	#   suite, there are some unused functions, so this test doesn't pass.
	sed -i \
		-e '/^suite "issues":/,/^suite /d' \
		-e '/test "compilation without warnings":/,/test "/d' \
		tests/tester.nim
}

build() {
	nim compile -d:git_revision_override="$_nimbleReleaseCommit" -d:release src/nimble
}

check() {
	unset GIT_CEILING_DIRECTORIES
	cd tests
	nim c -r tester
}

package() {
	install -D -m 755 src/nimble "$pkgdir"/usr/bin/nimble

	install -D -m 644 nimble.zsh-completion \
		"$pkgdir"/usr/share/zsh/site-functions/_nimble

	install -D -m 644 nimble.bash-completion \
		"$pkgdir"/usr/share/bash-completion/completions/nimble
}
