# Contributor: Maxim Karasev <begs@disroot.org>
# Maintainer: Dhruvin Gandhi <contact@dhru.vin>
pkgname=nvim-lspconfig
pkgver=2.3.0
pkgrel=0
pkgdesc="quickstart configurations for the neovim LSP client"
url="https://github.com/neovim/nvim-lspconfig"
arch="noarch"
license="Apache-2.0"
subpackages="$pkgname-doc $pkgname-autoenable"
source="https://github.com/neovim/nvim-lspconfig/archive/refs/tags/v$pkgver/nvim-lspconfig-$pkgver.tar.gz"
depends="neovim"
options="!check" # requires vusted

build() {
	nvim -u NONE -i NONE -e --headless -c "helptags doc" -c quit
}

package() {
	find lua plugin doc -type f -exec install -Dvm644 '{}' \
		"$pkgdir/usr/share/nvim/site/pack/dist/opt/$pkgname/{}" \;
	install -Dm644 doc/*.md README.md -t "$pkgdir"/usr/share/doc/$pkgname

	install -d "$pkgdir"/usr/share/nvim/site/after/plugin
	cat > "$pkgdir"/usr/share/nvim/site/after/plugin/$pkgname.lua <<-EOF
	vim.cmd 'packadd $pkgname'
	EOF
}

autoenable() {
	install_if="$pkgname=$pkgver-r$pkgrel nvim-autoenable"
	amove usr/share/nvim/site/after
}

doc() {
	default_doc
	amove usr/share/nvim/site/pack/dist/opt/$pkgname/doc
}

sha512sums="
f12b3b3dc9da2c87ca40c8ae7a29485a5fd0afca96346cd057190aa787fcfa518f14ef2cb07be7ab46824955f95b74bdae91413b4ee4ec286c60a5e80071c245  nvim-lspconfig-2.3.0.tar.gz
"
