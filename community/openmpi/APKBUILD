# Maintainer: Daniel Sabogal <dsabogalcc@gmail.com>
pkgname=openmpi
pkgver=5.0.5
pkgrel=0
pkgdesc="Message passing library for high-performance computing"
url="https://www.open-mpi.org/"
# no 32-bit support
arch="all !x86 !armhf !armv7"
license="custom" # BSD-based custom license
makedepends="
	perl
	gfortran
	hwloc-dev
	libevent-dev
	libgomp
	zlib-dev
	"
subpackages="$pkgname-dev $pkgname-doc"
source="https://www.open-mpi.org/software/ompi/v${pkgver%.*}/downloads/openmpi-$pkgver.tar.bz2"
# TODO external pmix and prrte

build() {
	CFLAGS="$CFLAGS -O2 -flto=auto" \
	CXXFLAGS="$CXXFLAGS -O2 -flto=auto" \
	./configure \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--sysconfdir=/etc/$pkgname \
		--enable-ipv6 \
		--with-hwloc=external \
		--with-libevent=external \
		--disable-static
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE

	# bundled pmix library has invalid versions
	rm "$pkgdir"/usr/lib/pkgconfig/pmix.pc
}

dev() {
	default_dev

	local i
	for i in mpiCC mpic++ mpicc mpicxx mpif77 mpif90 mpifort opal_wrapper; do
		amove usr/bin/$i
	done
}

sha512sums="
d0a137ebdeb578f0457113c6dd0f84d407c88d8f8844e6796114c8026d7391ebfb29d105f16289338eb3ac653ae9d3c0bdc4aa651402444b2ca91c1c447dc409  openmpi-5.0.5.tar.bz2
"
