# Maintainer: David Heidelberg <david@ixit.cz>
pkgname=openrw
pkgver=0_git20241211
pkgrel=0
_commit=d2335fef3ea234389308c7eb2fae51ebd6fbd2f6
pkgdesc="OpenRW 'Open ReWrite' is an un-official open source recreation of the classic Grand Theft Auto III game executable"
url="https://openrw.org/"
#arch="all"
arch="aarch64"  # FIXME for testing only
license="GPL-3.0-or-later"

# FIXME makedepends
makedepends="
	boost-dev
	bullet-dev
	bzip2-dev
	cmake
	curl-dev
	freetype-dev
	ffmpeg-dev
	gettext-dev
	glm-dev
	libpng-dev
	mesa-dev
	openal-soft-dev
	openssl-dev>3
	samurai
	sdl2-dev
	zstd-dev
	"
_imgui_commit=801645d35092c8da0eeabe71d7c1997c47aa3648
source="$pkgname-$pkgver.tar.gz::https://github.com/okias/openrw/archive/$_commit.tar.gz
	imgui-$_imgui_commit.tar.gz::https://github.com/ocornut/imgui/archive/$_imgui_commit.tar.gz
	0001-rwengine-fix-Bullet-linkage-issues.patch
	"

builddir="$srcdir/openrw-$_commit"

prepare() {
	# imgui library
	mv -v ../imgui-$_imgui_commit/* external/imgui/imgui/

	default_prepare
}

build() {
	cmake -G Ninja -B build \
		-DCMAKE_BUILD_TYPE=Debug \
		-DBUILD_TESTS=True \
		-DENABLE_SCRIPT_DEBUG=True \
		-DDebug=True

	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

