# Contributor: Leon Marz <main@lmarz.org>
# Maintainer: Leon Marz <main@lmarz.org>
pkgname=openvdb
pkgver=12.0.0
pkgrel=0
pkgdesc="Sparse volume data structure and tools"
url="https://www.openvdb.org/"
# armhf/armv7/x86:  static assertion failed due to requirement '88U == 60U'
# s390x: tests segfault
# ppc64le/aarch64: TypeError: signedFloodFill is supported only for signed value grids
arch="x86_64 armhf armv7 x86"
license="Apache-2.0"
makedepends="cmake clang18 onetbb-dev blosc-dev boost-dev python3-dev gtest-dev samurai"
subpackages="$pkgname-static $pkgname-nanovdb:nanovdb:noarch $pkgname-tools:tools $pkgname-dev" # FIXME py3-$pkgname:python
source="$pkgname-$pkgver.tar.gz::https://github.com/AcademySoftwareFoundation/openvdb/archive/v$pkgver.tar.gz
	32-bit.patch
	"

build() {
	export CC=clang-18
	export CXX=clang++-18

	# FIXME package py3-nanobind and re-enable python module
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=True \
		-DCMAKE_BUILD_TYPE=Release \
		-DOPENVDB_BUILD_PYTHON_MODULE=OFF \
		-DOPENVDB_BUILD_UNITTESTS=ON \
		-DOPENVDB_BUILD_NANOVDB=ON \
		-DOPENVDB_ENABLE_RPATH=OFF

	cmake --build build
}

check() {
	cd build
	ctest
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

tools() {
	pkgdesc="$pkgdesc (Tools)"
	amove usr/bin
}

nanovdb() {
	pkgdesc="$pkgdesc (nanovdb)"
	amove usr/include/nanovdb
}

python() {
	pkgdesc="$pkgdesc (Python bindings)"
	amove 'usr/lib/python3*'
}

sha512sums="
