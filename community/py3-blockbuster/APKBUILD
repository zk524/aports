maintainer="fossdd <fossdd@pwned.life>"
pkgname=py3-blockbuster
pkgver=1.5.23
pkgrel=0
pkgdesc="Utility to detect blocking calls in the async event loop"
url="https://github.com/cbornet/blockbuster"
license="Apache-2.0"
arch="noarch"
depends="py3-forbiddenfruit"
makedepends="py3-gpep517 py3-setuptools py3-wheel py3-hatchling"
checkdepends="py3-pytest py3-requests py3-pytest-asyncio"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/cbornet/blockbuster/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/blockbuster-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
f3107ba7c10c88632a813def8027be5807190a36b7ee6d9f5b1408f6b18121eb0884279427ef348aa788b41f5adf1b10eb148a443c589589f42e6de8727d62e1  py3-blockbuster-1.5.23.tar.gz
"
