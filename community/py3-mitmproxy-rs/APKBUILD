# Maintainer: Michał Polański <michal@polanski.me>
pkgname=py3-mitmproxy-rs
pkgver=0.12.6
pkgrel=0
pkgdesc="mitmproxy modules written in Rust"
url="https://github.com/mitmproxy/mitmproxy_rs"
license="MIT"
arch="all"
makedepends="
	cargo
	py3-gpep517
	py3-installer
	py3-maturin
	py3-setuptools
	py3-wheel
	"
subpackages="$pkgname-pyc"
source="https://github.com/mitmproxy/mitmproxy_rs/archive/v$pkgver/py3-mitmproxy-rs-$pkgver.tar.gz"
builddir="$srcdir/mitmproxy_rs-$pkgver"
options="net" # cargo

prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cd mitmproxy-rs
	gpep517 build-wheel \
		--wheel-dir "$builddir"/.dist \
		--output-fd 3 3>&1 >&2
}

check() {
	cargo test --frozen
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
650fac0edac43567c110c7bb568535381cf38e8b23a8137523b06b57d4ef1eb4e1739b4cf0fa680a909abf98d57d72b3056399b24d1e2e426db139ab25405199  py3-mitmproxy-rs-0.12.6.tar.gz
"
