# Contributor: Guy Godfroy <guy.godfroy@gugod.fr>
# Maintainer: Fabian Affolter <fabian@affolter-engineering.ch>
pkgname=py3-paho-mqtt
pkgver=2.1.0
pkgrel=0
pkgdesc="Python3 MQTT version 3.1/3.1.1 client class"
url="https://www.eclipse.org/paho/"
arch="noarch"
license="EPL-1.0"
depends="python3"
makedepends="py3-gpep517 py3-hatchling py3-wheel"
checkdepends="py3-pytest py3-six"
subpackages="$pkgname-pyc"
source="paho-mqtt-$pkgver.tar.gz::https://github.com/eclipse/paho.mqtt.python/archive/v$pkgver.tar.gz"
builddir="$srcdir"/paho.mqtt.python-$pkgver
options="!check" # Cant make it work (ends in network timeouts)

replaces=py-paho-mqtt # Backwards compatibility
provides=py-paho-mqtt=$pkgver-r$pkgrel # Backwards compatibility

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	PYTHONPATH="$builddir"/src py.test-3
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
50e7222de62d49975e6d34136357df6e95c34034768f06e7f1d39fac280aecfb366da134f8349e7e3f358f69840ee4707ba7567955bd70bb78c737ff3959e7f3  paho-mqtt-2.1.0.tar.gz
"
