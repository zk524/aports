# Contributor: Dmitry Zakharchenko <dmitz@disroot.org>
# Maintainer: Dmitry Zakharchenko <dmitz@disroot.org>
pkgname=py3-pendulum
pkgver=3.1.0
pkgrel=0
pkgdesc="Python datetimes made easy"
url="https://pendulum.eustace.io"
arch="all"
license="MIT"
depends="python3 py3-dateutil py3-pytzdata"
makedepends="cargo py3-gpep517 py3-installer py3-maturin py3-poetry-core"
checkdepends="py3-babel
	py3-freezegun
	py3-pytest
	py3-time-machine
	py3-tz
	py3-tzdata
	"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/python-pendulum/pendulum/releases/download/$pkgver/pendulum-$pkgver.tar.gz"
builddir="$srcdir/pendulum-$pkgver"

prepare() {
	default_prepare

	cd rust
	cargo fetch --locked
}

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--config-json '{"build-args": "--frozen"}' \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
c4d3c3d3e1670683884c0c7a2781684bd4b3cb0e8b4d9bc3a8c2f933d2fbfd9550f56368e496c046ceeb1541d0e12de426c7c41bba50f594651a6b4c8963e122  py3-pendulum-3.1.0.tar.gz
"
