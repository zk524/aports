de29d1a5e068437b37f4a6d0c425a4a871be33eae9e76b5bf9ccc156a4f29fa94312814daf9b1ace3e66086421b9a1ec350a2c5a60d9c79dc5441ba3388588c1  typing-ext.patch
63e2e472eff9dcb48327c1286ffa370a7502a066a84a3adc12d26aaad47282bdb3dfb1b5d3893458643261b157f17aa607b4eec1a6d239af8133183680936b62  psycopg-binary.patch
"
