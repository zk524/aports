pkgname=py3-qt6
pkgver=6.7.1
pkgrel=0
pkgdesc="Python 3 bindings for the Qt toolkit"
url="https://www.riverbankcomputing.com/software/pyqt/"
arch="all"
license="GPL-3.0-only"
depends="
	py3-pyqt6-sip
	python3
	"
makedepends="
	libx11-dev
	py3-dbus-dev
	py3-opengl
	py3-pyqt-builder
	py3-sip
	python3-dev
	qt6-qtbase-dev
	qt6-qtconnectivity-dev
	qt6-qtdeclarative-dev
	qt6-qtmultimedia-dev
	qt6-qtserialport-dev
	qt6-qtsvg-dev
	qt6-qttools-dev
	qt6-qtwebchannel-dev
	qt6-qtwebsockets-dev
	"

subpackages="$pkgname-pyc"
source="https://pypi.python.org/packages/source/P/PyQt6/PyQt6-$pkgver.tar.gz"
builddir="$srcdir/PyQt6-$pkgver"

# FIXME: we have issues upgrading or even rebuilding py3-qt6, possibly since the
# qt6-qtbase upgrade to 6.7.2, so don't upgrade or rebuild for now.
case "$CARCH" in
riscv64)
	pkgver=6.6.1
	pkgrel=1
	;;
esac

#
# This function reads python dependency information for $_dep from $_dep_file,
# using $_dep_regex, and compares the minimum required version with the
# installed version of $_dep_pkg.
#
# The $_dep_regex must:
#  1. be compatible with busybox sed's extended regex syntax
#  2. match the entire line containing the needed version info
#  3. capture the version number in capture group 1
#
_check_dep() {
	if [ ! -f "$_dep_file" ]; then
		echo "cant read python dependency info for $_dep from $_dep_file!"
		exit 1
	fi
	_dep_need=$(sed -rn 's/'"$_dep_regex"'/\1/p' "$_dep_file")
	if [ -z "$_dep_need" ]; then
		echo "didnt find py dependency info for $_dep in $_dep_file!"
		exit 1
	fi
	_dep_have=$(apk list --installed "$_dep_pkg" | head -n1 | \
	    sed -rn 's/'"$_dep_pkg"'-(([[:digit:]]+\.?){1,3}).*/\1/p')
	_dep_cmp=$(apk version -t "$_dep_have" "$_dep_need")
	if [ $? != 0 ] || [ "$_dep_cmp" = "<" ]; then
		echo "Fails $_dep version requirement: $_dep_have $_dep_cmp $_dep_need!"
		exit 1
	fi
	echo "Satisfies $_dep version requirement: $_dep_have $_dep_cmp $_dep_need"
}

prepare() {
	default_prepare

	_dep=sip
	_dep_file="$builddir/pyproject.toml"
	_dep_regex='.*sip ?>= ?(([[:digit:]]+\.?){1,3}).*'
	_dep_pkg=py3-sip
	_check_dep

	_dep=qt6-sip-module
	_dep_file="$builddir/PKG-INFO"
	_dep_regex='.*PyQt6-sip ?\(>=(([[:digit:]]+\.?){1,3}).*'
	_dep_pkg=py3-pyqt6-sip
	_check_dep
}

build() {
	export CFLAGS="$CFLAGS -O2 -flto=auto"
	export CXXFLAGS="$CXXFLAGS -O2 -flto=auto"
	sip-build \
		--confirm-license \
		--qmake /usr/lib/qt6/bin/qmake \
		--api-dir /usr/share/qt6/qsci/api/python \
		--pep484-pyi \
		--no-make
	make -C build
}

check() {
	make -C build check
}

package() {
	make DESTDIR="$pkgdir" INSTALL_ROOT="$pkgdir" -C build install -j1
	python3 -m compileall -j 0 "$pkgdir"/usr/lib/python3*
}

