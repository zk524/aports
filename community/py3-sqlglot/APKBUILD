# Maintainer: omni <omni+alpine@hack.org>
maintainer="omni <omni+alpine@hack.org>"
pkgname=py3-sqlglot
pkgver=27.8.0
pkgrel=0
pkgdesc="Python SQL Parser and Transpiler"
url="https://github.com/tobymao/sqlglot"
arch="noarch"
license="MIT"
depends="python3"
makedepends="py3-gpep517 py3-setuptools_scm py3-wheel"
options="!check"
# tests are included in the github release tarball but seem to require
# additional aports to be added, see requirements.txt
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/s/sqlglot/sqlglot-$pkgver.tar.gz"
builddir="$srcdir/sqlglot-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
9dd51ffc3843b5f1323e8035777d76b979b3fb876f2f95c8f5a80d079c7d38daf3f951729283fd330156cd02ba0a67a74f4704108bda384e703253884fb21a15  sqlglot-27.8.0.tar.gz
"
