maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=qxmpp
pkgver=1.11.2
pkgrel=0
pkgdesc="Cross-platform C++ XMPP client and server library"
arch="all"
url="https://github.com/qxmpp-project/qxmpp"
license="LGPL-2.1-or-later"
makedepends="
	cmake
	doxygen
	graphviz
	libomemo-c-dev
	qca-qt6-dev
	qt6-qtbase-dev
	qt6-qt5compat-dev
	samurai
	"
source="https://invent.kde.org/libraries/qxmpp/-/archive/v$pkgver/qxmpp-v$pkgver.tar.gz"
subpackages="$pkgname-dev $pkgname-doc"
builddir="$srcdir/$pkgname-v$pkgver"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_EXAMPLES=OFF \
		-DBUILD_DOCUMENTATION=ON \
		-DBUILD_OMEMO=ON
	cmake --build build
}

check() {
	# tst_qxmppiceconnection and tst_qxmpptransfermanager require a network connection
	ctest --test-dir build -E "tst_qxmpp(iceconnection|transfermanager)"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
7496342789084f853c4ce7dc5757bedb9f18f356083e3169463dd8abe4dc6418a191b6077152c0c6d03c61a3d557b171106d9892494294e9e4a9c47e2d9df2ee  qxmpp-v1.11.2.tar.gz
"
