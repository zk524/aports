# Maintainer: Milan P. Stanić <mps@arvanta.net>
pkgname=vboot-utils
pkgver=20210101
_ref=506d9df62d1
pkgrel=0
pkgdesc="Chromium OS vboot utilities"
url="https://chromium.googlesource.com/chromiumos/platform/vboot_reference/+/master"
arch="armhf armv7 aarch64 x86_64 x86"
license="custom:chromiumos"
options="!check textrels" # test fails but package works
makedepends="yaml-dev xz-dev musl-fts-dev openssl-dev>3 util-linux-dev bash linux-headers"
subpackages="cgpt $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://dev.alpinelinux.org/archive/vboot_reference/vboot_reference-${_ref}.tar.gz
	"
builddir="$srcdir"

prepare() {
	default_prepare
	sed -i 's/-Werror//g' Makefile
}

build() {
	export CFLAGS="$CFLAGS -D_GNU_SOURCE -Wno-error"
	export LDLIBS="-lfts"
	local _arch=$CARCH
	case "$CARCH" in
		arm*|aarch64) _arch=arm;;
	esac
	make ARCH=$_arch MINIMAL=1 V=1 cgpt futil
}

package() {
	make DESTDIR="$pkgdir" install
	install -d "$pkgdir"/usr/share/vboot/
	cp -r tests/devkeys "$pkgdir"/usr/share/vboot/devkeys

	install -Dm644 LICENSE -t "$pkgdir"/usr/share/doc/licenses/$pkgname/
}

cgpt() {
	pkgdesc="ChromeOS GPT tool"
	mkdir -p "$subpkgdir"/usr/sbin
	mv "$pkgdir"/usr/bin/cgpt "$subpkgdir"/usr/sbin/
}

sha512sums="
88ce71feda4b3e943d4f42d822e4a12f461b10433e87a92e37b5f5acfa09255d65b99fea9d8515ab9681f571f23cec58529f8738101486d3afb718bbea8553e7  vboot-utils-20210101.tar.gz
"
