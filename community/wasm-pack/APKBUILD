# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=wasm-pack
pkgver=0.13.1
pkgrel=0
pkgdesc="rust to wasm build tool"
url="https://github.com/rustwasm/wasm-pack"
# s390x: limited by lld & rust-wasm
arch="all !s390x"
license="Apache-2.0"
depends="
	cargo
	rustc-dev
	rust-wasm
	"
makedepends="
	bzip2-dev
	cargo-auditable
	cmake
	curl-dev
	openssl-dev>3
	patchelf
	wasi-sdk
	zstd-dev
	"
source="https://github.com/rustwasm/wasm-pack/archive/refs/tags/v$pkgver/wasm-pack-v$pkgver.tar.gz"
options="net !check" # most tests fail outside of x86_64

export OPENSSL_NO_VENDOR=1

prepare() {
	default_prepare

	# Build against system-provided libzstd.
	mkdir -p .cargo
	cat >> .cargo/config.toml <<-EOF
		[target.$CHOST]
		zstd = { rustc-link-lib = ["zstd"] }
	EOF

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 target/release/wasm-pack -t "$pkgdir"/usr/bin

	cd "$pkgdir"

	# Fix wrong RUNPATH: $ORIGIN/../../../../../../../../../../usr/lib/rustlib/x86_64-alpine-linux-musl/lib
	#  -> /usr/lib/rustlib/x86_64-alpine-linux-musl/lib
	local rpath="$(patchelf --print-rpath usr/bin/wasm-pack)"
	rpath="$(realpath "${rpath#\$ORIGIN}")"
	patchelf --set-rpath "$rpath" usr/bin/wasm-pack
}

sha512sums="
9ac5c4736d78fdcff76b349635c6eb23ea9915acc87389f288b7e350bb1fcfacf222054beb090b3c8bc790371a69d223e05f3fc3a7bd4a6d4e9c8c860f4ff183  wasm-pack-v0.13.1.tar.gz
"
