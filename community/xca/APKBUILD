pkgname=xca
pkgver=2.9.0
pkgrel=0
pkgdesc="X certificate and key management"
url="https://hohnstaedt.de/xca/"
arch="all"
license="BSD-3-Clause"
depends="qt6-qtbase-sqlite"
makedepends="qt6-qttools-dev openssl-dev libtool cmake samurai"
checkdepends="xwayland-run"
subpackages="$pkgname-doc $pkgname-bash-completion"
source="https://github.com/chris2511/xca/releases/download/RELEASE.$pkgver/xca-$pkgver.tar.gz
	tests.patch
	"

build() {
	cmake -B build -G Ninja
	cmake --build build
}

check() {
	case "$CARCH" in
	# FIXME test segfaults
	riscv64) xwfb-run -- ctest --test-dir build -E 'testxca' ;;
	*) xwfb-run -- ctest --test-dir build ;;
	esac
}

package() {
	DESTDIR="$pkgdir" cmake --install build --prefix /usr
}

sha512sums="
