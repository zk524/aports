# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=zlib-ng
pkgver=2.1.8
pkgrel=1
pkgdesc="zlib replacement with optimizations for next generation systems"
url="https://github.com/zlib-ng/zlib-ng"
arch="all"
license="Zlib"
makedepends="cmake samurai"
checkdepends="gzip xxd zlib-dev"
subpackages="$pkgname-compat $pkgname-dev"
source="https://github.com/zlib-ng/zlib-ng/archive/$pkgver/zlib-ng-$pkgver.tar.gz
	zlib-copat.patch"

# secfixes:
#   2.0.6-r0:
#     - CVE-2022-37434

build() {
	_build build

	# build for zlib replacement
	_build build-compat -DZLIB_COMPAT=ON
}

_build() {
	local outdir="$1"; shift

	local crossopts=
	if [ "$CBUILD" != "$CHOST" ]; then
		crossopts="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_HOST_SYSTEM_NAME=Linux"
	fi
	# WITH_UNALIGNED - unaligned access invokes undefined behaviour,
	#   see https://github.com/gentoo/gentoo/pull/17167 for more info.
	cmake -B "$outdir" -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_VERBOSE_MAKEFILE=ON \
		-DWITH_DFLTCC_DEFLATE=ON \
		-DWITH_DFLTCC_INFLATE=ON \
		-DWITH_UNALIGNED=OFF \
		-DZLIB_ENABLE_TESTS="$(want_check && echo ON || echo OFF)" \
		-DZLIBNG_ENABLE_TESTS="$(want_check && echo ON || echo OFF)" \
		-DWITH_GTEST=OFF \
		$crossopts \
		"$@"
	cmake --build "$outdir"
}

check() {
	ctest --test-dir build --output-on-failure
	ctest --test-dir build-compat --output-on-failure
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

compat() {
	description="$description (zlib replacement)"
	provides=zlib

	DESTDIR="$subpkgdir" cmake --install "$builddir"/build-compat
}

