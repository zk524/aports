#!/bin/sh

addgroup -S fontconfig 2>/dev/null
adduser -S -D -h /var/cache/fontconfig/ -H -s /sbin/nologin -G fontconfig -g fontconfig fontconfig 2>/dev/null

# apk won't update ownership if the directory already exists.
# directory might contain non-package files anyway
chown -R fontconfig:fontconfig /var/cache/fontconfig 2> /dev/null

exit 0
