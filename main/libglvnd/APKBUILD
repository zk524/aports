# Contributor: Simon Pflaumer (spflaumer) <s.pflaumer@murena.io>
# Maintainer:
pkgname=libglvnd
pkgver=1.7.0
pkgrel=0
arch="all"
url="https://gitlab.freedesktop.org/glvnd/libglvnd"
pkgdesc="GL Vendor-Neutral Dispatch library"
license="custom:BSD-like"
source="https://gitlab.freedesktop.org/glvnd/libglvnd/-/archive/v$pkgver/libglvnd-v$pkgver.tar.gz"
builddir="$srcdir/libglvnd-v$pkgver"
subpackages="
    $pkgname-dev
    $pkgname-egl
    $pkgname-gl
    $pkgname-gles
    "

depends_dev="
	libxext-dev
	libx11-dev
	xorgproto
	"
makedepends="
	$depends_dev
	"

build() {
	abuild-meson \
		-Dx11=enabled \
		-Dglx=enabled \
		-Dgles1=true \
		-Dgles2=true \
		./ build/

	meson compile -C build/
}

package() {
	provider_priority=100
	DESTDIR="$pkgdir" meson install --no-rebuild -C build/
}

egl() {
    pkgdesc="Gl Vendor-Neutral Dispatch library (libEGL runtime libraries)"
	provider_priority=100

    amove usr/lib/libEGL.so*
}
gl() {
    pkgdesc="Gl Vendor-Neutral Dispatch library (libGL runtime libraries)"
	provider_priority=100

    amove usr/lib/libGL.so*
}
gles() {
    pkgdesc="Gl Vendor-Neutral Dispatch library (libGLES runtime libraries)"
	provider_priority=100

    amove usr/lib/libGLES*.so*
}


sha512sums="
7b6eb8e075b48f1d915b892044adc3260547d74ed61d1e2fa6c5f0f8c3527754abea314181e088626d4fd58bb221085e5288c4758d828e171c7dcb0e4991745c  libglvnd-v1.7.0.tar.gz
"
