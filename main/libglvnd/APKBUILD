# Contributor: Simon Pflaumer (spflaumer) <s.pflaumer@murena.io>
# Maintainer: Achill Gilgenast <achill@achill.org>
pkgname=libglvnd
pkgver=1.7.0
pkgrel=0
arch="all"
url="https://gitlab.freedesktop.org/glvnd/libglvnd"
pkgdesc="GL Vendor-Neutral Dispatch library"
license="custom:BSD-like"
source="
	https://gitlab.freedesktop.org/glvnd/libglvnd/-/archive/v$pkgver/libglvnd-v$pkgver.tar.gz
	remove-glx-tests.patch
	LICENSE
	"
builddir="$srcdir/libglvnd-v$pkgver"
subpackages="
	$pkgname-dev
	$pkgname-egl
	$pkgname-gl
	$pkgname-gles
	$pkgname-doc
	"

depends_dev="
	libxext-dev
	libx11-dev
	xorgproto
	"
makedepends="
	$depends_dev
	meson
	"

build() {
	abuild-meson \
		-Dx11=enabled \
		-Dglx=enabled \
		-Dgles1=true \
		-Dgles2=true \
		./ build/

	meson compile -C build/
}

check() {
	meson test -C build/
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build/
	install -Dm644 "$srcdir"/LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

egl() {
	pkgdesc="Gl Vendor-Neutral Dispatch library (libEGL runtime libraries)"

	amove usr/lib/libEGL.so*
}
gl() {
	pkgdesc="Gl Vendor-Neutral Dispatch library (libGL runtime libraries)"

	amove usr/lib/libGL.so*
}
gles() {
	pkgdesc="Gl Vendor-Neutral Dispatch library (libGLES runtime libraries)"
	provides="mesa-gles=25.1.7-r2"

	amove usr/lib/libGLES*.so*
}


