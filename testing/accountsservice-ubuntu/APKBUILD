# Contributor: Luca Weiss <luca@lucaweiss.eu>
maintainer="Aster Boese <asterboese@mailbox.org>"
pkgname=accountsservice-ubuntu
_pkgname=accountsservice
pkgver=23.13.9
pkgrel=0
pkgdesc="D-Bus interface for user account query and manipulation"
url="https://www.freedesktop.org/software/accountsservice/"
arch="all"
license="GPL-3.0-or-later"
depends_dev="gobject-introspection-dev"
makedepends="
	$depends_dev
	elogind-dev
	glib-dev
	meson
	polkit-dev
	vala
	"
subpackages="$pkgname-dev $pkgname-lang lib$pkgname:libs"
source="https://www.freedesktop.org/software/accountsservice/accountsservice-$pkgver.tar.xz
	0001-formats-locale-property.patch
	0002-create-and-manage-groups-like-on-a-debian-system.patch
	0009-language-tools.patch
	0010-set-language.patch
	0011-add-background-file-support.patch
	0012-add-keyboard-layout-support.patch
	0013-add-has-message-support.patch
	0016-add-input-sources-support.patch
	0021-support-extrausers.patch
	git_default_gdm.patch
	git_user_manager.patch
	implicit-funcs.patch
	no-check-format.patch
	tests-s-assertEquals-assertEqual.patch
	ubuntu_notest_language.patch
	musl-fgetspent_r.patch
	musl-wtmp.patch
	opt-tests.patch
	"
builddir="$srcdir/$_pkgname-$pkgver"
# mocklibc fails to build with implicits
options="!check"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dsystemdsystemunitdir=no \
		-Delogind=true \
		-Dintrospection=true \
		-Ddocbook=false \
		-Dgtk_doc=false \
		-Dadmin_group=wheel \
		-Dtests="$(want_check && echo true || echo false)" \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs --no-rebuild -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	provides="accountsservice"
	provider_priority=0
	replaces="accountsservice"
}

_dev() {
	depends="$pkgname=$pkgver-r$pkgrel"
	provides="$_pkgname-dev"
	provider_priority=0
	replaces="$_pkgname-dev"
}

_lang() {
	depends="$pkgname=$pkgver-r$pkgrel"
	provides="$_pkgname-lang"
	provider_priority=0
	replaces="$_pkgname-lang"
}

_libs() {
	depends="$pkgname=$pkgver-r$pkgrel"
	provides="lib$_pkgname"
	provider_priority=0
	replaces="lib$_pkgname"
}

