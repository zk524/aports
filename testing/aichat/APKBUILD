# Maintainer: Miles Alan <m@milesalan.com>
pkgname=aichat
pkgver=0.29.0
pkgrel=0
pkgdesc="All-in-one LLM CLI tool"
url="https://github.com/sigoden/aichat"
# loongarch64, s390x: nix crate dependency fails build
arch="all !s390x !loongarch64"
license="MIT OR Apache-2.0"
makedepends="
	cargo
	cargo-auditable
"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/sigoden/aichat/archive/refs/tags/v$pkgver.tar.gz
"
subpackages="$pkgname-doc"
options="!check" # no tests

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --frozen
}

package() {
	install -Dm644 LICENSE-APACHE LICENSE-MIT  -t "$pkgdir"/usr/share/licenses/$pkgname/
	install -Dm 755 target/release/aichat "$pkgdir"/usr/bin/aichat
}

sha512sums="
184b92096f864a739521438e0402271eeb458ceedfd9a0e795f33221697b5350fc561ecd3e70460a02ad6e44b108db814f69b2d0a05fd31a8298f12dad50186d  aichat-0.29.0.tar.gz
"
