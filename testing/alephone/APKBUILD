# Contributor: Adam Thiede <me@adamthiede.com>
# Maintainer: Adam Thiede <me@adamthiede.com>
pkgname=alephone
pkgver=20250829
pkgrel=0
pkgdesc="3D first-person shooter game"
url="https://alephone.lhowon.org/"
arch="all"
license="GPL-3.0-only"
makedepends="
	asio-dev
	autoconf
	autoconf-archive
	automake
	boost-dev
	curl-dev
	expat-dev
	gawk
	glu-dev
	libpng-dev
	libsndfile-dev
	libvorbis-dev
	openal-soft-dev
	sdl2-dev
	sdl2_image-dev
	sdl2_mixer-dev
	sdl2_net-dev
	sdl2_ttf-dev
	speex-dev
	speexdsp-dev
	zziplib-dev
"
subpackages="$pkgname-doc $pkgname-data"
source="
	marathon.desktop
	marathon2.desktop
	marathoninfinity.desktop
	$pkgname-$pkgver.tar.gz::https://github.com/Aleph-One-Marathon/alephone/archive/release-$pkgver.tar.gz
"
# download/upgrade game data after install/upgrade
install="
	$pkgname-data.post-install
	$pkgname-data.post-upgrade
"
builddir="$srcdir/$pkgname-release-$pkgver/"

build() {
	autoreconf -i
	./configure --prefix=/usr
	make
}

check() {
	make check-recursive
}

package() {
	DESTDIR="$pkgdir" make install
}

data() {
	pkgdesc="Post-install script to install Marathon data files"
	install -Dm644 "$srcdir"/marathon.desktop \
		"$subpkgdir"/usr/share/applications/marathon.desktop
	install -Dm644 "$srcdir"/marathon2.desktop \
		"$subpkgdir"/usr/share/applications/marathon2.desktop
	install -Dm644 "$srcdir"/marathoninfinity.desktop \
		"$subpkgdir"/usr/share/applications/marathoninfinity.desktop
}


