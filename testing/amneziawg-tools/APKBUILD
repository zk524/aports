pkgname=amneziawg-tools
pkgver=1.0.20241018
pkgrel=0
pkgdesc="AmneziaWG is a contemporary version of the popular VPN protocol, WireGuard"
url="https://docs.amnezia.org/documentation/amnezia-wg/"
arch="all"
license="GPL-2.0-only"
_wg_quick_deps="
	bash
	cmd:resolvconf
	iproute2
	"
makedepends="libmnl-dev $_wg_quick_deps"
depends="$pkgname-awg $pkgname-awg-quick"
install="$pkgname-openrc.post-install"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-awg:_split
	$pkgname-awg-quick:_split:noarch
	$pkgname-openrc
	"
options="!check"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/amnezia-vpn/amneziawg-tools/archive/v$pkgver.tar.gz
	wg-quick.initd
	wg-quick-different-sudo.patch
	"

build() {
	make -C src
}

package() {
	mkdir -p "$pkgdir/usr/share/doc/$pkgname"

	make -C src \
		DESTDIR="$pkgdir" \
		WITH_BASHCOMPLETION=yes \
		WITH_WGQUICK=yes \
		WITH_SYSTEMDUNITS=no \
		install

	find "$builddir"/contrib -name '.gitignore' -delete
	cp -rf "$builddir"/contrib "$pkgdir/usr/share/doc/$pkgname/"

	install -Dm755 "$srcdir"/wg-quick.initd "$pkgdir"/etc/init.d/awg-quick
}

_split() {
	local cmd=${subpkgname/$pkgname-}
	pkgdesc="$pkgdesc ($cmd)"
	case $cmd in
		awg-quick) depends="$pkgname-awg=$pkgver-r$pkgrel $_wg_quick_deps" ;;
		*) depends= ;;
	esac
	mkdir -p "$subpkgdir"/usr/bin
	mv "$pkgdir"/usr/bin/$cmd "$subpkgdir"/usr/bin/
}

