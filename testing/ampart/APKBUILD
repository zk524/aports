d52a9d8b78d65d99a502b93d57a7ffeba35beabbcf2e34d710e08b93fa8f3dca9e15346584927053ea17ea25c52ddf858a2d68cc79b0a1f6cad4a5982dccd00b  0001-io_find_disk-rewrite-for-portability-and-robustness.patch
5e64b461dbf19ddbd7587173b0fc4bef1cf92bc3b194eb272da9abbcb5c03e57a715df71e2193818f0217eed2ceb7bbaa35357ed024f8f0ff6caf784b5c6ebff  0002-meson-install-ampart-executable.patch
"
