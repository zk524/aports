# Maintainer: J. Neuschäfer <j.ne@posteo.net>
pkgname=ampart
pkgver=1.4.1
pkgrel=0
pkgdesc="A partition tool for Amlogic's proprietary emmc partition format"
url="https://github.com/7Ji/ampart"
# s390x: won't work, the code assumes a little-endian CPU
arch="all !s390x"
license="GPL-3.0-or-later"
makedepends="meson bash zlib-dev linux-headers"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/7Ji/ampart/archive/refs/tags/v$pkgver.tar.gz
	0001-io_find_disk-rewrite-for-portability-and-robustness.patch
	0002-meson-install-ampart-executable.patch"
builddir="$srcdir/ampart-$pkgver"
options="!check"  # doesn't have tests

prepare() {
	default_prepare

	# build-only-version.sh would normally determine the version based on git
	echo "echo '$pkgver-r$pkgrel (Alpine Linux)'" > scripts/build-only-version.sh
}

build() {
	abuild-meson \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -Dm644 doc/*.md   -t "$pkgdir"/usr/share/doc/"$pkgname"
	install -Dm644 doc/imgs/* -t "$pkgdir"/usr/share/doc/"$pkgname"/imgs
}

sha512sums="
