# Maintainer: Jonathan Styles <github@jontyms.com>
pkgname=apksums
pkgver=0.1.2
pkgrel=0
#_pkgreal is used by apkbuild-pypi to find modules at PyPI
_pkgreal=apksums
pkgdesc="Verify checksums of installed APK package files"
url="https://pypi.org/project/apksums/"
arch="noarch"
license="MIT"
depends="python3"
makedepends="py3-gpep517 py3-setuptools py3-wheel py3-hatchling"
checkdepends="py3-pytest"
source="https://files.pythonhosted.org/packages/source/a/apksums/apksums-$pkgver.tar.gz"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m venv --clear --without-pip --system-site-packages venv
	./venv/bin/python3 -m installer \
		.dist/*.whl

}

check() {
	python3 -m venv --clear --without-pip --system-site-packages venv
	./venv/bin/python3 -m installer \
		.dist/*.whl
	./venv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
