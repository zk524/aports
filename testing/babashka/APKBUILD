pkgname=babashka
pkgver=1.12.207
pkgrel=0
pkgdesc="Native, fast starting Clojure interpreter for scripting"
url="https://github.com/babashka/babashka"
license="GPL-3.0-or-later"
arch="x86_64" # openjdk-mandrel
makedepends="openjdk21-static-libs openjdk21 openjdk21-mandrel leiningen"

_babashka_commit="056b41a139005f42346cbef29c9b9802664fc4b3"
_bbcore_commit="52a6037bd4b632bffffb04394fb4efd0cdab6b1e"
_bbcurl_commit="e936acd40544eb637b6041c7e89454b21eb7ee34"
_bbnrepl_commit="edd3d613bfb9bf3adabfd0bda5c3f5c6ee85ec20"
_depsclj_commit="ad71e665843f133c164ffd73d3444f8b81580eea"
_depstar_commit="2bf9d3c9f15298d7dd9de033674a42f830e23d6f"
_fs_commit="eba0df764dc7c50db3f1f61f05d620af097c54ae"
_pods_commit="ed5e1f3390b9dfca564f66b6e79c739c3cd82d78"
_process_commit="35760b076eaad176a61a575b58685c3d3e475d6f"
_sci_commit="5c22ee03491c6591e5b3206c95708befcb02529b"

source="
babashka-$pkgver.tar.gz::https://github.com/babashka/babashka/archive/v$pkgver.tar.gz
https://github.com/borkdude/sci/archive/$_sci_commit.tar.gz
https://github.com/babashka/babashka.curl/archive/$_bbcurl_commit.tar.gz
https://github.com/babashka/babashka.nrepl/archive/$_bbnrepl_commit.tar.gz
https://github.com/babashka/depstar/archive/$_depstar_commit.tar.gz
https://github.com/babashka/process/archive/$_process_commit.tar.gz
https://github.com/babashka/pods/archive/$_pods_commit.tar.gz
https://github.com/borkdude/deps.clj/archive/$_depsclj_commit.tar.gz
https://github.com/babashka/fs/archive/$_fs_commit.tar.gz
https://github.com/babashka/babashka.core/archive/$_bbcore_commit.tar.gz
"

prepare() {
	default_prepare

	mv -Tv "$srcdir/sci-$_sci_commit" "$builddir/sci"
	mv -Tv "$srcdir/babashka.curl-$_bbcurl_commit" "$builddir/babashka.curl"
	mv -Tv "$srcdir/babashka.nrepl-$_bbnrepl_commit" "$builddir/babashka.nrepl"
	mv -Tv "$srcdir/depstar-$_depstar_commit" "$builddir/depstar"
	mv -Tv "$srcdir/process-$_process_commit" "$builddir/process"
	mv -Tv "$srcdir/pods-$_pods_commit" "$builddir/pods"
	mv -Tv "$srcdir/deps.clj-$_depsclj_commit" "$builddir/deps.clj"
	mv -Tv "$srcdir/fs-$_fs_commit" "$builddir/fs"
	mv -Tv "$srcdir/babashka.core-$_bbcore_commit" "$builddir/babashka.core"
}

build() {
	export BABASHKA_STATIC=true
	export BABASHKA_MUSL=true
	export GRAALVM_HOME=/usr/lib/jvm/java-21-openjdk/
	export BABASHKA_SHA="$_babashka_commit"

	lein deps
	script/uberjar
	script/compile --initialize-at-build-time=org.jsoup
}

check() {
	script/test
}

package() {
	install -Dm755 "$builddir"/bb \
		"$pkgdir"/usr/bin/bb
}

