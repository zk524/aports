pkgname=bemoji
pkgver=0.4.0
pkgrel=0
pkgdesc="Emoji picker that remembers your favorites"
url="https://github.com/marty-oehme/bemoji"
arch="noarch"
license="MIT"
checkdepends="bats bats-mock"
depends="bash curl"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/marty-oehme/bemoji/archive/v$pkgver.tar.gz
	0001-do-not-load-testing-suite-from-git-submodules.patch
	"

check() {
	bats test
}

package() {
	install -Dm755 $pkgname "$pkgdir"/usr/bin/$pkgname
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}


