# Contributor:
# Maintainer:
pkgname=calc
pkgver=2.15.1.1
pkgrel=0
pkgdesc="C-style arbitrary precision calculator"
url="http://www.isthe.com/chongo/tech/comp/calc/"
arch="all"
license="LGPL1.2"
makedepends="readline-dev"
options="!check" # testing is severily broken
#subpackages="$pkgname-doc"
source="https://github.com/lcn2/calc/releases/download/v$pkgver/calc-$pkgver.tar.bz2"
builddir="$srcdir/"

build() {
	cd "calc-$pkgver"
	make clobber calc-static-only BLD_TYPE=calc-static-only
}

package() {
	cd "calc-$pkgver"
	make -f Makefile calc-static-only install BLD_TYPE=calc-static-only
	make BINDIR="$pkgdir/bin" \
		 INCDIR="$pkgdir/include" \
		 LIBDIR="$pkgdir/lib" \
		 MANDIR="$pkgdir/man" \
		 -f Makefile calc-static-only install BLD_TYPE=calc-static-only
}
sha512sums="
