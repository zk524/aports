pkgname=cmd-polkit
pkgver=0.3.0
pkgrel=0
pkgdesc="Easily create polkit authentication agents by using commands"
url="https://github.com/OmarCastro/cmd-polkit"
arch="all"
license="LGPL-2.1-or-later"
makedepends="
	dbus
	meson
	musl-dev
	glib-dev
	json-glib-dev
	polkit-dev
	gtk+3.0-dev
"
checkdepends="valgrind meson"
source="$pkgname-$pkgver.tar.gz::https://github.com/OmarCastro/cmd-polkit/archive/refs/tags/v$pkgver.tar.gz"
options='net' #All tests fail for some reason; must look into this later

build() {
	abuild-meson --warnlevel 2\
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs --wrap='valgrind --leak-check=full' -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
