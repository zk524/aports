# Contributor: Clayton Craft <clayton@craftyguy.net>
# Maintainer: Clayton Craft <clayton@craftyguy.net>
pkgname=cosmic-ext-applet-privacy-indicator
pkgver=0.1.2
pkgrel=0
pkgdesc="Privacy indicator applet for the COSMIC Desktop Environment"
url="https://github.com/D-Brox/cosmic-ext-applet-privacy-indicator"
arch="aarch64 x86_64"
license="GPL-3.0-only"
depends="
	cosmic-applets
"
makedepends="
	cargo
	clang-libclang
	just
	libxkbcommon-dev
	pipewire-dev
"
options="net !check"  # fetch dependencies, no tests
source="$pkgname-$pkgver.tar.gz::https://github.com/D-Brox/cosmic-ext-applet-privacy-indicator/archive/refs/tags/v$pkgver.tar.gz"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	just build-release --frozen
}

check() {
	cargo test --release --frozen
}

package() {
	just rootdir="$pkgdir" install
}
sha512sums="
