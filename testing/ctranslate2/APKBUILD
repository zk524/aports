# Maintainer: Maarten van Gompel <proycon@anaproy.nl>
pkgname=ctranslate2
pkgver=4.6.0
pkgrel=0
pkgdesc="Fast inference engine for Transformer models"
url="https://opennmt.net/CTranslate2"
license="MIT"
arch="x86_64 aarch64"
options="!check" #didn't get tests to work yet
makedepends="cmake openblas-dev ninja"
subpackages="$pkgname-dev"
_cxxopts_ver=3.3.1
_spdlog_ver=1.15.3
_cpu_features_ver=0.10.1
source="$pkgname-$pkgver.tar.gz::https://github.com/OpenNMT/CTranslate2/archive/refs/tags/v$pkgver.tar.gz
cxxopts-$_cxxopts_ver.tar.gz::https://github.com/jarro2783/cxxopts/archive/refs/tags/v$_cxxopts_ver.tar.gz
spdlog-$_spdlog_ver.tar.gz::https://github.com/gabime/spdlog/archive/refs/tags/v$_spdlog_ver.tar.gz
cpu_features-$_cpu_features_ver.tar.gz::https://github.com/google/cpu_features/archive/refs/tags/v$_cpu_features_ver.tar.gz
"
builddir="$srcdir/CTranslate2-$pkgver"

build() {
	mv $srcdir/cxxopts-$_cxxopts_ver/* third_party/cxxopts
	mv $srcdir/spdlog-$_spdlog_ver/* third_party/spdlog
	mv $srcdir/cpu_features-$_cpu_features_ver/* third_party/cpu_features
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DOPENMP_RUNTIME=COMP \
		-DWITH_MKL=OFF \
		-DWITH_OPENBLAS=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

