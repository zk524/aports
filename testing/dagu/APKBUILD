# Contributor: Kévin Guignard <alpinelinux@melua.fr>
# Maintainer: Kévin Guignard <alpinelinux@melua.fr>
pkgname=dagu
pkgver=1.22.2
pkgrel=0
pkgdesc="Lightweight, powerful workflow engine with Web UI"
url="https://dagu.cloud"
arch="all"
license="GPL-3.0-only"
makedepends="go"
install="$pkgname.pre-install"
subpackages="$pkgname-openrc"
options="net"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/dagu-org/dagu/archive/v$pkgver.tar.gz
	dagu.initd
	dagu.confd
	dagu.yaml
	example.yaml
	README.txt
	"

export BUILDVER="$pkgver ($CBUILD)"

build() {
	go build -v -ldflags="-X 'main.version=$BUILDVER'" -o bin/$pkgname ./cmd	
}

check() {
	if [ "$(./bin/$pkgname version 2>&1)" != "$BUILDVER" ]; then
		error "$pkgname built with invalid version"
		return 1
	fi
}

package() {
	install -m755 -D bin/$pkgname "$pkgdir"/usr/bin/$pkgname 	
	install -m755 -D "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -m644 -D "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname
	install -m644 -D "$srcdir"/$pkgname.yaml -t "$pkgdir"/etc
	install -m644 -D "$srcdir"/example.yaml "$pkgdir"/etc/$pkgname.d/example.yaml.disabled
	install -m644 -D "$srcdir"/README.txt "$pkgdir"/etc/$pkgname.d/README
}

