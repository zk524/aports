# Maintainer: ovf <ovf@mm.st>
pkgname=dterm
_commit=dea09ce4d1e1c651100254979519ce2d5c2cd62b
pkgver=0.5_git20200813
pkgrel=0
pkgdesc="A simple terminal program"
url="https://github.com/hefloryd/dterm"
arch="all"
license="GPL-2.0-only"
source="https://github.com/hefloryd/dterm/archive/$_commit/dterm-$_commit.tar.gz"
options="!check" #no tests
builddir="$srcdir/$pkgname-$_commit"

prepare() {
	default_prepare

	sed 's|sys/signal.h|signal.h|' -i dterm.c
}

build() {
	make READLINE= VERSION=$pkgver
}

package() {
	install -Dt "$pkgdir/usr/bin" dterm
}

sha512sums="
