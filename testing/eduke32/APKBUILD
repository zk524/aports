maintainer="ovf <ovf@mm.st>"
pkgname=eduke32
_ver=20250813-10626-126f35ca8
pkgver=${_ver/-*}
pkgrel=0
pkgdesc="Advanced Duke Nukem 3D and Shadow Warrior (BUILD engine) source port"
url="https://www.eduke32.com/"
arch="aarch64 riscv64 x86_64"
license="GPL-2.0-only"
makedepends="sdl2-dev libvpx-dev alsa-lib-dev flac-dev"
source="https://dukeworld.com/eduke32/synthesis/$_ver/eduke32_src_$_ver.tar.xz eduke32-no-execinfo.patch"
options="!check"
builddir="$srcdir/eduke32_$_ver"

build() {
	make duke3d sw
}

package() {
	install -Dm 755 -t "$pkgdir"/usr/bin eduke32 mapster32 voidsw wangulator
	install -Dm 644 -t "$pkgdir"/usr/share/licenses/$pkgname source/build/buildlic.txt
}

