# Contributor: Angelo Verlain <hey@vixalien.com>
maintainer="Angelo Verlain <hey@vixalien.com>"
pkgname=elementary-session
pkgver=8.0.1
pkgrel=0
pkgdesc="Session settings for elementary OS"
url="https://github.com/elementary/session-settings"
arch="noarch !armhf" # missing orca
license="GPL-3.0"
depends="
	dconf
	gala
	gnome-keyring
	gcr-ssh-agent
	gnome-settings-daemon
	onboard
	orca
	touchegg
	xdg-user-dirs
"
makedepends="
	desktop-file-utils
	gnome-settings-daemon-dev
	meson
	"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/elementary/session-settings/archive/refs/tags/$pkgver.tar.gz
	0000-use-gcr-for-ssh.patch
	"

builddir="$srcdir/session-settings-$pkgver"

build() {
	abuild-meson \
		-Dfallback-session=gnome \
		-Dsystemd=false \
		-Dwayland=true \
	. output
	meson compile -C output
}

check() {
	meson test --no-rebuild --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

