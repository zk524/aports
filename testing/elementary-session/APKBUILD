a637cd7d52b301ecf5262c1ddd9d675097bc440a1b0ea993c668b995cf7189e480a214f5dad73c702a3679b34e041e0b4841bf9d5c3993e103aeed7b3d45caca  0000-use-gcr-for-ssh.patch
"
