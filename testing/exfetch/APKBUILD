# Contributor: zardoz <zardoz030@gmail.com>
# Maintainer: zardoz <zardoz030@gmail.com>
pkgname=exfetch
pkgver=1.3.5
pkgrel=0
pkgdesc="Extensible system fetcher in Crystal"
url="https://codeberg.org/izder456/exfetch"
arch="x86_64 aarch64" # blocked by crystal
license="ISC"
depends="lscpu"
makedepends="crystal shards"
# shards isn't used but its required for building
subpackages="$pkgname-doc"

_baked_file_system_commit="f4f658812c5b8b404437d8cf34b72a0eb5fe7701"
source="
$pkgname-$pkgver.tar.gz::https://codeberg.org/Izder456/exfetch/archive/$pkgver.tar.gz
baked_file_system.tar.gz::https://github.com/schovi/baked_file_system/tarball/$_baked_file_system_commit
"

builddir="$srcdir/exfetch"
options="!check"

build() {
	# download dependencies if lib/baked_file_system is empty
	# --recurse-submodules would have downloaded it, but we are using a tarball
	rmdir lib/baked_file_system
	mv "$srcdir/schovi-baked_file_system-f4f6588" lib/baked_file_system
	make bin/exfetch
}

package() {
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm755 bin/exfetch "$pkgdir/usr/bin/exfetch"
	install -Dm644 packaging/exfetch.1 "$pkgdir/usr/share/man/man1/exfetch.1"
}
sha512sums="
12989f4cfde360f653ba4ecd5504f970307a27a347533274bc866d3dfc3402885084ab2fb5e7d94c25aeb7d875f30a7f7b39e3e0e19e6caf47f2786063d8e0c9  exfetch-1.3.5.tar.gz
af9206d71d5f7a6d49ba25b01e4185be93b6ec6bc7940b67bb41d3d907596af65aa91c45b8dea015c9a7a0d87e2cac05f48eea98899b3c0bf1fab662de476fcd  baked_file_system.tar.gz
"
