pkgname=flatsweep
pkgver=2024.12.23
pkgrel=0
pkgdesc="Flatpak leftover cleaner"
url="https://github.com/giantpinkrobots/flatsweep"
arch="noarch"
license="MPL-2.0"
depends=""
makedepends="appstream-glib cmake desktop-file-utils gettext glib-dev gtk-update-icon-cache meson"
checkdepends=""
install=""
subpackages="$pkgname-lang"
source="$pkgname-$pkgver.tar.gz::https://github.com/giantpinkrobots/flatsweep/archive/refs/tags/v$pkgver.tar.gz"
options="!check" #appstream validation fails

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

