maintainer="fossdd <fossdd@pwned.life>"
pkgname=foundry
pkgver=1.0_alpha
_commit="777eab17c75a86268aac0dffd60db7e55148400d"
pkgrel=0
pkgdesc="Companion command-line tool for IDE features of GNOME Builder"
url="https://gitlab.gnome.org/GNOME/foundry"
arch="all !armhf" # libpeas2
license="LGPL-2.1-or-later"
depends_libs="flatpak-xdg-utils"
makedepends="
	flatpak-dev
	glib-dev
	gobject-introspection-dev
	gom-dev
	json-glib-dev
	jsonrpc-glib-dev
	libdex-dev
	libgit2-dev
	libpeas2-dev
	libxml2-dev
	meson
	sysprof-dev
	sysprof-static
	yaml-dev
	gtksourceview5-dev
	libspelling-dev
	template-glib-dev
	cmark-dev
	webkit2gtk-6.0-dev
	"
subpackages="
	$pkgname-bash-completion
	$pkgname-dev
	$pkgname-libs
	"
source="https://gitlab.gnome.org/GNOME/foundry/-/archive/$_commit/foundry-$_commit.tar.gz
	fix-pc-ver.patch
	cli-link-against-lib.patch
	"
builddir="$srcdir/$pkgname-$_commit"

build() {
	abuild-meson \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

libs() {
	default_libs
	amove usr/lib/girepository-1.0
	amove usr/share/glib-2.0/schemas
}

