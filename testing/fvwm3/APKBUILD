# Contributor: Thomas Adam <thomas@fvwm.org>
# Maintainer: Thomas Adam <thomas@fvwm.org>
pkgname=fvwm3
pkgver=1.1.0
pkgrel=0
pkgdesc="FVWM3 - a virtual desktop window manager"
url="https://fvwm.org"
arch="all"
license="GPL-2.0-or-later"
depends="!fvwm"
makedepends="
	asciidoctor
	autoconf
	automake
	fontconfig-dev
	freetype-dev
	gettext-dev
	go
	libevent-dev
	libpng-dev
	librsvg-dev
	libx11-dev
	libxcursor-dev
	libxext-dev
	libxft-dev
	libxpm-dev
	libxrandr-dev
	libxt-dev
	perl
	readline-dev
	"
subpackages="$pkgname-doc"
source="
https://github.com/fvwmorg/fvwm3/releases/download/$pkgver/fvwm3-$pkgver.tar.gz
fvwmprompt-disable-goflags.patch
"

# bin/FvwmPrompt uses go, ensure these are set, or to use defaults if not.
export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"
export GOTMPDIR="${GOTMPDIR:-"$srcdir"}"
export GOMODCACHE="${GOMODCACHE:-"$srcdir/go"}"

# Overriding prepare() because bin/Makefile.am is patched so needs
# regenerating.
prepare() {
	default_prepare

	autoreconf -fvi
}

build() {
	./configure \
		--prefix=/usr \
		--disable-bidi \
		--enable-mandoc \
		--enable-golang
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

