4efb1640f024d5a652a29eee68bf11b2dd58ceaeb91d5e42d03ef35ed7d230dd8e8550c18ca9e608b01165af4df4cb7e5c3d4dcf5e9a12e082ededbd411669bb  fvwmprompt-disable-goflags.patch
"
