# Maintainer: Damien ABOS <damien.abos@gmail.com>
pkgname=glpi
pkgver=10.0.19
pkgrel=0
pkgdesc="GLPI (Free IT Asset Management in french) is a web application for IT asset management and helpdesk."
url="https://glpi-project.org/"
arch="noarch"
#
options="!check net" # no test suite provided
license="AGPL-3.0-or-later"
_php="php84"
depends="
	$_php
	$_php-bz2
	$_php-common
	$_php-ctype
	$_php-curl
	$_php-dom
	$_php-exif
	$_php-fileinfo
	$_php-gd
	$_php-iconv
	$_php-intl
	$_php-ldap
	$_php-mbstring
	$_php-mysqli
	$_php-mysqlnd
	$_php-opcache
	$_php-openssl
	$_php-phar
	$_php-session
	$_php-simplexml
	$_php-sodium
	$_php-xml
	$_php-xmlreader
	$_php-xmlwriter
	$_php-zip"
install="$pkgname.pre-install $pkgname.post-install"
subpackages="$pkgname-doc
	$pkgname-apache2:_apache2:noarch
	$pkgname-nginx:_nginx:noarch
	$pkgname-fpm:_fpm:noarch"
pkgusers=$pkgname
pkggroups=$pkgname
source="$pkgname.tar.gz::https://github.com/glpi-project/glpi/releases/download/$pkgver/glpi-$pkgver.tgz
	$pkgname-console
	setup-$pkgname
	$pkgname.8
	$pkgname-console.1
	setup-$pkgname.1
	$pkgname-fpm.ini
	$pkgname-fpm.conf
	$pkgname-nginx.conf
	$pkgname-apache2.conf"

builddir="$srcdir"/$pkgname

package() {
	mkdir -p \
		"$pkgdir"/usr/bin \
		"$pkgdir"/var/lib/glpi/config \
		"$pkgdir"/var/lib/glpi/files/_cache \
		"$pkgdir"/var/lib/glpi/files/_cron \
		"$pkgdir"/var/lib/glpi/files/_dumps \
		"$pkgdir"/var/lib/glpi/files/_graphs \
		"$pkgdir"/var/lib/glpi/files/_inventories \
		"$pkgdir"/var/lib/glpi/files/_locales \
		"$pkgdir"/var/lib/glpi/files/_lock \
		"$pkgdir"/var/lib/glpi/files/_log \
		"$pkgdir"/var/lib/glpi/files/_pictures \
		"$pkgdir"/var/lib/glpi/files/_plugins \
		"$pkgdir"/var/lib/glpi/files/_rss \
		"$pkgdir"/var/lib/glpi/files/_sessions \
		"$pkgdir"/var/lib/glpi/files/_themes \
		"$pkgdir"/var/lib/glpi/files/_tmp \
		"$pkgdir"/var/lib/glpi/files/_uploads \
		"$pkgdir"/var/lib/glpi/logs \
		"$pkgdir"/var/lib/glpi/marketplace \
		"$pkgdir"/var/lib/glpi/plugins \
		"$pkgdir"/var/run/glpi \
		"$pkgdir"/var/www/glpi/logs
	
	install -Dm755 "$srcdir"/$pkgname-console -t "$pkgdir"/usr/bin/
	install -Dm755 "$srcdir"/setup-$pkgname -t "$pkgdir"/usr/sbin/
	install -Dm644 "$srcdir"/$pkgname.8 -t "$pkgdir"/usr/share/man/man8/
	install -Dm644 "$srcdir"/$pkgname-console.1 -t "$pkgdir"/usr/share/man/man1/
	install -Dm644 "$srcdir"/setup-$pkgname.1 -t "$pkgdir"/usr/share/man/man1/
	cp -r "$builddir/"* "$pkgdir"/var/www/glpi/
	chown -R $pkgusers:$pkggroups "$pkgdir"/var/lib/glpi "$pkgdir"/var/www/glpi "$pkgdir"/var/run/glpi
	chmod -R 775 "$pkgdir"/var/lib/glpi "$pkgdir"/var/www/glpi/logs "$pkgdir"/var/www/glpi/marketplace "$pkgdir"/var/www/glpi/plugins
	
}

_apache2() {
	description="$description (Apache2 configuration)"
	depends="apache2 apache-mod-fcgid $pkgname-fpm"

	mkdir -p "$subpkgdir"/etc/apache2/conf.d
	cp "$srcdir"/$pkgname-apache2.conf "$subpkgdir"/etc/apache2/conf.d/
}

_nginx() {
	description="$description (Nginx configuration)"
	depends="nginx $pkgname-fpm"
	install_if="nginx $pkgname=$pkgver-r$pkgrel"
	install="$pkgname-nginx.post-install"

	mkdir -p "$subpkgdir"/etc/nginx/http.d
	cp "$srcdir"/$pkgname-nginx.conf "$subpkgdir"/etc/nginx/http.d/
}

_fpm() {
	description="$description (PHP-FPM configuration)"
	depends="$pkgname $_php-fpm"

	mkdir -p "$subpkgdir"/etc/$_php/conf.d
	mkdir -p "$subpkgdir"/etc/$_php/php-fpm.d
	cp "$srcdir"/$pkgname-fpm.ini "$subpkgdir"/etc/$_php/conf.d/02-$pkgname.ini
	cp "$srcdir"/$pkgname-fpm.conf "$subpkgdir"/etc/$_php/php-fpm.d/$pkgname.conf
}

