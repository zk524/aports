# Contributor: George Hopkins <george-hopkins@null.net>
# Maintainer: George Hopkins <george-hopkins@null.net>
pkgname=grit
pkgver=0.1.0_alpha1725546100
_pkgver=v${pkgver/_alpha/-alpha.}
pkgrel=0
pkgdesc="Search and transform source code using GritQL"
url="https://grit.io/"
arch="all"
license="MIT"
makedepends="cargo cargo-auditable perl"
source="https://dev.alpinelinux.org/archive/grit/grit-$pkgver.tar.gz
	auditable.patch
	updater.patch"
_disturl="dev.alpinelinux.org:/archive/grit/"

export CARGO_PROFILE_RELEASE_OPT_LEVEL="z"

snapshot() {
	clean
	makedepends="git rsync tar" deps
	mkdir -p "$srcdir" && cd "$srcdir"
	git clone --filter=tree:0 -b $_pkgver https://github.com/getgrit/gritql $pkgname-$pkgver
	git -C $pkgname-$pkgver submodule update --init --depth=1
	tar -czvf $SRCDEST/$pkgname-$pkgver.tar.gz \
		--owner=0 --group=0 --mtime='1970-01-02' \
		--exclude-vcs \
		$pkgname-$pkgver
	rsync --progress -La $SRCDEST/$pkgname-$pkgver.tar.gz $_disturl
}

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build -p marzano --frozen --release
}

check() {
	cargo test -p marzano --frozen
}

package() {
	install -D -m755 target/release/marzano "$pkgdir"/usr/bin/grit
}

