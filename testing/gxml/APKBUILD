pkgname=gxml
pkgver=0.20.4
pkgrel=0
pkgdesc="GObject API for manipulating XML and Serializable framework from GObject to XML"
url="https://gitlab.gnome.org/GNOME/gxml/"
arch="all"
license="LGPL-2.1-or-later"
makedepends="meson vala libxml2-dev libgee-dev"
subpackages="$pkgname-dev $pkgname-lang $pkgname-devhelp:devhelp:noarch"
source="https://gitlab.gnome.org/GNOME/gxml/-/archive/0.20.4/gxml-0.20.4.tar.gz"

build() {
	abuild-meson \
		. output
	meson compile -C output
}

check() {
	meson test --no-rebuild --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
