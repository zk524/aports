# Contributor: Rahul Vishwakarma <rahulvs2809@gmail.com>
# Maintainer: Rahul Vishwakarma <rahulvs2809@gmail.com>
pkgname=hello-alpine
pkgver=1.0.2
pkgrel=0
pkgdesc="A simple hello alpine go application"
url="https://github.com/manzil-infinity180/hello-alpine"
arch="x86_64 aarch64"
license="Apache-2.0"

makedepends="go"

options="!check"

source="$pkgname-$pkgver.tar.gz::https://github.com/manzil-infinity180/hello-alpine/archive/refs/tags/v$pkgver.tar.gz"

build() {
        go build -o hello-alpine .
}

package() {
        install -Dm755 "$srcdir/hello-alpine" "$pkgdir/usr/bin/hello-alpine"
}

sha512sums="
