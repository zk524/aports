maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=hip
pkgver=6.4.3
pkgrel=1
pkgdesc="Heterogeneous-computing Interface for Portability"
url="https://github.com/ROCm/rocm-systems/tree/develop/projects/hip"
# armhf,armv7,ppc64le,x86,loongarch64,riscv64,s390x,aarch64: rocminfo
#arch="all !armhf !armv7 !ppc64le !x86 !loongarch64 !riscv64 !s390x !aarch64"
arch="" # FIXME: doesn't build
license="MIT"
options="!check"  # upstream tests disabled as in PKGBUILD (HIP_CATCH_TEST=0)
# XXX: roctracer seems to be used if available here
makedepends="
	comgr-dev
	clang-rocm
	hipcc
	llvm-rocm
	llvm-rocm-gtest
	llvm-rocm-static
	mesa-dev
	perl
	py3-cppheaderparser
	rocm-cmake
	rocm-core
	rocminfo
	rocprofiler-register
	rocprofiler-register-dev
	samurai
"
subpackages="$pkgname-doc"
source="
	hip-$pkgver.tar.gz::https://github.com/ROCm/hip/archive/refs/tags/rocm-$pkgver.tar.gz
	clr-$pkgver.tar.gz::https://github.com/ROCm/clr/archive/refs/tags/rocm-$pkgver.tar.gz
	hipother-$pkgver.tar.gz::https://github.com/ROCm/hipother/archive/refs/tags/rocm-$pkgver.tar.gz
	0001-Remove-harcoded-glibc-internal-types.patch
	0002-Add-missing-include.patch
"
options="!check" # no idea how to run tests
builddir="$srcdir/clr-rocm-$pkgver"

build() {
	export HIP_CLANG_PATH=/usr/lib/llvm-rocm/bin/
	export PATH="$PATH:/usr/lib/llvm-rocm/bin/"
	cmake -B build -G Ninja -Wno-dev -S "$srcdir/clr-rocm-$pkgver" \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D HIP_PLATFORM=amd \
		-D HIP_COMMON_DIR="$srcdir/hip-rocm-$pkgver" \
		-D HIPCC_BIN_DIR=/usr/bin \
		-D HIPNV_DIR="$srcdir/hipother-rocm-$pkgver/hipnv" \
		-D CLR_BUILD_HIP=ON \
		-D LLVM_ROOT=/usr/lib/llvm-rocm/ \
		-D CLR_BUILD_OCL=OFF
	cmake --build build

}

# FIXME: seems to also install hipcc???
package() {
	DESTDIR="$pkgdir" cmake --install "$builddir/build"

	install -Dm644 "$srcdir/hip-rocm-$pkgver/LICENSE.txt" \
		-t "$pkgdir/usr/share/licenses/$pkgname/"
}
