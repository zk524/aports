maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=hipcc
pkgver=6.4.3
pkgrel=1
pkgdesc="HIP compiler driver"
url="https://github.com/ROCm/llvm-project/tree/amd-staging/amd/hipcc"
arch="all"
license="MIT"
makedepends="cmake samurai"
subpackages="$pkgname-doc"
source="https://github.com/ROCm/llvm-project/archive/refs/tags/rocm-$pkgver.tar.gz"
options="!check" # not sure how to run tests, missing checkdepends
builddir="$srcdir/llvm-project-rocm-$pkgver"

build() {
	cmake -B build -G Ninja -Wno-dev \
		-S "amd/hipcc" \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_INSTALL_PREFIX=/usr
	cmake --build build

}

package() {
	DESTDIR="$pkgdir" cmake --install build
	find "$pkgdir" -name "*.bat" -delete

	install -Dm644 "$builddir/amd/hipcc/LICENSE.txt" \
		-t "$pkgdir/usr/share/licenses/$pkgname/"
}

sha512sums="
b6b4149c6426793f4497dfd1200079b0caef4d5a6f49c1f3a301d70f5f7b322b850085ff2f89d55df1dfab6d6a97948fe4084d4ec14654ee97cdab26e71a45c0  rocm-6.4.3.tar.gz
"
