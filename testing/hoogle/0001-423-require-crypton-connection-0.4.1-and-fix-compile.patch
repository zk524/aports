From 77291e895b3704ecbdb7377867f1dc5f887b6f52 Mon Sep 17 00:00:00 2001
From: Neil Mitchell <ndmitchell@gmail.com>
Date: Sun, 28 Jul 2024 22:47:04 +0100
Subject: [PATCH] #423, require crypton-connection >= 0.4.1 and fix compile
 errors

diff --git a/hoogle.cabal b/hoogle.cabal
index dafc0945..c5f4c39d 100644
--- a/hoogle.cabal
+++ b/hoogle.cabal
@@ -53,7 +53,8 @@ library
         conduit >= 1.3.0,
         conduit-extra >= 1.2.3.2,
         containers >= 0.5,
-        crypton-connection,
+        crypton-connection >= 0.4.1,
+        data-default-class,
         deepseq,
         directory,
         extra >= 1.6.6,
diff --git a/src/Input/Download.hs b/src/Input/Download.hs
index 7171f458..5d40608e 100644
--- a/src/Input/Download.hs
+++ b/src/Input/Download.hs
@@ -6,6 +6,7 @@ import System.FilePath
 import Control.Monad.Extra
 import System.Directory
 import Data.Conduit.Binary (sinkFile)
+import Data.Default.Class
 import qualified Network.HTTP.Conduit as C
 import Network.Connection
 import qualified Data.Conduit as C
@@ -45,7 +46,8 @@ downloadFile insecure file url = do
       (TLSSettingsSimple {
         settingDisableCertificateValidation = insecure,
         settingDisableSession = False,
-        settingUseServerName = False
+        settingUseServerName = False,
+        settingClientSupported = def
       }) Nothing
     runResourceT $ do
         response <- C.http request manager
