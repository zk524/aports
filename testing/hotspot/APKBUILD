# Contributor: Alex Denes <caskd@redxen.eu>
# Maintainer: Alex Denes <caskd@redxen.eu>
pkgname=hotspot
pkgver=1.5.1
pkgrel=0
pkgdesc="Linux perf GUI for performance analysis"
url="https://github.com/KDAB/hotspot"
arch="all"
license="GPL-2.0-only OR GPL-3.0-only OR custom:KDAB-commercial"
makedepends="
	ninja
	cmake>=3.1.0
	extra-cmake-modules

	threadweaver5-dev
	ki18n5-dev
	kconfigwidgets5-dev
	kcoreaddons5-dev
	kitemviews5-dev
	kitemmodels5-dev
	kio5-dev
	solid5-dev
	kwindowsystem5-dev
	knotifications5-dev
	kiconthemes5-dev
	kparts5-dev

	qt5-qtbase-dev
	kddockwidgets-dev
	gettext-dev
	desktop-file-utils
	libelf
	elfutils-dev

"
options="!check" # not sure how to list/call testing suite
[ "$DEBUG" -eq 1 ] && subpackages="$subpackages $pkgname-dbg"
source="
	$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/hotspot-v$pkgver.tar.gz
	$pkgname-PrefixTickLabels-$pkgver.tar.gz::$url/releases/download/v$pkgver/hotspot-PrefixTickLabels-v$pkgver.tar.gz
	$pkgname-perfparser-$pkgver.tar.gz::$url/releases/download/v$pkgver/hotspot-perfparser-v$pkgver.tar.gz

	0001-pid-t.diff
"
builddir="$srcdir/$pkgname"

prepare() {
	default_prepare

	# Main archive provides the directory, this replaces them
	rmdir -v "$builddir"/3rdparty/perfparser "$builddir"/3rdparty/PrefixTickLabels
	mv -v "$srcdir"/perfparser "$builddir"/3rdparty/perfparser
	mv -v "$srcdir"/PrefixTickLabels "$builddir"/3rdparty/PrefixTickLabels

	patch -p1 < "$srcdir"/0001-pid-t.diff
}

build() {
	local BUILD_TYPE=MinRelSize
	if [ "$DEBUG" -eq 1 ]; then
		BUILD_TYPE=RelwithDebInfo
	fi
	export LDFLAGS="$LDFLAGS -Wl,-z,stack-size=0x200000"

	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=$BUILD_TYPE \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=/usr/lib \
		-DCMAKE_INSTALL_LOCALSTATEDIR=/var \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DNINJA_MAX_COMPILE_JOBS=$JOBS \
		.
	ninja -C build
}

check() {
	ninja -C build test
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}

