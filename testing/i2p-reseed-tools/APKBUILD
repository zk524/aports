# Maintainer: memdmp <aports@estrogen.zone>
_pkgname="reseed-tools"
pkgname="i2p-$_pkgname"
pkgver=0.3.4
pkgrel=0
pkgdesc="A secure and efficient reseed server for the I2P network"
url="https://i2pgit.org/idk/$_pkgname"
arch="x86_64" # TODO: Test on more architectures
license="MIT"
# Depends on either i2pd or java-i2p; due to only i2pd being packaged, we just use that here
depends="i2pd"
makedepends="go"
install="$pkgname.pre-install $pkgname.post-install"
subpackages="$pkgname-openrc"
pkgusers="i2psvc"
pkggroups="i2psvc"
options="net !check" # No tests the author can find
source="$pkgname-$pkgver.tgz::https://github.com/eyedeekay/$_pkgname/archive/refs/tags/v$pkgver.tar.gz
	$pkgname.initd
	$pkgname.confd"
builddir="$srcdir/$_pkgname-$pkgver"

prepare() {
	# These packages no longer exist on github and as of v0.3.4 upstream still lists them to be sourced from there in go.mod
	# (Also, upstream references ancient (>1yr) old versions of them - maybe one should request new non-commit releases?)

	# go mod edit -replace="github.com/eyedeekay/go-i2cp@v0.0.0-20190716135428-6d41bed718b0=i2pgit.org/idk/go-i2cp@294b34da9f76311600a689d7448a1e965416bde3"
	# ^ ofc mid testing i2pgit.org starts bad gatewaying so time to go to the github mirror

	go mod edit -replace="github.com/eyedeekay/go-i2cp@v0.0.0-20190716135428-6d41bed718b0=github.com/go-i2p/go-i2cp@294b34da9f76311600a689d7448a1e965416bde3"

	# get new sums
	go mod download github.com/eyedeekay/go-i2cp

	default_prepare
}

build() {
	go build -v -tags netgo,osusergo -ldflags '-w -extldflags "-static"' -o reseed-tools
}

package() {
	install -D -m755 "reseed-tools" "$pkgdir/usr/bin/reseed-tools"
	install -g i2psvc -o i2psvc -D -d "$pkgdir/var/lib/i2p/i2p-config/reseed/"
	install -D -m644 "$srcdir/$pkgname.confd" "$pkgdir/etc/conf.d/reseed"
	install -D -m755 "$srcdir/$pkgname.initd" "$pkgdir/etc/init.d/reseed"
}

