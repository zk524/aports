ede95076a8d4ff5968c1860d035260b47c9210aab1524722816c42eb3148157e7b6ecf94ac390dba2e4a115c703cef29093e01a678a4f8e95f50183dc5ff505c  absolute_paths.patch
d14e8bd9ae79c4677fe89a5c303ae25e925abb3b879bf9bd11b395762a7e54683ddc45b73c9162f53c40de938f0213feddd0dcf5f91038367f128d2b3c9c8c1e  invidious.initd
"
