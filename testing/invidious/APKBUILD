maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=invidious
pkgver=2.20250504.0
pkgrel=0
pkgdesc="Alternative front-end to YouTube"
url="https://github.com/iv-org/invidious"
arch="x86_64 aarch64"  # other arches: missing crystal
license="AGPL-3.0-or-later"
makedepends="
	crystal
	libevent-dev
	libgcc
	libssl3
	libxml2-dev
	openssl-dev
	pcre2-dev
	shards
	sqlite-dev
	tzdata
	yaml-dev
	zlib-dev
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/iv-org/invidious/archive/refs/tags/v$pkgver.tar.gz
	absolute_paths.patch
	$pkgname.initd
	"
install="$pkgname.pre-install"
pkgusers="$pkgname"
pkggroups="$pkgname"
subpackages="$pkgname-doc $pkgname-openrc"
options="!check net" # no tests, fetches network dependencies

prepare() {
	default_prepare
	sed \
		-e 's/^CURRENT_BRANCH =.*/CURRENT_BRANCH = "release"/' \
		-e 's/^CURRENT_COMMIT  =.*/CURRENT_COMMIT  = "'$pkgver'"/' \
		-e 's/^CURRENT_VERSION =.*/CURRENT_VERSION = "'$pkgver'"/' \
		-e 's/^ASSET_COMMIT =.*/ASSET_COMMIT = "'$pkgver'"/' \
		-i src/invidious.cr
	# Note: ASSET_COMMIT is not entirely correct here, but would require manual tracking.
}

build() {
	shards install --production
	crystal build --release src/invidious.cr
}

package() {
	install -Dm 755 invidious "$pkgdir/usr/bin/invidious"

	find locales assets config/sql \
		-exec install -Dm 644 {} "$pkgdir/usr/share/invidious/{}" \;

	install -Dm 644 "config/config.example.yml" "$pkgdir/etc/invidious/config.yaml"
	install -Dm 644 "config/config.example.yml" "$pkgdir/usr/share/doc/example/invidious.yaml"

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
}

sha512sums="
