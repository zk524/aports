# Contributor: zhenruyan <admin@pkold.com>
# Maintainer: zhenruyan <admin@pkold.com>
pkgname=java-mariadb-jdbc
pkgver=3.5.5
pkgrel=1
pkgdesc="Java JDBC 4.2 (JRE 8+) driver for Mariadb/Mysql database"
url="https://mariadb.com/downloads/#connectors"
arch="noarch !aarch64 !riscv64"
license="LGPL-2.1"
makedepends="java-jdk maven"
source="$pkgname-$pkgver.tar.gz::https://github.com/mariadb-corporation/mariadb-connector-j/archive/refs/tags/$pkgver.tar.gz"
options="!check net" # A MariaDB service needs to be started for the test.
builddir="$srcdir/mariadb-connector-j-$pkgver"


build() {
	export JAVA_HOME="/usr/lib/jvm/default-jvm"
	mvn clean package -DskipTests
}

check() {
	mvn clean package
}

package() {
	install -Dm644 ./target/mariadb-java-client-$pkgver.jar "$pkgdir"/usr/share/java/$pkgname-$pkgver.jar
}

sha512sums="
