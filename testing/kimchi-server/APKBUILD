# Contributor: Keenan Gugeler <me@kgugeler.ca>
# Maintainer: Keenan Gugeler <me@kgugeler.ca>
pkgname=kimchi-server
pkgver=0.1.1
pkgrel=0
pkgdesc="Barebones HTTP server"
url="https://codeberg.org/emersion/kimchi"
license="MIT"
arch="all"
makedepends="go scdoc"
subpackages="$pkgname-doc $pkgname-openrc"
pkgusers="kimchi"
pkggroups="kimchi"
install="$pkgname.pre-install"
source="$pkgname-$pkgver.tar.gz::https://codeberg.org/emersion/kimchi/archive/v$pkgver.tar.gz
	$pkgname.initd
	config
	"
options="net !check"
builddir="$srcdir/kimchi"

export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"
export GOTMPDIR="${GOTMPDIR:-"$srcdir"}"
export GOMODCACHE="${GOMODCACHE:-"$srcdir/go"}"

build() {
	go build -ldflags="-X 'main.configPath=/etc/kimchi-server/config'" $GOFLAGS
	scdoc < kimchi.1.scd > kimchi.1
}

package() {
	install -Dm755 "$builddir"/kimchi "$pkgdir"/usr/sbin/kimchi-server
	install -Dm644 "$srcdir"/config "$pkgdir"/etc/kimchi-server/config

	install -Dm644 "$builddir"/kimchi.1 "$pkgdir"/usr/share/man/man1/kimchi-server.1

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
}
