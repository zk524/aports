# Contributor: andar1an <stephen@theandar1an.com>
# Maintainer: andar1an <stephen@theandar1an.com>
pkgname=krill
pkgver=0.15.0
pkgrel=0
pkgdesc="RPKI Certificate Authority and Publication Server written in Rust"
url="https://nlnetlabs.nl/projects/routing/krill/"
# have not determined why builds fail for listed non-arch's yet
arch="all !aarch64 !loongarch64 !armv7 !x86 !riscv64 !s390x "
options="net"
license=" MPL-2.0"
makedepends="
	cargo
	cargo-auditable
	openssl-dev
	rust
"
pkgusers="krill"
pkggroups="krill"
install="
	$pkgname.pre-install
"
subpackages="$pkgname-openrc $pkgname-doc krillup krillup-doc:krillup_doc krillta krillta-doc:krillta_doc"

# adding empty log file to move into place for default config
source="$pkgname-$pkgver.tar.gz::https://github.com/NLnetLabs/krill/archive/refs/tags/v$pkgver.tar.gz
	krill.conf
	krill.log
	$pkgname.initd
	$pkgname.confd
"

_cargo_opts="--frozen --release"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET"
}

build() {
	cargo auditable build -p krill $_cargo_opts
}

krillup() {
	pkgdesc="$pkgdesc upgrade command line utility"

	install -dm755 "$subpkgdir"/usr/bin
	install -Dm755 "$builddir"/target/release/krillup "$subpkgdir"/usr/bin/
}

krillup_doc() {
	install -dm755 "$subpkgdir"/usr/share/man/man1
	install -Dm644 "$builddir"/doc/krillup.1 -t "$subpkgdir"/usr/share/man/man1/krillup.1
	default_doc
}

krillta() {
	pkgdesc="$pkgdesc trust anchor command line utility"

	install -dm755 "$subpkgdir"/usr/bin
	install -Dm755 "$builddir"/target/release/krillta "$subpkgdir"/usr/bin/
}

krillta_doc() {
	install -dm755 "$subpkgdir"/usr/share/man/man1
	install -Dm644 "$builddir"/doc/krillta.1 -t "$subpkgdir"/usr/share/man/man1/krillta.1
	default_doc
}

check() {
	# event sourcing framework not passing due to missing value "alice" - may be upstream test issue.
	cargo test $_cargo_opts --workspace --verbose -- --skip event_sourcing_framework
}

package() {
	install -Dm755 "$builddir"/target/release/krill -t "$pkgdir"/usr/bin/
	install -Dm755 "$builddir"/target/release/krillc -t "$pkgdir"/usr/bin/

	install -Dm755 "$srcdir"/"$pkgname".initd "$pkgdir"/etc/init.d/"$pkgname"
	install -Dm644 "$srcdir"/"$pkgname".confd "$pkgdir"/etc/conf.d/"$pkgname"

	install -dm755 "$pkgdir"/etc/krill
	install -Dm640 -o krill -g krill "$srcdir"/krill.conf -t "$pkgdir"/etc/krill/

	install -dm755 "$pkgdir"/var/log/krill
	install -Dm700 -o krill -g krill "$srcdir"/"$pkgname".log -t "$pkgdir"/var/log/

	install -Dm644 "$builddir"/doc/krill.1 -t "$pkgdir"/usr/share/man/man1/krill.1
	install -Dm644 "$builddir"/doc/krillc.1 -t "$pkgdir"/usr/share/man/man1/krillc.1
}
