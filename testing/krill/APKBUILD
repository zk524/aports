# Contributor: andar1an <stephen@theandar1an.com>
# Maintainer: andar1an <stephen@theandar1an.com>
pkgname=krill
pkgver=0.15.0
pkgrel=0
pkgdesc="RPKI Certificate Authority and Publication Server written in Rust"
url="https://nlnetlabs.nl/projects/routing/krill/"
# have not determined why builds fail for listed non-arch's yet
arch="all !aarch64 !loongarch64 !armv7 !x86 !riscv64 !s390x "
options="net"
license=" MPL-2.0"
makedepends="
	cargo
	cargo-auditable
	openssl-dev
	rust
"
pkgusers="krill"
pkggroups="krill"
install="
	$pkgname.pre-install
"
subpackages="$pkgname-openrc $pkgname-doc krillup krillta"

source="$pkgname-$pkgver.tar.gz::https://github.com/NLnetLabs/krill/archive/refs/tags/v$pkgver.tar.gz
	krill.conf
	$pkgname.initd
	$pkgname.confd
"

_cargo_opts="--frozen --release"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build -p krill $_cargo_opts
}

krillup() {
	pkgdesc="$pkgdesc upgrade command line utility"

	install -Dm755 "$builddir"/target/release/krillup "$subpkgdir"/usr/bin/
}

krillta() {
	pkgdesc="$pkgdesc trust anchor command line utility"

	install -Dm755 "$builddir"/target/release/krillta "$subpkgdir"/usr/bin/
}

check() {
	cargo test $_cargo_opts --forzen --workspace --verbose
}

package() {
	install -Dm755 target/release/krill -t "$pkgdir"/usr/bin/
	install -Dm755 target/release/krillc -t "$pkgdir"/usr/bin/

	install -m755 -D "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -m644 -D "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname

	install -d -m755 "$pkgdir"/etc/krill
	install -D -m640 -o krill -g krill "$srcdir"/krill.conf -t "$pkgdir"/etc/krill/

	install -d -m700 -o krill -g krill "$pkgdir"/var/log/"$pkgname".log
}
sha512sums="
