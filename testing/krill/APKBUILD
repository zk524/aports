# Contributor: Stephen <stephen@theandar1an.com>
# Maintainer: Stephen <stephen@theandar1an.com>
pkgname=krill
pkgver=0.14.6
pkgrel=0
pkgdesc="RPKI Certificate Authority and Publication Server written in Rust"
url="https://nlnetlabs.nl/projects/routing/krill/"
arch="all"
options="net"
license=" MPL-2.0"
depends="
	bash
	libgcc
	openssl
	tini
	tzdata
	util-linux
	"
makedepends="
    cargo
	cargo-auditable
	openssl-dev
	rust
	"
checkdepends=""
pkgusers="krill"
pkggroups="krill"
install="$pkgname.pre-install $pkgname.post-install"
subpackages="$pkgname-openrc"

source="$pkgname-$pkgver.tar.gz::https://github.com/NLnetLabs/krill/archive/refs/tags/v$pkgver.tar.gz
	krill.conf
	$pkgname.initd
	$pkgname.confd
	"

# Disable bundled-libs, sqlite, k2v
_cargo_opts="--frozen --release"


prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build $_cargo_opts
}

check() {
	cargo test $_cargo_opts --workspace
}

package() {
	# Replace with proper package command(s)
	:

	install -m755 -D "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/init.d/$pkgname
	install -m644 -D "$srcdir"/$pkgname.confd \
		"$pkgdir"/etc/conf.d/$pkgname
}
