# Contributor: Minoru Maekawa <dlrmp47285@yahoo.co.jp>
# Maintainer: Minoru Maekawa <dlrmp47285@yahoo.co.jp>
pkgname=kvrocks
pkgver=2.12.1
pkgrel=0
pkgdesc="NoSQL which is based on RocksDB and compatible with the Redis protocol"
url="https://github.com/apache/kvrocks"
arch="x86_64 aarch64" # arch: only x86_64 and aarch64 build verified; others unsupported.
license="Apache-2.0"
pkgusers="kvrocks"
pkggroups="kvrocks"
makedepends="
	autoconf
	automake
	cmake
	libtool
	linux-headers
	openssl-dev
	python3
	samurai
	"
install="$pkgname.pre-install $pkgname.post-install"
subpackages="$pkgname-doc $pkgname-openrc kvrocks2redis"
source="$pkgname-$pkgver.tar.gz::https://github.com/apache/kvrocks/archive/refs/tags/v$pkgver.tar.gz
	kvrocks.conf.patch
	kvrocks.initd
	kvrocks.confd
	"

build() {
	./x.py build --unittest --ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DDISABLE_JEMALLOC=ON \
		-DENABLE_OPENSSL=ON
}

check() {
	./x.py test cpp
	# x.py test go is no valkey-cil support
}

package() {
	install -Dm755 -s build/kvrocks \
		"$pkgdir"/usr/bin/kvrocks
	install -Dm755 -s build/kvrocks2redis \
		"$pkgdir"/usr/bin/kvrocks2redis

	install -Dm644 kvrocks.conf "$pkgdir"/etc/kvrocks.conf

	install -Dm644 -t "$pkgdir"/usr/share/licenses/$pkgname \
		LICENSE \
		NOTICE

	install -Dm755 "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/init.d/$pkgname
	install -Dm644 "$srcdir"/$pkgname.confd \
		"$pkgdir"/etc/conf.d/$pkgname
}

kvrocks2redis() {
	pkgdesc="Migrates data from Kvrocks to Redis"

	amove usr/bin/kvrocks2redis
}

