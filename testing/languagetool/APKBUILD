# Maintainer: Willow Barraco <contact@willowbarraco.fr>
pkgname=languagetool
pkgver=6.5
pkgrel=0
pkgdesc="open source language checker"
url="https://www.languagetool.org"
arch="x86_64" # no maven, unsupported 32-bit, or arm64
license="LGPL-2.1-only"
depends="java-jre-headless"
makedepends="maven openjdk8-jdk gcompat hunspell"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/languagetool-org/languagetool/archive/refs/tags/v$pkgver.tar.gz
	languagetool.sh
	"
options="net"

# NOTE: Maven 3 dropped support for the M2_HOME variable.
export MAVEN_ARGS="--batch-mode -Duser.home=$srcdir/.home -Dcheckstyle.skip=true -Dlicensing.skip=true"

build() {
	mvn install -DskipTests
}

package() {
	install -d "$pkgdir/usr/bin"
	install -d "$pkgdir/usr/share/java/$pkgname"
	cd "$pkgdir"/usr/share/
	mv "$builddir/languagetool-standalone/target/LanguageTool-$pkgver/LanguageTool-$pkgver" "$pkgname"
	cd "$pkgname"
	mv ./*.jar "$pkgdir"/usr/share/java/$pkgname
	mv libs/*.jar "$pkgdir"/usr/share/java/$pkgname
	rm -rf libs
	install -m755 "$srcdir"/$pkgname.sh "$pkgdir"/usr/bin/$pkgname
}

check() {
	mvn test
}

sha512sums="
5d6edf7c776f850efd623dc69da43dc897433b6838c20b9df47a8d14a4e4bb5a794b713bf3bd44472cc771118e35933f02c6c0109ef2598b5b6a3fd548c4d677  languagetool-6.5.tar.gz
ef1688a3547760ad8677fff4ba4aba8ca51b55d8540c2fe14182ac0450d540c53c77c149b33ede38051caf57929afe3b81ff7e62566a3624e75a4df8d6c5a829  languagetool.sh
"
