pkgname=libmatchbox
pkgver=1.12
pkgrel=0
pkgdesc="The matchbox window manager library"
url="https://git.yoctoproject.org/libmatchbox/about/"
arch="all"
license="GPL-2.0-only"
source="$pkgname-$pkgver.tar.gz::https://git.yoctoproject.org/cgit/cgit.cgi/libmatchbox/snapshot/libmatchbox-$pkgver.tar.gz
	external-xsettings.patch
	libmb.pc.in.patch"
makedepends="
	autoconf
	automake
	doxygen
	libjpeg-turbo-dev
	libtool
	libx11-dev
	libxext-dev
	libxft-dev
	libxsettings-client-dev
	libxsettings-dev
	pango-dev
"
subpackages="$pkgname-dev $pkgname-dbg"

build() {
	autoreconf --install
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--enable-pango \
		--enable-doxygen-docs \
		--enable-jpeg \
		--enable-unit-tests \
		LIBS="-lXsettings-client -lX11"
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

