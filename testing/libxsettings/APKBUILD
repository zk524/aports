pkgname=libxsettings
pkgver=0.11
pkgrel=0
pkgdesc="Xsettings protocol library"
url="https://standards.freedesktop.org/xsettings-spec/0.5/"
arch="all"
license="GPL-2.0-or-later"
depends="libx11"
makedepends="libx11-dev"
source="$pkgname-$pkgver.tar.gz::https://deb.debian.org/debian/pool/main/libx/libxsettings/libxsettings_$pkgver.orig.tar.gz"
subpackages="$pkgname-dev"
options="!check"

build() {
	make
}

package() {
	make PREFIX="/usr" DESTDIR="$pkgdir" install install-devel
}

