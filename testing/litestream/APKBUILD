# Contributor: Andrej Kolčin <self@kaathewise.net>
# Maintainer: Andrej Kolčhin <self@kaathewise.net>
pkgname=litestream
pkgver=0.3.13
pkgrel=0
pkgdesc="Streaming replication for SQLite"
url="https://litestream.io"
arch="all"
license="Apache-2.0"
makedepends="go"
source="$pkgname-$pkgver.tar.gz::https://github.com/benbjohnson/litestream/archive/v$pkgver.tar.gz"
options="net"

build() {
	CGO_ENABLED=1 CGO_CFLAGS="-D_LARGEFILE64_SOURCE" go build \
		-v -o bin/litestream \
		-tags osusergo,netgo,sqlite_omit_load_extension \
		-ldflags "-extldflags '$LDFLAGS' -X 'main.Version=v$pkgver'" \
		./cmd/litestream
}

check() {
	CGO_ENABLED=1 CGO_CFLAGS="-D_LARGEFILE64_SOURCE" go test ./...
}

package() {
	install -Dm755 bin/litestream -t "$pkgdir"/usr/bin/
	install -Dm644 etc/litestream.yml -t "$pkgdir"/etc/
}

sha512sums="
5b85a2cf7ccb3975ceea6f06925aac275435510c588405372f386267ea0ee2297f909554dee1d5e7ac62be745d0a973fbcb1f01491a5b58f07f14d70e5ee0ded  litestream-0.3.13.tar.gz
"
