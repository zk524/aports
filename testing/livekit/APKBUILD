# Contributor: Tom MTT. <tom@baboum.org>
# Maintainer: Tom MTT. <tom@baboum.org>
pkgname=livekit
pkgver=1.9.0
pkgrel=0
pkgdesc="Scalable, multi-user conferencing based on WebRTC"
url="https://github.com/livekit/livekit/"
arch="all"
license="Apache-2.0"
makedepends="
	go
	mage
	"
checkdepends="
	docker
	valkey
	"
install="$pkgname.pre-install"
subpackages="$pkgname-openrc"
pkgusers="$pkgname"
pkggroups="$pkgname"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/livekit/livekit/archive/refs/tags/v$pkgver.tar.gz
	$pkgname.initd
	$pkgname.confd
	$pkgname.yaml
	"
# `net' is required to download go modules.
# `!check' because test suite requires docker and redis.
options="net !check"

build() {
	mage build
}

check() {
	# NOTE: test suite requires Docker and Redis / Valkey to be started,
	# as well as being able to communicate with docker using the current user.
	mage testAll
}

package() {
	install -Dm755 bin/livekit-server "$pkgdir"/usr/bin/livekit-server

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -Dm644 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname

	install -Dm640 -o $pkgusers -g $pkggroups config-sample.yaml \
		"$pkgdir"/etc/$pkgname/$pkgname.example.yaml

	install -Dm640 -o $pkgusers -g $pkggroups "$srcdir"/$pkgname.yaml \
		"$pkgdir"/etc/$pkgname/$pkgname.yaml
}

sha512sums="
