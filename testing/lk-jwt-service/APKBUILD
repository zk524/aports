# Contributor: Tom MTT. <tom@baboum.org>
# Maintainer: Tom MTT. <tom@baboum.org>
pkgname=lk-jwt-service
pkgver=0.3.0
pkgrel=0
pkgdesc="Minimal service to issue LiveKit JWTs for MatrixRTC"
url="https://github.com/element-hq/lk-jwt-service"
arch="all"
license="AGPL-3.0-or-later"
makedepends="go"
install="$pkgname.pre-install $pkgname.post-install"
subpackages="$pkgname-openrc"
pkgusers="$pkgname"
pkggroups="$pkgname"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/element-hq/lk-jwt-service/archive/refs/tags/v$pkgver.tar.gz
	$pkgname.initd
	$pkgname.confd
	"
options="net" # `net' is required to download go modules.

build() {
	go build -o lk-jwt-service .
}

check() {
	go test
}

package() {
	install -Dm755 lk-jwt-service "$pkgdir"/usr/bin/lk-jwt-service

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -Dm640 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname
}

sha512sums="
