pkgname=matchbox-desktop
pkgver=2.0
pkgrel=0
pkgdesc="Desktop system for handhelds using the GTK+2 stack"
url="https://matchbox-project.org"
arch="all"
license="GPL-2.0-only"
depends="
	libjpeg-turbo
	libmatchbox
	matchbox-common
"
makedepends="
	autoconf
	automake
	gdk-pixbuf
	glib
	gtk+2.0
	gtk+2.0-dev
	libjpeg-turbo
	libjpeg-turbo-dev
	libmatchbox
	libmatchbox-dev
	libtool
	libx11
	matchbox-common
	pango
	startup-notification-dev
"
source="https://deb.debian.org/debian/pool/main/m/matchbox-desktop/matchbox-desktop_$pkgver.orig.tar.gz"
options="!check"

build() {
	./configure \
		--enable-startup-notification \
		--enable-dnotify \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		LIBS="-lX11"
	make
}

package() {
	make DESTDIR=$pkgdir install
}

sha512sums="c1e4b4312a21691b9fe6f956e788d6064835bf062d69944b0124f7c274464b13320d8b8641315fe0c355eb5e35f8f42c9b817232f4aedf443a7bf34cb047f725  matchbox-desktop_2.0.orig.tar.gz"
