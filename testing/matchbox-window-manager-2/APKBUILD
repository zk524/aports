pkgname=matchbox-window-manager-2
pkgver=2.0_git20171119
pkgrel=0
_commit="5f44595c66be118b1a74f489de7f8492035cbdf0"
pkgdesc="Window manager intended for non-desktop embedded platforms such as handhelds and set-top boxes"
url="http://matchbox-project.org"
arch="all"
license="GPL-2.0-only"
source="
	https://git.yoctoproject.org/cgit/cgit.cgi/matchbox-window-manager-2/snapshot/matchbox-window-manager-2-$_commit.tar.gz
	libpng.pc.patch
	0001-Correctly-include-GTK.patch
"
depends="
	libmatchbox
	libpng
	pango
"
makedepends="
	autoconf
	automake
	expat-dev
	expat-dev
	gtk+2.0-dev
	libmatchbox-dev
	libpng-dev
	libtool
	pango-dev
"
builddir="$srcdir/$pkgname-$_commit"
options="!check"

build() {
	export LDFLAGS="$LDFLAGS -lexpat"
	export CFLAGS="$CFLAGS -Wno-attributes"

	autoreconf --install
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/ \
		--with-gtk \
		--with-pango
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

