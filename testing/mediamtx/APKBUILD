maintainer="Krystian Chachuła <krystian@krystianch.com>"
pkgname=mediamtx
pkgver=1.11.2
_hlsjsver=1.5.20
pkgrel=0
pkgdesc="Real-time media server and proxy"
url="https://github.com/bluenviron/mediamtx"
arch="all"
license="MIT"
makedepends="go"
install="$pkgname.pre-install"
subpackages="$pkgname-openrc $pkgname-doc"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/bluenviron/mediamtx/archive/refs/tags/v$pkgver.tar.gz
	hlsjs-$_hlsjsver.zip::https://github.com/video-dev/hls.js/releases/download/v$_hlsjsver/release.zip
	LICENSE-hlsjs::https://raw.githubusercontent.com/video-dev/hls.js/refs/tags/v$_hlsjsver/LICENSE
	mediamtx.initd
	mediamtx.confd
	0001-rpicamera-disable.patch
	"
options="net !check"  # some tests depend on binding to ports

prepare() {
	default_prepare
	go mod download
	echo -n v$pkgver > internal/core/VERSION
	cp "$srcdir"/dist/hls.min.js internal/servers/hls/
}

build() {
	export CGO_CFLAGS="$CFLAGS"
	export CGO_LDFLAGS="$LDFLAGS"

	go build .
}

check() {
	go test ./internal/...
}

package() {
	install -m 755 -D "$builddir"/mediamtx \
		"$pkgdir"/usr/bin/mediamtx

	install -m 644 -D "$builddir"/mediamtx.yml \
		"$pkgdir"/etc/mediamtx/mediamtx.yml

	install -Dm 644 -t "$pkgdir"/usr/share/doc/mediamtx/ \
		LICENSE
	install -Dm 644 -t "$pkgdir"/usr/share/doc/mediamtx/ \
		"$srcdir"/LICENSE-hlsjs

	install -m755 -D "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/init.d/$pkgname
	install -m644 -D "$srcdir"/$pkgname.confd \
		"$pkgdir"/etc/conf.d/$pkgname
}

