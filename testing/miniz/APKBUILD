pkgname=miniz
pkgver=3.0.2
pkgrel=0
pkgdesc="Compression library implementing zlib (RFC 1950) & deflate (RFC 1951) specifications"
url="https://github.com/richgel999/miniz"
arch="all"
license="MIT"
makedepends="cmake samurai"
subpackages="$pkgname-dev"
source="miniz-$pkgver.tar.gz::https://github.com/richgel999/miniz/archive/refs/tags/$pkgver.tar.gz
	cmake-version.patch"
# tests don't compile
options="!check"

build() {
	cmake -B "$srcdir/build" -DCMAKE_INSTALL_PREFIX=/usr
	cmake --build "$srcdir/build"
}

check() {
	sh ./test.sh
}

package() {
	DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}

