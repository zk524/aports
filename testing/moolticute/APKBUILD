# Maintainer: Eirik Furuseth <alpine@heplaphon.com>
pkgname=moolticute
pkgver=1.04.0
pkgrel=0
pkgdesc="Companion app for the Mooltipass device"
url="https://github.com/mooltipass/moolticute"
arch="x86_64"
license="GPL-3.0-or-later"
makedepends="qt5-qttools-dev qt5-qtwebsockets-dev eudev-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/mooltipass/moolticute/archive/v$pkgver.tar.gz
	https://github.com/mooltipass/qzxing/archive/7e9ce8b2819c64d0641618588acd844d29cdf76f.zip"

prepare() {
	default_prepare

	sed -i "/#define APP_VERSION/s/git/v$pkgver/" src/version.h
	mkdir -p build
	rmdir "src/QZXing"
	ln -s ../../qzxing-7e9ce8b2819c64d0641618588acd844d29cdf76f src/QZXing
}

build() {
	qmake-qt5 Moolticute.pro \
		PREFIX=/usr \
		QMAKE_CFLAGS_RELEASE="$CFLAGS" \
		QMAKE_CXXFLAGS_RELEASE="$CXXFLAGS" \
		-o build/
	make -C build
}

check() {
	make -C build check
}

package() {
	INSTALL_ROOT="$pkgdir" make -C build install
}

