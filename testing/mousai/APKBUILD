# Contributor: Patrick Widmer <patrick.widmer@tbwnet.ch>
# Maintainer: Patrick Widmer <patrick.widmer@tbwnet.ch>
pkgname=mousai
pkgver=0.7.8
pkgrel=0
pkgdesc="Identify songs in seconds"
url="https://github.com/SeaDve/Mousai"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	cargo
	desktop-file-utils
	gst-plugins-bad-dev
	gst-plugins-base-dev
	gstreamer-dev
	gtk4.0-dev
	libadwaita-dev
	libsoup3-dev
	meson
	ninja
	"
source="https://github.com/SeaDve/Mousai/releases/download/v$pkgver/mousai-$pkgver.tar.xz"
# net: required to download dependencies
# !check: no tests
options="net !check"

build() {
	abuild-meson . _build
	ninja -C _build
}

package() {
	DESTDIR="$pkgdir" ninja -C _build install
}

sha512sums="
