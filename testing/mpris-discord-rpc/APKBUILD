# Contributor:
# Maintainer:
pkgname=mpris-discord-rpc
pkgver=0.5.1
pkgrel=0
pkgdesc="Linux Discord rich presence for music, using MPRIS with album cover and progress bar support"
url="https://github.com/patryk-ku/mpris-discord-rpc"
arch="all"
license="MIT"
makedepends="cargo cargo-auditable openssl-dev dbus-dev"
subpackages="$pkgname-openrc"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/patryk-ku/mpris-discord-rpc/archive/refs/tags/v$pkgver.tar.gz
	mpris-discord-rpc.initd
	"
options="net"

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --frozen --release
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 target/release/mpris-discord-rpc "$pkgdir"/usr/bin/mpris-discord-rpc

	install -m755 -D "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/user/init.d/$pkgname
}

