# Contributor: Angelo Verlain <hey@vixalien.com>
maintainer="Angelo Verlain <hey@vixalien.com>"
pkgname=mpris-scrobbler
pkgver=0.5.7
pkgrel=0
pkgdesc="submit the songs you're playing to listenbrainz.org, libre.fm and last.fm"
url="https://github.com/mariusor/mpris-scrobbler"
arch="all"
license="MIT"
makedepends="meson dbus-dev libevent-dev curl-dev json-c-dev"
subpackages="$pkgname-openrc"
source="
  $pkgname-$pkgver.tar.gz::https://github.com/mariusor/mpris-scrobbler/archive/refs/tags/v$pkgver.tar.gz
	mpris-scrobbler.initd
	"

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -m755 -D "$srcdir"/$pkgname.initd "$pkgdir"/etc/user/init.d/$pkgname
}

