pkgname=ne
pkgver=3.3.3
pkgrel=0
pkgdesc="Ne, the Nice Editor"
url="https://ne.di.unimi.it"
arch="all"
license="GPL-3.0-only"
depends=""
makedepends="ncurses-dev texinfo"
checkdepends=""
install=""
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/vigna/ne/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/"/$pkgname-$pkgver

build() {
  make PREFIX=/usr docs
  make PREFIX=/usr build -j1
}
check() {
  "$builddir/"src/ne --help
}
package() {
  make PREFIX=/usr DESTDIR="$pkgdir" install
}
