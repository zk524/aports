# Maintainer: Jianhua Lu <lujianhua000@gmail.com>
pkgname=netease-cloud-music-gtk
pkgver=2.5.0
pkgrel=0
pkgdesc="Rust + GTK based Netease Cloud Music Player for Linux."
url="https://github.com/gmg137/netease-cloud-music-gtk"
arch="all"
license="GPL-3.0-or-later"
depends="
	gst-plugins-good
	gst-plugins-ugly
"
makedepends="
	cargo
	desktop-file-utils
	gstreamer-dev
	gst-plugins-base-dev
	gst-plugins-bad-dev
	gtk4.0-dev
	libadwaita-dev
	meson
	openssl-dev
"
checkdepends="xvfb-run"
subpackages="$pkgname-lang"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/gmg137/netease-cloud-music-gtk/archive/refs/tags/$pkgver.tar.gz
	ncm.patch
"

build() {
	abuild-meson \
		-Db_lto=true \
		. output
	meson compile -C output
}

check() {
	xvfb-run -a meson test --no-rebuild --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
