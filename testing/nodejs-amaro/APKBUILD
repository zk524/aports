f25d5e331755a6f421da98490285ccec5b0c4d65713fbf30ad22e9d809dfc3013a1ba65a05d2dafaa0c9961efe897ab4f22f7ef67021e7788dc151599580f8c6  wasm_bg-path.patch.txt
"
