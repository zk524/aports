# Contributor: Maxim Karasev <mxkrsv@disroot.org>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=nvim-gruvbox
pkgver=2.0.0
_commit="$pkgver"
pkgrel=0
pkgdesc="lua port of gruvbox vim colorscheme"
url="https://github.com/ellisonleao/gruvbox.nvim"
arch="noarch"
license="MIT"
subpackages="$pkgname-doc $pkgname-autoenable"
source="https://github.com/ellisonleao/gruvbox.nvim/archive/$_commit/nvim-gruvbox-$pkgver.tar.gz"
builddir="$srcdir/gruvbox.nvim-$_commit"
options="!check" # no tests

package() {
	find lua colors doc \
		-type f -exec install -Dvm644 '{}' "$pkgdir/usr/share/nvim/site/{}" \;
	install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
}

autoenable() {
	install_if="nvim-autoenable $pkgname=$pkgver-r$pkgrel"
	install -d "$subpkgdir"/usr/share/nvim/site/after/plugin
	cat > "$subpkgdir"/usr/share/nvim/site/after/plugin/gruvbox.lua <<-EOF
	vim.cmd.colorscheme 'gruvbox'
	EOF
}

sha512sums="
cbd278a5a7e2bad80870105b027e7a3905bd9ef9afee5951606119d05d8d1e9df263a4d98cd5d9855ac8df96d24bcff7fe2c14fcf0ab61db0cb71072c163c676  nvim-gruvbox-2.0.0.tar.gz
"
