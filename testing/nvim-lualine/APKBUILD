# Contributor: Maxim Karasev <mxkrsv@disroot.org>
# Maintainer: John Vogel <jvogel@stygian.me>
maintainer="John Vogel <jvogel@stygian.me>"
pkgname=nvim-lualine
pkgver=0.0.0_git20250608
_commit=a94fc68960665e54408fe37dcf573193c4ce82c9
pkgrel=0
pkgdesc="a fast and easy to configure neovim statusline plugin"
url="https://github.com/nvim-lualine/lualine.nvim"
arch="all !loongarch64 !ppc64le !riscv64 !s390x"
license="MIT"
depends="neovim nvim-web-devicons"
checkdepends="bash nvim-plenary tree-sitter-lua"
options="!check" # tests broken
subpackages="$pkgname-doc $pkgname-autoenable"
source="https://github.com/nvim-lualine/lualine.nvim/archive/$_commit/nvim-lualine-$pkgver.tar.gz
	minimal_init.patch
	not_git_repo.patch
	"
builddir="$srcdir/lualine.nvim-$_commit"

package() {
	find doc lua -type f \
		-exec install -Dvm644 '{}' "$pkgdir/usr/share/nvim/site/pack/dist/opt/$pkgname/{}" \;
	install -Dm644 ./examples/*.lua -t "$pkgdir"/usr/share/doc/"$pkgname"/examples
	install -Dm644 ./*.md -t "$pkgdir"/usr/share/doc/"$pkgname"
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/"$pkgname"

	install -d "$pkgdir"/usr/share/nvim/site/after/plugin
	cat > "$pkgdir"/usr/share/nvim/site/after/plugin/$pkgname.lua <<-EOF
	vim.cmd 'packadd $pkgname'
	require('lualine').setup()
	EOF
}

check() {
	make test
}

autoenable() {
	install_if="$pkgname=$pkgver-r$pkgrel nvim-autoenable"
	amove usr/share/nvim/site/after
}

doc() {
	default_doc
	amove usr/share/nvim/site/pack/dist/opt/"$pkgname"/doc
}

