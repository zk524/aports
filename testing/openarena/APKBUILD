# Contributor: Real Root <user3mila@disroot.org>

pkgname='openarena'
pkgver=0.8.8
pkgrel=0
_commit=74046d7a5c4d55b93a2cc41c37b36f9e945374e6
pkgdesc="A fast-paced 3D first-person shooter, similar to id Software Inc.'s Quake III Arena"
url="http://openarena.ws/"
license="GPL"
arch="x86 x86_64 aarch64 armv7"
makedepends="git
	make
	grep
	sdl2-dev
	libxmp-dev
	libvorbis-dev
	sdl12-compat
	sdl12-compat-dev
	libc6-compat
	speex-dev
	speexdsp-dev
	curl-dev
	openal-soft-dev
"
depends="sdl2 libvorbis curl libxmp openal-soft"
_relver='088'
source="$pkgname-$_commit.tar.gz::https://github.com/OpenArena/engine/archive/$_commit.tar.gz
	https://web.archive.org/web/20240716135128if_/http://download.tuxfamily.org/openarena/rel/088/openarena-0.8.8.zip
	openarena128.png
	openarena.desktop
	openarena.sh
	oa_ded.sh
"

build() {
	cd "$srcdir/engine-$_commit"

	if [ $(uname -m) == 'aarch64' ]; then
		if grep -qF "aarch64" code/qcommon/q_platform.h; then
			echo "Code has aarch64!"
		else
			echo "Give code aarch64!"
			sed -i 's/arm/aarch64/g' code/qcommon/q_platform.h
		fi
	fi

	make \
		USE_INTERNAL_SPEEX=0 \
		USE_INTERNAL_JPEG=0 \
		USE_INTERNAL_OGG=0 \
		USE_INTERNAL_OPUS=0 \
		USE_INTERNAL_ZLIB=0 \
		USE_OPENAL_DLOPEN=0 \
		USE_CURL_DLOPEN=0 
}

package() {
	install -dm755 "$pkgdir/usr/bin" "$pkgdir/usr/share/icons/hicolor/128x128/apps/" "$pkgdir/usr/share/applications/" "$pkgdir/usr/share/openarena"
	  
	# copy assets
	mv "$srcdir/openarena-$pkgver/baseoa" "$pkgdir/usr/share/openarena/baseoa"

	# copy compiled files
	install -Dm 755 "$srcdir"/engine-"$_commit"/build/release-linux-$(uname -m)/openarena.$(uname -m) "$pkgdir/usr/share/openarena/openarena"
	install -Dm 755 "$srcdir"/engine-"$_commit"/build/release-linux-$(uname -m)/oa_ded.$(uname -m) "$pkgdir/usr/share/openarena/oa_ded"

	# install wrappers
	install -Dm 755 "$srcdir"/openarena.sh "$pkgdir/usr/bin/openarena"
	install -Dm 755 "$srcdir"/oa_ded.sh "$pkgdir/usr/bin/oa_ded"
	
	# create application-shortcuts
	install -Dm 644 "$srcdir"/openarena128.png "$pkgdir"/usr/share/icons/hicolor/128x128/apps/
	install -Dm 644 "$srcdir"/openarena.desktop "$pkgdir"/usr/share/applications/
}

