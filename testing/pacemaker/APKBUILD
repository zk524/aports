# Contributor: Jae Arr <alpine.unbent366@passinbox.com>
# Maintainer: Jae Arr <alpine.unbent366@passinbox.com>
pkgname=pacemaker
pkgver=3.0.0
pkgrel=0
pkgdesc="Pacemaker cluster resource manager"
url="https://clusterlabs.org/projects/pacemaker/"
arch="all"
license="GPL-2.0-or-later"
makedepends="
	autoconf
	automake
	template-glib-dev
	libxslt-dev
	dbus-dev
	gnutls-dev
	intltool
	bash
	libqb-dev
	corosync-dev
	patchutils"
checkdepends="cmocka-dev"
install="$pkgname.pre-install"
subpackages="$pkgname-dev $pkgname-doc $pkgname-openrc $pkgname-pyc"
source="https://github.com/ClusterLabs/pacemaker/archive/refs/tags/Pacemaker-$pkgver.tar.gz
	$pkgname.pre-install
	pacemaker.initd
	pacemaker_remote.initd
	test-headers.patch
	mock.patch
	strftime.patch"
builddir="$srcdir/$pkgname-Pacemaker-$pkgver/"

build() {
	./autogen.sh
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--datarootdir=/usr/share \
		--with-configdir=/etc/conf.d
	make
}

check() {
	make check
}

package() {
	make install DESTDIR="$pkgdir"
	install -Dm755 "$srcdir"/pacemaker.initd "$pkgdir"/etc/init.d/pacemaker
	install -Dm755 "$srcdir"/pacemaker_remote.initd "$pkgdir"/etc/init.d/pacemaker_remote
}

