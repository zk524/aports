pkgname=passage
pkgver=1.7.4_git20221231
_gitrev=42cb195fa4298e6e030da122c4e0104a546e87c7
pkgrel=0
pkgdesc="passage is a fork of password-store that uses age as a backend instead of GnuPG."
url="https://github.com/FiloSottile/passage"
arch="noarch"
license="GPL-2.0-or-later"
depends="bash tree cmd:age"
makedepends="age"
checkdepends="git"
# Source doesn't contain test suite
options="!check"
subpackages="
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
source="https://github.com/FiloSottile/passage/archive/$_gitrev.tar.gz
	"

builddir="$srcdir/passage-$_gitrev"

package() {
	make DESTDIR="$pkgdir" WITH_ALLCOMP=yes install
}

