# Contributor: NeYurii <neyuriizkh@proton.me>
# Maintainer: NeYurii <neyuriizkh@proton.me>
pkgname=patat
pkgver=0.15.2.0
pkgrel=0
pkgdesc="Terminal-based presentations using Pandoc"
url="https://github.com/jaspervdj/patat"
# limited by ghc
arch="aarch64 x86_64"
license="GPL-2.0-only"
makedepends="ghc cabal zlib-dev"
subpackages="$pkgname-doc $pkgname-bash-completion"
source="
	https://hackage.haskell.org/package/patat-$pkgver/patat-$pkgver.tar.gz
	cabal.project.freeze
"
options="net" # fetch cabal dependencies

export CABAL_DIR="${CABAL_DIR:-"$srcdir/.cabal"}"

cabal_update() {

	local repo="hackage.haskell.org"

	# Default config uses HTTP, change it to HTTPS.
	[ -f "$CABAL_DIR"/config ] || {
		cabal user-config init
		cabal user-config update -a \
			"repository $repo {url: https://$repo/}"
	}

	cd "$startdir"
	[ -d "$builddir" ] || abuild unpack
	msg "Freezing $pkgname dependencies"

	# Resolve deps and generate fresh cabal.project.freeze with version constraints.
	(
		cd "$builddir" || {
			error 'Is $builddir set correctly?'
			return 1
		}
		cabal v2-update
		# Include in cabal.project.freeze patat-make-man and tests
		cabal v2-freeze --shadow-installed-packages --flags=+patat-make-man --enable-tests

		mv -v cabal.project.freeze "$startdir"
	)

	if ! abuild checksum; then
		die "Failed to update checksum, run 'abuild checksum' manually"
	fi
}

prepare() {
	default_prepare

	ln -svf "$srcdir"/cabal.project.freeze "$builddir"
}

build() {
	cabal v2-update
	cabal v2-build \
		--jobs=${JOBS:-1} \
		--prefix=/usr \
		--docdir=/usr/share/doc/$pkgname \
		--sysconfdir=/etc
	# Generate man page and bash completion
	SOURCE_DATE_EPOCH=$(date +%s) cabal exec -- patat-make-man > extra/"$pkgname".1
	cabal exec -- patat --bash-completion-script patat > extra/"$pkgname".bash-completion
}

check() {
	cabal test
}

package() {
	cabal list-bin patat | xargs install -Dm755 -t "$pkgdir"/usr/bin
	install -Dm644 -t "$pkgdir"/usr/share/man/man1 extra/"$pkgname".1
	install -Dm644 -t "$pkgdir"/usr/share/bash-completion/completions extra/"$pkgname".bash-completion
}
