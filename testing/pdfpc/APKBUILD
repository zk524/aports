# Contributor: X&r <46404-xrbnvd@gitlab.alpinelinux.org>
maintainer="X&r <46404-xrbnvd@gitlab.alpinelinux.org>"
pkgname=pdfpc
pkgver=4.7.0
pkgrel=0
pkgdesc="A presenter console with multi-monitor support for PDF files"
url="https://pdfpc.github.io/"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	cmake
	ninja-is-really-ninja
	vala
	libgee-dev
	poppler-dev
	discount-dev
	json-glib-dev
	libsoup3-dev
	webkit2gtk-4.1-dev
	libqrencode-dev
	gstreamer-dev
	gst-plugins-base-dev
	gst-plugins-good-gtk
	"
source="
	pdfpc.desktop
	$pkgname-$pkgver.tar.gz::https://github.com/pdfpc/pdfpc/archive/v$pkgver.tar.gz
	"
options="!check" # no tests

build() {
	if [ "$CBUILD" != "$CHOST" ]; then
		local crossopts="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_HOST_SYSTEM_NAME=Linux"
	fi
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None \
		$crossopts
	cmake --build build
}

package() {
	install -Dm755 "$builddir"/build/bin/pdfpc -t "$pkgdir"/usr/bin/
	install -Dm644 "$builddir"/rc/pdfpcrc -t "$pkgdir"/etc/
	install -Dm644 "$builddir"/icons/*.svg -t "$pkgdir"/usr/share/pdfpc/icons/
	install -Dm644 "$builddir"/css/*.css -t "$pkgdir"/usr/share/pdfpc/css/
	install -Dm644 "$srcdir"/pdfpc.desktop -t "$pkgdir"/usr/share/applications/
}

