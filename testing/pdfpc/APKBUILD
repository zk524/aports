# Contributor: Liam Hurwitz <lgh@e.email>
pkgname=pdfpc
pkgver=4.6.0_git20240901
pkgrel=0
pkgdesc="Presenter console with multi-monitor support for PDF files"
arch="all"
url="https://pdfpc.github.io/"
license="GPL-3.0-or-later"
depends="libsoup"
makedepends="
	discount-dev
	gst-plugins-base-dev
	gstreamer-dev
	gtk+3.0-dev
	json-glib-dev
	libgee-dev
	libqrencode-dev
	poppler-dev
	vala
	webkit2gtk-dev
	cmake
	"
subpackages="$pkgname-doc"
_commit=d7785577a02bd8ad6688e958672f69e43d64e642
source="$pkgname-$pkgver.tar.gz::https://github.com/pdfpc/pdfpc/archive/$_commit.tar.gz
				Allow-compiling-with-markdown3.patch"
builddir="$srcdir/$pkgname-$_commit"
options="!check"

build() {

	cmake -B build \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
