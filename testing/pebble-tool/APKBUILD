# Contributor: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=pebble-tool
pkgver=5.0.6
pkgrel=0
pkgdesc="command-line tool for the Pebble SDK"
url="https://github.com/coredevices/pebble-tool"
# riscv64 - missing gcc-arm-none-eabi
arch="noarch !riscv64"
license="MIT"
depends="
	py3-libpebble2
	py3-httplib2
	py3-oauth2client
	py3-progressbar2
	py3-asn1
	py3-asn1-modules
	py3-pypng
	py3-pyqrcode
	py3-requests
	py3-rsa
	py3-pyserial
	py3-six
	py3-sourcemap
	py3-websocket-client
	py3-wheel
	py3-colorama
	py3-packaging
	py3-pypkjs
	py3-freetype-py
	gcc-arm-none-eabi
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-build
	py3-installer
	py3-wheel
	"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/coredevices/pebble-tool/archive/v$pkgver.tar.gz"
options="!check" # No checks provided

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl

	# Install the main pebble command
	install -Dm755 pebble.py "$pkgdir"/usr/bin/pebble
}

sha512sums="
8c4b27680811b41f5aa6f4ca207cf6db5d68de520f12e725d89d89ba89316f7056f401191726f566b2e40d957884b1f18e3506b2099ab8ac39a6fa5ac0874eb3  pebble-tool-5.0.6.tar.gz
"
