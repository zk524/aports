# Maintainer: qaqland <qaq@qaq.land>
pkgname=perl-filesys-df
pkgver=0.92
pkgrel=0
pkgdesc="Filesys::Df - Perl extension for filesystem disk space information"
url="https://metacpan.org/pod/Filesys::Df"
arch="all"
license="Artistic-1.0-Perl OR GPL-1.0-or-later"
depends="perl"
makedepends="perl-dev"
subpackages="$pkgname-doc"
source="https://cpan.metacpan.org/authors/id/I/IG/IGUTHRIE/Filesys-Df-$pkgver.tar.gz"
builddir="$srcdir/Filesys-Df-$pkgver"

build() {
	perl Makefile.PL INSTALLDIRS=vendor
	make
}

check() {
	make test
}

package() {
	make DESTDIR="$pkgdir" install
	find "$pkgdir" \( -name perllocal.pod -o -name .packlist \) -delete
}

sha512sums="
