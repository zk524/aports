 }
 
+ir_ref ir_get_op(ir_ctx *ctx, ir_ref ref, int32_t n)
+{
+	ir_insn *insn = &ctx->ir_base[ref];
+
+#ifdef IR_DEBUG
+	if (n > 3) {
+		int32_t count;
+
+		IR_ASSERT(IR_OP_HAS_VAR_INPUTS(ir_op_flags[insn->op]));
+		count = insn->inputs_count;
+		IR_ASSERT(n <= count);
+	}
+#endif
+	return ir_insn_op(insn, n);
+}
