# Contributor: Aemilia Scarlett <aemilia@ferret.town>
# Maintainer: Aemilia Scarlett <aemilia@ferret.town>
pkgname=pika-backup
pkgver=0.6.2
pkgrel=1
pkgdesc="Doing backups the easy way. Plugin your USB drive and let the Pika do the rest for you."
url="https://gitlab.gnome.org/World/pika-backup"
arch="all !s390x"
license="GPL-3.0-or-later"
depends="borgbackup"
makedepends="cargo gtk4.0-dev libadwaita-dev glib-dev gettext itstool meson"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://gitlab.gnome.org/World/pika-backup/-/archive/v$pkgver/pika-backup-v$pkgver.tar.gz
	replace-open64-requirement-in-getrandom.patch.in
	modify-meson-build-for-docs.patch
	"
builddir="$srcdir/$pkgname-v$pkgver"
options="!check"


export CARGO_PROFILE_RELEASE_INCREMENTAL=false
export CARGO_PROFILE_RELEASE_DEBUG=false
export CARGO_HOME="$srcdir/cargo"

prepare() {
	cargo fetch --locked

	# Find the folder containing the version of getrandom we download from index.crates.io
	REGISTRYDIR=$(find "$srcdir/cargo/registry/src" -type d -name "index.crates.io-*")
	REGISTRYDIR=${REGISTRYDIR/"$srcdir"/}
	REGISTRYDIR=${REGISTRYDIR:1}

	# We apply the patch manually, as it exists outside the working directory of the actual application
	mv ../replace-open64-requirement-in-getrandom.patch.in ../replace-open64-requirement-in-getrandom.patch
	patch "../$REGISTRYDIR/getrandom-0.2.8/src/util_libc.rs" -i ../replace-open64-requirement-in-getrandom.patch
	mv ../replace-open64-requirement-in-getrandom.patch ../replace-open64-requirement-in-getrandom.patch.complete

	default_prepare

	mkdir build
	meson setup build --prefix "$pkgdir/usr"
}

build() {
	export CARGO_PROFILE_RELEASE_OPT_LEVEL=3

	cargo build \
	    --release \
	    --frozen
}

# We skip tests for now, as the test suite for pika-backup wants to test things like gtk window creation which we can't achieve on a headless setup.
check() {
	cargo test --frozen --workspace
}

package() {
	# Use Meson to build all the help docs, desktop files, et al and ensure file references point to the right final directory.
	cd build
	meson compile
	grep -lR "$pkgdir/usr" data | xargs sed -i "s|$pkgdir/usr|/usr|g"
	meson install
	cd ..

	mv "$pkgdir/usr/etc" "$pkgdir/etc"

	install -Dm755 target/release/pika-backup -t "$pkgdir/usr/bin/"
	install -Dm755 target/release/pika-backup-monitor -t "$pkgdir/usr/bin/"
}
