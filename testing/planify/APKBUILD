pkgname=planify
pkgver=4.11.6
pkgrel=0
pkgdesc="GTK4 task manager with Todoist & Nextcloud support"
url="https://useplanify.com"
arch="all"
license="GPL-3.0-or-later"
depends="libportal-gtk4"
makedepends="
	meson
	vala
	glib-dev
	libgee-dev
	gtk4.0-dev
	libsoup3-dev
	sqlite-dev
	libadwaita-dev
	webkit2gtk-6.0-dev
	gtksourceview5-dev
	granite7-dev
	json-glib-dev
	evolution-data-server-dev
	libportal-dev
	libsecret-dev
	gxml-dev
	desktop-file-utils"
subpackages="$pkgname-dev $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/alainm23/planify/archive/refs/tags/$pkgver.tar.gz
	01-time_t.patch
	"

build() {
	abuild-meson \
		. output
	meson compile -C output
}

check() {
	meson test --no-rebuild --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

