_projname=pg_normality
_pgver=17
pkgname="postgresql$_pgver-$_projname"
pkgver=1.0
pkgrel=0
pkgdesc="Statistical methods for normality testing in postgres"
url="https://sr.ht/~yieldsfalsehood/pg_normality"
arch="all"
license="LGPL-3.0-only"
makedepends="postgresql$_pgver-dev gsl-dev libcerf-dev"
depends="gsl libcerf"
source="$_projname-$pkgver.tar.gz::https://git.sr.ht/~yieldsfalsehood/pg_normality/archive/$pkgver.tar.gz"
builddir="$srcdir/$_projname-$pkgver"
options="!check"  # tests require running PostgreSQL

build() {
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

