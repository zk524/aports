# Contributor: Guy Godfroy <guy.godfroy@gugod.fr>
# Maintainer: Guy Godfroy <guy.godfroy@gugod.fr>
pkgname=prometheus-mqtt-exporter
_pkgname=mqtt-exporter
pkgver=1.6.1
pkgrel=0
pkgdesc="generic MQTT Prometheus exporter"
url="https://github.com/kpetremann/mqtt-exporter"
arch="noarch"
license="MIT"
depends="py3-paho-mqtt py3-prometheus-client"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
checkdepends="py3-pytest py3-pytest-mock py3-pytest-asyncio"
install="$pkgname.pre-install"
subpackages="$pkgname-pyc $pkgname-openrc"
source="$_pkgname-$pkgver.tar.gz::https://github.com/kpetremann/mqtt-exporter/archive/refs/tags/v$pkgver.tar.gz
	prometheus-mqtt-exporter.initd
	prometheus-mqtt-exporter.confd
	"
builddir="$srcdir/$_pkgname-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest

}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl

	install -m755 -D "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/init.d/$pkgname
	install -m644 -D "$srcdir"/$pkgname.confd \
		"$pkgdir"/etc/conf.d/$pkgname
}

