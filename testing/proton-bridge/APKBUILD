# Contributor: Aemilia Scarlett <aemilia@ferret.town>
# Maintainer: Aemilia Scarlett <aemilia@ferret.town>
pkgname=proton-bridge
pkgver=3.6.1
pkgrel=0
pkgdesc="Proton Mail Bridge application"
url="https://proton.me/mail/bridge"
arch="all !s390x"
license="GPL-3.0-or-later"
pkgusers="$pkgname"
pkggroups="$pkgname"
depends="proton-bridge-cli"
makedepends="go libsecret-dev cmake ninja-build qt6-qtbase-dev qt6-qtdeclarative-dev qt6-qtsvg-dev protobuf-dev grpc-dev bash zip ninja-is-really-ninja perl curl"
subpackages="$pkgname-cli"
options="!check"
_vcpkgver=2023.08.09
source="$pkgname-$pkgver.tar.gz::https://github.com/ProtonMail/proton-bridge/archive/v$pkgver.tar.gz
	vcpkg-$_vcpkgver.tar.gz::https://github.com/microsoft/vcpkg/archive/$_vcpkgver.tar.gz
	fix-vcpkg-for-multi-arch.patch
	fix-makefile.patch
	proton-bridge.initd
	"

export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"
export GOTMPDIR="${GOTMPDIR:-"$srcdir"}"
export GOMODCACHE="${GOMODCACHE:-"$srcdir/go"}"
export CGO_CFLAGS="-D_LARGEFILE64_SOURCE" # Musl 1.2.4 broke compatibility with Open64, this is a workaround.

case "$CARCH" in
arm*|aarch64|s390x|ppc64le|riscv) export VCPKG_FORCE_SYSTEM_BINARIES=1 ;;
esac

prepare() {
	default_prepare
	truncate -s0 "$builddir"/internal/frontend/bridge-gui/bridge-gui/DeployLinux.cmake

	rm -rf "$builddir"/extern/vcpkg/
	mv "$srcdir"/vcpkg-$_vcpkgver/ "$builddir"/extern/vcpkg/
}

build() {
	make build-nogui
	cp "$builddir"/bridge "$builddir"/proton-bridge # I don't know why I have to do this but I do else it breaks.
	make build-gui
}

check() {
	make test
}

package() {
	install -D -m755 "$builddir"/cmd/Desktop-Bridge/deploy/linux/bridge-gui "$pkgdir"/usr/bin/bridge-gui

	install -D -m644 "$builddir"/cmd/Desktop-Bridge/deploy/linux/proton-bridge.desktop "$pkgdir"/usr/share/applications/proton-bridge.desktop
	install -D -m644 "$builddir"/cmd/Desktop-Bridge/deploy/linux/logo.svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/protonmail-bridge.svg
	install -D -m644 "$builddir/LICENSE" "$pkgdir"/usr/share/licenses/$pkgname
}

cli() {
	depends=""

	mkdir $subpkgdir

	install -D -m755 "$builddir"/cmd/Desktop-Bridge/deploy/linux/bridge "$subpkgdir"/usr/bin/bridge

	install -D -m644 "$builddir/LICENSE" "$subpkgdir"/usr/share/licenses/$pkgname
	install -D -m644 "$builddir"/doc/*.md "$subpkgdir"/usr/share/doc/protonmail/bridge

	install -Dm755 "$srcdir"/proton-bridge.initd "$subpkgdir"/etc/init.d/proton-bridge
}
