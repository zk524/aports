# Maintainer: omni <omni+alpine@hack.org>
pkgname=ptouch-driver
pkgver=1.7
pkgrel=0
_pkgname=printer-driver-ptouch
pkgdesc="Brother PT- and QT-series printer driver for Linux (under CUPS)"
url="https://github.com/philpem/printer-driver-ptouch"
arch="all"
license="GPL-2.0-or-later"
depends="ghostscript"
makedepends="autoconf
	automake
	cups-dev
	foomatic-db-engine
	libpng-dev
	perl-xml-libxml
	"
#subpackages="$pkgname-foomatic"
source="$pkgname-$pkgver.tar.gz::https://github.com/philpem/printer-driver-ptouch/archive/refs/tags/v$pkgver.tar.gz
	fix-brother-ql-600.patch
	"
builddir="$srcdir/$_pkgname-$pkgver"
options="!check" # no tests

prepare() {
	default_prepare

	autoreconf -vif
}

build() {
	./configure --prefix=/usr

	make

	#FOOMATIC="$builddir"/generated foomatic-compiledb -t ppd -d "$builddir"/ppd
}

package() {
	make DESTDIR="$pkgdir" install
}

