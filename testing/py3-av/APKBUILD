# Contributor: Zach DeCook <zachdecook@librem.one>
maintainer=
pkgname=py3-av
_pyname=PyAV
pkgver=12.3.0
pkgrel=0
pkgdesc="Pythonic bindings for FFmpeg's libraries"
url="https://pyav.basswood-io.com/"
arch="all !ppc64le !armv7 !armhf !s390x" # armv7, armhf, and ppc64le fail (different) tests, s390x times out
license="BSD-3-Clause"
source="https://github.com/PyAV-Org/PyAV/archive/v$pkgver/PyAV-v$pkgver.tar.gz"
depends="py3-numpy"
makedepends="py3-gpep517 py3-setuptools py3-wheel python3-dev cython ffmpeg-dev"
checkdepends="py3-pytest"
subpackages="$pkgname-doc $pkgname-pyc"
builddir="$srcdir/$_pyname-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --system-site-packages testenv
	testenv/bin/python3 -m installer dist/*.whl
	testenv/bin/python3 setup.py test
	testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		dist/*.whl
	install -Dm644 LICENSE.txt "$pkgdir"/usr/share/licenses/$pkgname/LICENSE.txt
}
sha512sums="
8b14b716060002422aaf48eccc7791344744bb904b922c4f709df8beff411e60306376d3f8f64715f79da50e5dc294f8e5db4cdc7faf996a78d59f1c63d220e2  PyAV-v12.3.0.tar.gz
"
