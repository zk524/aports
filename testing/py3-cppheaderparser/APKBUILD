maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-cppheaderparser
_pkgname=CppHeaderParser
pkgver=2.7.4
pkgrel=0
pkgdesc="Parse C++ header files and generate a data structure representing the class"
url="http://senexcanis.com/open-source/cppheaderparser"
arch="noarch"
license="BSD-3-Clause"
depends="py3-ply"
makedepends="py3-gpep517 py3-setuptools py3-installer"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz"
options="!check" # no tests
builddir="$srcdir/$_pkgname-$pkgver"

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}


package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

