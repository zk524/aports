maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=py3-crontab
_pyname=python-crontab
pkgver=3.2.0
pkgrel=0
pkgdesc="Python module for reading and writing crontab files"
url="https://gitlab.com/doctormo/python-crontab"
arch="noarch"
license="GPL-3.0-or-later"
depends="
	py3-dateutil
	"
makedepends="
	py3-build
	py3-installer
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-coverage
	py3-pytest
	"
subpackages="$pkgname-pyc"
source="https://gitlab.com/doctormo/python-crontab/-/archive/v$pkgver/python-crontab-v$pkgver.tar.gz"
builddir="$srcdir/python-crontab-v$pkgver"

build() {
	python -m build --no-isolation
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer dist/python_crontab-$pkgver-py3-none-any.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" dist/python_crontab-$pkgver-py3-none-any.whl
}

sha512sums="
c39649c18ad74b080198c498bd439a7bfd5c38fd6bbb44a269b2c0fae14d58a8c57a6da2be8ba365d8dc018b7f1d522dfa7c32713b3c3e67782d044fe72f1071  python-crontab-v3.2.0.tar.gz
"
