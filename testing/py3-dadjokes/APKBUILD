# Contributor: Oleg Titov <oleg.titov@gmail.com>
# Maintainer: Oleg Titov <oleg.titov@gmail.com>
pkgname=py3-dadjokes
_pyname=dadjokes
pkgver=1.3.2
pkgrel=0
pkgdesc="icanhazdadjoke API wrapper, to programatically cheer your code up"
url="https://pypi.org/project/dadjokes/"
arch="noarch"
license="MIT"
depends="py3-requests"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	python3-dev
	"
# no test suit from upstream
options="!check"
subpackages="$pkgname-doc $pkgname-pyc"
source="py3-dadjokes-$pkgver.tar.gz::https://files.pythonhosted.org/packages/source/${_pyname%${_pyname#?}}/$_pyname/$_pyname-$pkgver.tar.gz"
builddir="$srcdir/dadjokes-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		dist/*.whl

	install -Dm644 README.md -t "$pkgdir"/usr/share/doc/"$pkgname"
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/"$pkgname"
}

sha512sums="
7cf51acb795bca932b3600039df16203db72b448a90e3e7685332f0dbcfc6e6ae5d1a9bd6a2de091c0fbbcbcf5c2297fdec27eb54e2fd7ec07c401abd378bf1b  py3-dadjokes-1.3.2.tar.gz
"
