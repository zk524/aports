# Contributor: Oleg Titov <oleg.titov@gmail.com>
# Maintainer: Oleg Titov <oleg.titov@gmail.com>
pkgname=py3-googlesearch-python
pkgver=1.3.0
pkgrel=0
pkgdesc="A Python library for scraping the Google search engine"
url="https://github.com/Nv7-GitHub/googlesearch"
arch="all"
license="MIT"
depends="
	py3-beautifulsoup4
	py3-requests
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	python3-dev
	"
# no test suit from upstream
options="!check"
subpackages="$pkgname-doc $pkgname-pyc"
source="py3-googlesearch_python-$pkgver.tar.gz::https://github.com/Nv7-GitHub/googlesearch/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/googlesearch-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		dist/*.whl

	install -Dm644 README.md -t "$pkgdir"/usr/share/doc/"$pkgname"
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/"$pkgname"
}

sha512sums="
3003dde3dd31f2e55756c23b9284ae8cbd5b0982f8c37bdbf2f64b8c2f6201213012d99547bbdde5c7e507639d29944be56929b51750688ae13784e6b4f24793  py3-googlesearch_python-1.3.0.tar.gz
"
