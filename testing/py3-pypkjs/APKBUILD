# Contributor: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Will Sinatra <wpsinatra@gmail.com>
pkgname=py3-pypkjs
_pkgname=pypkjs
pkgver=2.0.6
pkgrel=0
pkgdesc="Python implementation of PebbleKit JS"
url="https://github.com/coredevices/pypkjs"
arch="noarch"
license="MIT"
depends="
	py3-gevent
	py3-gevent-websocket
	py3-greenlet
	py3-peewee
	py3-geoip
	py3-pypng
	py3-dateutil
	py3-requests
	py3-sh
	py3-six
	py3-websocket-client
	py3-libpebble2
	py3-netaddr"
# Additionally need to package this for js watch emulation
#py3-stpyv8
makedepends="
	py3-gpep517
	py3-setuptools
	py3-build
	py3-installer
	py3-wheel
	"
subpackages="$pkgname-pyc"
source="$_pkgname-$pkgver.tar.gz::https://github.com/coredevices/pypkjs/archive/v$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"
options="!check" #no tests

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl

	install -Dm755 jskit.py "$pkgdir"/usr/bin/jskit
	install -Dm755 phonesim.py "$pkgdir"/usr/bin/phonesim
}

sha512sums="
634ef8274b080cead879184d2f497029d50c7869bf3b5e0d626c4defccab6ab6464ace36a9ae9ef1455915bac65ba4cde2ad33f3839e80605137b35b856d3af9  pypkjs-2.0.6.tar.gz
"
