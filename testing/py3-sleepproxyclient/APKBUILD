4981ec464484bd7b02883b5f690a65a9319af6e7e9bf906352a0f9f1152a5c2d56b670fdca8266b9e50d9ce2dc12a3234beaa317ccfa744dc7bd46f7548bbc27  30-avahi-check.patch
