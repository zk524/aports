# Contributor: Wen Heping <wenhepingalpine@sohu.com>
# Maintainer: Wen Heping <wenhepingalpine@sohu.com>
pkgname=py3-sqlite-fts4
pkgver=1.0.3
pkgrel=0
# _pkgreal is used by apkbuild-pypi to find modules at PyPI
_pkgreal=sqlite-fts4
pkgdesc="Python functions for working with SQLite FTS4 search"
url="https://pypi.org/project/sqlite-fts4/"
arch="noarch"
license="Apache License, Version 2.0"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
#checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/s/sqlite-fts4/sqlite-fts4-$pkgver.tar.gz"
options="!check" # no checks
builddir="$srcdir/$_pkgreal-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
fa958bba7b24e09554d8d384de3645070e75983608e13ddeaaa7db5eaf587463a56092e1275d7292c7fd3e873382a099b90c55dff99278528061eb0f9088f3cf  sqlite-fts4-1.0.3.tar.gz
"
