# Contributor: Bart Ribbers <bribbers@disroot.org>
# Contributor: Lindsay Zhou <i@lin.moe>
maintainer="Dominic <git@msrd0.de>"
pkgname=py3-tulir-telethon
pkgver=1.99.0_alpha6
_pkgver=1.99.0a6
pkgrel=0
pkgdesc="Full-featured Telegram client library"
url="https://github.com/tulir/Telethon"
arch="noarch"
license="MIT"
depends="
	py3-pyaes
	py3-rsa
	"
makedepends="
	py3-gpep517
	py3-setuptools
	py3-wheel
	"
checkdepends="
	py3-pytest
	py3-pytest-asyncio
	"
subpackages="$pkgname-pyc"
source="https://github.com/tulir/Telethon/archive/v$_pkgver/Telethon-v$_pkgver.tar.gz"
builddir="$srcdir/Telethon-$_pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest -k 'not test_all_methods_present'
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
4ee9fb57ddd55559353e05ba55f6ba613ed7c36d329611a9b3c7d4a51e21a2a2ac99c257ee9045574bb33e8e9f0411da3b67ab6a25323f22c55809fa73e15b07  Telethon-v1.99.0a6.tar.gz
"
