# Contributor: Zach DeCook <zachdecook@librem.one>
maintainer=
pkgname=py3-v4l2-python3
_pyname=v4l2-python3
pkgver=0.3.5
pkgrel=0
pkgdesc="Python bindings for the v4l2 userspace api"
url="https://github.com/RaspberryPiFoundation/python-v4l2"
arch="noarch"
license="GPLv2"
# Source is a pain to maintain
source="https://files.pythonhosted.org/packages/7a/d3/fa1e69c4f1902772e385660008d0b6f7108cc6de1365cc2aea680d34af2a/$_pyname-$pkgver.tar.gz"
depends="python3"
makedepends="py3-gpep517 py3-setuptools py3-wheel python3-dev"
options="!check" # Need a /dev/video* device for tests to run
builddir="$srcdir/$_pyname-$pkgver"
subpackgaes="$pkgname-pyc"

build() {
	gpep517 build-wheel \
		--wheel-dir dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --system-site-packages testenv
	testenv/bin/python3 -m installer dist/*.whl
	testenv/bin/python3 tests.py
}

package() {
	python3 -m installer -d "$pkgdir" \
		dist/*.whl
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
sha512sums="
2088433543ae9a7eec85a58c803e854e9d00da988f9bf0afac034ce2a6829f06efd3c94d4c56b96e71f05be5713d721b3b5a8caf659871b1f4b66a726dc0c336  v4l2-python3-0.3.5.tar.gz
"
