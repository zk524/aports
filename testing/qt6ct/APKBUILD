pkgname=qt6ct
pkgver=0.10
pkgrel=0
pkgdesc="Qt6 configuration tool"
url="https://www.opencode.net/trialuser/qt6ct"
arch="all"
license="BSD-2-Clause"
options="!check" # no test suite
makedepends="
	cmake
	qt6-qtbase-dev
	qt6-qtbase-private-dev
	qt6-qttools-dev
	"
source="https://www.opencode.net/trialuser/qt6ct/-/archive/$pkgver/$pkgname-$pkgver.tar.gz
	find-lrelease.patch
	"

build() {
	cmake -B build \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

