# Contributor: Camelia Lavender <cam@camelia.dev>
# Maintainer: Camelia Lavender <cam@camelia.dev>
pkgname=qview
_realname=qView
pkgver=7.1
pkgrel=0
pkgdesc="An image viewer designed with minimalism and usability in mind"
url="https://interversehq.com/qview/"
arch="all"
license="GPL-3.0-or-later"
depends="hicolor-icon-theme"
makedepends="qt6-qtbase-dev qt6-qttools-dev"
builddir="$srcdir/$_realname-$pkgver"
source="$pkgname-$pkgver.tar.gz::https://github.com/jurplel/qView/archive/refs/tags/$pkgver.tar.gz"
options="!check"  # requires a working display

build() {
	# /usr/bin/qmake6 is a broken symlink on Alpine 3.22
	/usr/lib/qt6/bin/qmake6 PREFIX=/usr
	make
}

package() {
	make INSTALL_ROOT="$pkgdir/" install
}

sha512sums="
