# Contributor: Matthias Ahouansou <matthias@ahouansou.cz>
maintainer="Matthias Ahouansou <matthias@ahouansou.cz>"
pkgname=rainfrog
pkgver=0.3.7
pkgrel=0
pkgdesc="Database management TUI"
url="https://github.com/achristmascarl/rainfrog"
arch="all"
license="MIT"
makedepends="
	cargo-auditable
	clang-libclang
	libgit2-dev
	sqlite-dev
"
subpackages="$pkgname-doc"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/achristmascarl/rainfrog/archive/refs/tags/v$pkgver.tar.gz
	system-sqlite.patch
"
options="net" # cargo dependencies

export LIBGIT2_NO_VENDOR=1 # use system libgit2

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	install -Dm 755 target/release/rainfrog "$pkgdir"/usr/bin/rainfrog

	install -Dm 644 LICENSE "$pkgdir"/usr/share/licenses/"$pkgname"/LICENSE
}

sha512sums="
