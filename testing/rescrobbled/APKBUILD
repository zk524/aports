# Contributor: Angelo Verlain <hey@vixalien.com>
maintainer="Angelo Verlain <hey@vixalien.com>"
pkgname=rescrobbled
pkgver=0.8.0
pkgrel=0
pkgdesc="MPRIS music scrobbler daemon"
url="https://github.com/InputUsername/rescrobbled"
arch="all"
license="GPL-3.0-or-later"
makedepends="cargo cargo-auditable"
subpackages="$pkgname-openrc"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/InputUsername/rescrobbled/archive/refs/tags/v$pkgver.tar.gz
	rescrobbled.initd
	"

prepare() {
	default_prepare

	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --frozen --release
}

check() {
	cargo test --frozen
}

package() {
	install -Dvm755 target/release/rescrobbled \
		-t "$pkgdir"/usr/bin/

	install -m755 -D "$srcdir"/$pkgname.initd "$pkgdir"/etc/user/init.d/$pkgname
}

sha512sums="
