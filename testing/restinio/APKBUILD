# Maintainer: Anjandev Momi <anjan@momi.ca>
pkgname=restinio
pkgver=0.7.4
pkgrel=0
pkgdesc="Header-only C++14 library that gives you an embedded HTTP/Websocket server"
url="https://stiffstream.com/en/products/restinio.html"
arch="noarch"
license=" BSD-3-Clause"
makedepends="
	asio-dev
	boost-dev
	catch2
	cmake
	expected-lite
	fmt-dev
	llhttp-dev
	openssl-dev
	pcre2-dev
	samurai
	zlib-dev
	"
subpackages="$pkgname-dev"
source="https://github.com/Stiffstream/restinio/releases/download/v.$pkgver/restinio-$pkgver.tar.bz2"
options="!check" # cant get checks to work

build() {
	if [ "$CBUILD" != "$CHOST" ]; then
		_cmake_crossopts="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_HOST_SYSTEM_NAME=Linux"
	fi
	cmake -B build -G Ninja -S dev \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=True \
		-DCMAKE_BUILD_TYPE=None \
		-DRESTINIO_BENCHMARK=OFF \
		-DRESTINIO_TEST=OFF \
		-DRESTINIO_SAMPLE=OFF \
		-DRESTINIO_DEP_CATCH2=find \
		-DRESTINIO_DEP_LLHTTP=system \
		-DRESTINIO_DEP_FMT=system \
		-DRESTINIO_DEP_EXPECTED_LITE=system \
		-DRESTINIO_WITH_SOBJECTIZER=OFF \
		$_cmake_crossopts
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
9de66277ced48b150d881499dc7b17b4cde7d6778271c361f9e407d0d2844ce5c83fdcb8017851dc4f1bf017f2306f75925b326ec97a3c479e38b20e5b793f6e  restinio-0.7.4.tar.bz2
"
