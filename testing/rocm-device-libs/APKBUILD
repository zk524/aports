eb19ad52a74daea4b6c4d276c4317b7839a48861bd23c4454b3d9ff55355180db1da359bb7d181cbe23dcc0c271eca09a5afb12fd9225de02e7c0daa64ee09df  0016-DeviceLibs-CMake-Policy-CMP0053-is-no-longer-support.patch
"
