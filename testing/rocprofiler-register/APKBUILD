maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=rocprofiler-register
pkgver=6.4.3
pkgrel=0
pkgdesc="Coordinate modifications to intercept API tables by the ROCprofiler"
url="https://github.com/ROCm/rocprofiler-register"
# armhf, armv7, x86: build fails due to type mismatch on 32bit
arch="all !armhf !armv7 !x86"
license="MIT"
depends="bash"
makedepends="rocm-cmake samurai glog-dev fmt-dev "
subpackages="$pkgname-doc $pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/ROCm/rocprofiler-register/archive/refs/tags/rocm-$pkgver.tar.gz
	disable-cpack.patch
	system-depends.patch
	"
options="!check" # no idea how to run tests
builddir="$srcdir/$pkgname-rocm-$pkgver"

build() {
	cmake -Wno-dev -S "$builddir" -B build \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DROCPROFILER_REGISTER_BUILD_GLOG=OFF \
		-DROCPROFILER_REGISTER_BUILD_FMT=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$builddir/LICENSE" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"

	# remove tests
	rm -rf "$pkgdir/usr/share/rocprofiler-register/tests/"
}

