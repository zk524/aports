maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=rocsparse
pkgver=3.4.0
_rocmver=6.4.3
pkgrel=0
pkgdesc="Basic Linear Algebra Subroutines (BLAS) for sparse computation"
url="https://github.com/ROCm/rocSPARSE"
# FIXME: missing hip
arch=""
license="MIT"
makedepends="cmake samurai hipcc clang-rocm"
source="$pkgname-$pkgver.tar.gz::https://github.com/ROCm/rocSPARSE/archive/refs/tags/rocm-$_rocmver.tar.gz"
options="!check net" # test pending, fetches something (FIXME!)
builddir="$srcdir/rocSPARSE-rocm-$_rocmver"

build() {
	export PATH="$PATH:/usr/lib/llvm-rocm/bin/"
	export CXX=clang
	cmake -B build -G Ninja -Wno-dev \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$builddir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

sha512sums="
