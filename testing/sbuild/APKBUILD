# Maintainer: qaqland <qaq@qaq.land>
pkgname=sbuild
pkgver=0.89.3
pkgrel=0
pkgdesc="Tool for building Debian binary packages from Debian sources"
url="https://tracker.debian.org/pkg/sbuild"
arch="noarch"
license="GPL-2.0-or-later"
depends="
	bash
	mmdebstrap
	"
makedepends="
	autoconf
	automake
	dpkg-dev
	perl-filesys-df
	mandoc-soelim
	"
checkdepends="
	shfmt
	perl-tidy
	findutils
	diffutils
	perl-yaml-tiny
	perl-mime-lite
	perl-exception-class
	"
subpackages="$pkgname-doc"
source="https://salsa.debian.org/debian/sbuild/-/archive/debian/$pkgver/sbuild-debian-$pkgver.tar.gz
	001-perl-path.patch
	"
builddir="$srcdir/sbuild-debian-$pkgver"

prepare() {
	default_prepare
	autoreconf -fi

	cd test
	./check-perltidy --write ./lib/Buildd/Daemon.pm
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install

	# sbuild-debian-developer-setup is deprecated
	rm "$pkgdir"/usr/bin/sbuild-debian-developer-setup

	cd "$pkgdir"/usr/bin
	ln -sf sbuild-abort buildd-abort
}

sha512sums="
