pkgname=sdrpp
pkgver=1.2.1_git20250624
_commit=a94e2d6712a6e5c80d6f6f27052e38be8a2ae0a9
pkgrel=0
pkgdesc="SDR++ is a cross-platform and open source SDR software with the aim of being bloat free and simple to use."
url="https://www.sdrpp.org/"
arch="all"
license="GPL-3.0"
depends="
	airspyone-host
"
makedepends="
	cmake
	ninja
	fftw-dev
	glfw-dev
	zstd-dev
	libvolk-dev
	airspyhf-dev
	airspyone-host-dev
	rtaudio-dev
	hackrf-dev
	librtlsdr-dev
"
source="https://github.com/AlexandreRouma/SDRPlusPlus/archive/$_commit.tar.gz"
builddir="$srcdir/SDRPlusPlus-$_commit"
options="!check" # there are no tests

build() {
	# disable plutosdr because alpine doesn't package libad9361
	cmake -B build -G Ninja\
		-DCMAKE_INSTALL_PREFIX="/usr"\
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5\
		-DOPT_BUILD_PLUTOSDR_SOURCE=0
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
