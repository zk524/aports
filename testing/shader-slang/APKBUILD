_spirv_tools_commit=3364b982713a0440d1d342dd5eec65b122a61b71
_spirv_headers_commit=e7294a8ebed84f8c5bd3686c68dbe12a4e65b644
_miniz_commit=18795fa61e590521381ba9e1fa4a4ab362b095f6
_lz4_commit=039ab4696526378ec0d111058b48305964284bf2
_unordered_dense_commit=fd80dad6285286db5be6d2588cc7ddb624db7e5a
_vulkan_headers_commit=39f924b810e561fd86b2558b6711ca68d4363f68
_metal_cpp_commit=a63bd172ddcba73a3d87ca32032b66ad41ddb9a6
_slang_rhi_commit=f562c4f4233b947766e3cc19b15ea3646642e3ca
source="
	$pkgname-$pkgver.tar.gz::https://github.com/shader-slang/slang/archive/refs/tags/v$pkgver.tar.gz
	0001-Fix-build-on-musl.patch
	glslang-$_glsang_commit.tar.gz::https://github.com/KhronosGroup/glslang/archive/$_glsang_commit.tar.gz
	tinyobjloader-$_tinyobjloader_commit.tar.gz::https://github.com/syoyo/tinyobjloader/archive/$_tinyobjloader_commit.tar.gz
	glm-$_glm_commit.tar.gz::https://github.com/g-truc/glm/archive/$_glm_commit.tar.gz
	imgui-$_imgui_commit.tar.gz::https://github.com/ocornut/imgui/archive/$_imgui_commit.tar.gz
	slang_binary-$_slang_binaries_commit.tar.gz::https://github.com/shader-slang/slang-binaries/archive/$_slang_binaries_commit.tar.gz
	spirv_tools-$_spirv_tools_commit.tar.gz::https://github.com/KhronosGroup/SPIRV-Tools/archive/$_spirv_tools_commit.tar.gz
	spirv_headers-$_spirv_headers_commit.tar.gz::https://github.com/KhronosGroup/SPIRV-Headers/archive/$_spirv_headers_commit.tar.gz
	miniz-$_miniz_commit.tar.gz::https://github.com/richgel999/miniz/archive/$_miniz_commit.tar.gz
	lz4-$_lz4_commit.tar.gz::https://github.com/lz4/lz4/archive/$_lz4_commit.tar.gz
	unordered_dense-$_unordered_dense_commit.tar.gz::https://github.com/martinus/unordered_dense/archive/$_unordered_dense_commit.tar.gz
	vulkan_headers-$_vulkan_headers_commit.tar.gz::https://github.com/KhronosGroup/Vulkan-Headers/archive/$_vulkan_headers_commit.tar.gz
	metal_cpp-$_metal_cpp_commit.tar.gz::https://github.com/bkaradzic/metal-cpp/archive/$_metal_cpp_commit.tar.gz
	slang_rhi-$_slang_rhi_commit.tar.gz::https://github.com/shader-slang/slang-rhi/archive/$_slang_rhi_commit.tar.gz
	"
builddir="$srcdir/slang-$pkgver"
options="!check"

prepare() {
	default_prepare

	rmdir "$builddir"/external/glslang
	ln -s "$srcdir/glslang-$_glsang_commit" "$builddir"/external/glslang
	rmdir "$builddir"/external/tinyobjloader
	ln -s "$srcdir/tinyobjloader-$_tinyobjloader_commit" "$builddir"/external/tinyobjloader
	rmdir "$builddir"/external/glm
	ln -s "$srcdir/glm-$_glm_commit" "$builddir"/external/glm
	rmdir "$builddir"/external/imgui
	ln -s "$srcdir/imgui-$_imgui_commit" "$builddir"/external/imgui
	rmdir "$builddir"/external/slang-binaries
	ln -s "$srcdir/slang-binaries-$_slang_binaries_commit" "$builddir"/external/slang-binaries
	rmdir "$builddir"/external/spirv-tools
	ln -s "$srcdir/SPIRV-Tools-$_spirv_tools_commit" "$builddir"/external/spirv-tools
	rmdir "$builddir"/external/spirv-headers
	ln -s "$srcdir/SPIRV-Headers-$_spirv_headers_commit" "$builddir"/external/spirv-headers
	rmdir "$builddir"/external/miniz
	ln -s "$srcdir/miniz-$_miniz_commit" "$builddir"/external/miniz
	rmdir "$builddir"/external/lz4
	ln -s "$srcdir/lz4-$_lz4_commit" "$builddir"/external/lz4
	rmdir "$builddir"/external/unordered_dense
	ln -s "$srcdir/unordered_dense-$_unordered_dense_commit" "$builddir"/external/unordered_dense
	rmdir "$builddir"/external/vulkan
	ln -s "$srcdir/Vulkan-Headers-$_vulkan_headers_commit" "$builddir"/external/vulkan
	rmdir "$builddir"/external/metal-cpp
	ln -s "$srcdir/metal-cpp-$_metal_cpp_commit" "$builddir"/external/metal-cpp
	rmdir "$builddir"/external/slang-rhi
	ln -s "$srcdir/slang-rhi-$_slang_rhi_commit" "$builddir"/external/slang-rhi
}

build() {
	export CXXFLAGS="$CXXFLAGS -D_LARGEFILE64_SOURCE"
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DSLANG_SLANG_LLVM_FLAVOR=DISABLE # required version is 13
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

