pkgname=shader-slang
pkgver=2025.5
pkgrel=0
pkgdesc="The Slang Shading Language and Compiler"
url="https://shader-slang.org/"
arch="x86_64 aarch64"
license="apache2"
makedepends="
	ninja
	cmake
	python3
	vulkan-headers
	libx11-dev
	"
subpackages="$pkgname-doc"
_glsang_commit=a0995c49ebcaca2c6d3b03efbabf74f3843decdb
