# Contributor: mekyt <hello@mek.yt>
# Maintainer: mekyt <hello@mek.yt>
pkgname=shiori
pkgver=1.7.4
pkgrel=0
pkgdesc="Simple bookmark manager cli and web"
url="https://github.com/go-shiori/shiori"
license="MIT"
arch="all"
makedepends="go"
subpackages="$pkgname-openrc"
pkgusers="$pkgname"
pkggroups="$pkgname"
install="$pkgname.pre-install"
subpackages="
	$pkgname-doc
	$pkgname-openrc
"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/go-shiori/shiori/archive/refs/tags/v$pkgver.tar.gz
	$pkgname.confd
	$pkgname.initd
"
options="!check net" # Need database and go package dependancies

export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"
export GOTMPDIR="${GOTMPDIR:-"$srcdir"}"
export GOMODCACHE="${GOMODCACHE:-"$srcdir/go"}"

build() {
	go build -ldflags "-s -w -X main.version=$pkgver"
}

check() {
	# Mysql database need
	go test ./...
}

package() {
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -Dm755 shiori -t "$pkgdir"/usr/bin/

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -Dm755 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname
}


