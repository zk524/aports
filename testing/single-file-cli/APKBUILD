pkgname=single-file-cli
pkgver=2.0.75
pkgrel=0
pkgdesc="CLI tool for saving a complete web page in a single HTML file."
url="https://github.com/gildas-lormeau/single-file-cli"
license="AGPL-3.0-or-later"
arch="noarch"
