options="!check" # no tests
builddir="$srcdir/parser-$pkgver/"

package() {
	npm install --omit=dev --global --prefix "$pkgdir/usr" "$srcdir/single-file-cli-$pkgver.tar.gz"
	chown -R root: "$pkgdir"
}

