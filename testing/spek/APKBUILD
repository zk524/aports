pkgname=spek
pkgver=0.8.5
pkgrel=0
pkgdesc="Acoustic spectrum analyser"
url="https://github.com/alexkay/spek"
arch="all"
license="GPL-3.0-only"
makedepends="
	autoconf
	automake
	ffmpeg-dev
	gettext-dev
	libtool
	wxwidgets-dev
	xz
"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/alexkay/spek/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/spek-$pkgver/"

build() {
	./autogen.sh --with-wx-config=/usr/bin/wx-config --prefix=/usr
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
