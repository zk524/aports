maintainer="Aster Boese <asterboese@mailbox.org>"
pkgname=sudo-rs
pkgver=0.2.7
pkgrel=0
pkgdesc="Memory safe implementation of sudo and su"
arch="all"
url="https://github.com/trifectatechfoundation/sudo-rs"
license="Apache-2.0 OR MIT"
depends="
	linux-pam
	tzdata
	"
makedepends="
	cargo
	cargo-auditable
	linux-pam-dev
	"
checkdepends="
	busybox-binsh
	uutils-coreutils
	xz
	"
subpackages="$pkgname-doc $pkgname-su:_su $pkgname-su-doc:su_doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/trifectatechfoundation/sudo-rs/archive/refs/tags/v$pkgver.tar.gz
	sudoers
	"
options="suid"
provides="sudo-virt"

prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release
}

check() {
	# canonicalization: requires /bin to be a symlink to /usr/bin
	# test_build_run_context: requires /bin to be a symlink to /usr/sbin
	# test_tty: expects /bin/sh to not be a symlink
	# open_pty: expects access to /dev/pts
	# mark_fds_as_cloexec: uses a syscall that takes a very long time
	# tcsetpgrp_and_tcgetpgrp_are_consistent: expects access to /dev/pts
	cargo test --frozen --release -- \
		--skip \
		common::resolve::test::canonicalization \
		--skip \
		common::context::tests::test_build_run_context \
		--skip \
		cutils::test::test_tty \
		--skip \
		system::term::tests::open_pty \
		--skip \
		system::tests::mark_fds_as_cloexec \
		--skip \
		system::term::tests::tcsetpgrp_and_tcgetpgrp_are_consistent
}

package() {
	# Install binaries
	local suid_bins="su sudo"
	for i in $suid_bins; do
		install -Dm4755 "$builddir"/target/release/"$i" \
			-t "$pkgdir"/usr/bin/
	done
	install -Dm755 "$builddir"/target/release/visudo \
		-t "$pkgdir"/usr/bin/

	# Install system config
	install -Dm644 "$srcdir"/sudoers \
		"$pkgdir"/etc/sudoers

	# Prints an annoying warning if sudoers.d isn't found
	mkdir -p "$pkgdir"/etc/sudoers.d
	# touch "$pkgdir"/etc/sudoers.d/user-sudo-config

	# Install documentation
	install -Dm644 LICENSE-APACHE LICENSE-MIT -t \
		"$pkgdir"/usr/share/licenses/"$pkgname"
	install -Dm644 docs/man/sudo.8.man \
		"$pkgdir"/usr/share/man/man8/sudo.8
	install -Dm644 docs/man/sudoers.5.man \
		"$pkgdir"/usr/share/man/man5/sudoers.5
	install -Dm644 docs/man/visudo.8.man \
		"$pkgdir"/usr/share/man/man8/visudo.8
}

_su() {
	pkgdesc="$pkgdesc (su binary)"

	amove usr/bin/su
}

su_doc() {
	install -Dm644 "$builddir"/docs/man/su.1.man \
		"$subpkgdir"/usr/share/man/man1/su.1
	default_doc
	pkgdesc="$pkgdesc (su documentation)"
	install_if="docs ${subpkgname#-doc}=$pkgver-r$pkgrel"
}

