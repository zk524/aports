# Maintainer: BlackCodec <f.dellorso@gmail.com>
pkgname=sworkstyle
_pkgname=swayest_workstyle
pkgver=1.3.5
pkgrel=0
pkgdesc="Tool to rename workspaces to the icons configured in sway"
url="https://github.com/Lyr-7D1H/swayest_workstyle"
license="MIT"
arch="all"
makedepends="cargo"
source="$_pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz"
options="net setcap !check" # no test suite

provider_priority=100

build() {
	cd $_pkgname-$pkgver
	cargo build --release --locked
}

package() {
	install -D -m755 "$srcdir/$_pkgname-$pkgver/target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
}

sha512sums="6d0e3b67d9b2fb3bc91b27e8d1ad62e0bbb652e49fd54c1bff5dc7d863b9fafe6d40af5d668332daaadf026a1f2cff5bf7ffa2c499442eaf0aaffcd8976db70a  swayest_workstyle-1.3.5.tar.gz"
