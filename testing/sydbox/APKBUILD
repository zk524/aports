# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=sydbox
pkgver=3.37.1
pkgrel=0
pkgdesc="user-space kernel to sandbox applications on Linux"
url="https://gitlab.exherbo.org/sydbox/sydbox"
# s390x: blocked by nix crate, https://github.com/nix-rust/nix/issues/2641
arch="all !s390x"
license="GPL-3.0-or-later"
depends="$pkgname-syd=$pkgver-r$pkgrel"
makedepends="
	cargo
	cargo-auditable
	libseccomp-dev
	linux-headers
	scdoc
	"
checkdepends="coreutils"
subpackages="
	$pkgname-doc
	$pkgname-utils
	$pkgname-pandora
	$pkgname-syd
	$pkgname-vim::noarch
	"
source="https://gitlab.exherbo.org/sydbox/sydbox/-/archive/v$pkgver/sydbox-v$pkgver.tar.gz
	make-install-no-build.patch
	no-syd-tck_patch
	no-systemd.patch
	"
builddir="$srcdir/$pkgname-v$pkgver"

case "$CARCH" in
armv7|loongarch64|x86)
	# Omit "oci" because "nc" crate fails to build.
	# armv7: error: cannot use register `r7`: the frame pointer (r7) cannot be used as an operand for inline asm
	# loongarch64: https://github.com/XuShaohua/nc/issues/44
	# x86: error: inline assembly requires more registers than available
	_features="log,utils" ;;
*)
	_features="log,oci,utils"
	subpackages="$subpackages $pkgname-oci" ;;
esac
_cargo_opts="--frozen --no-default-features --features $_features"

prepare() {
	default_prepare

	case "$CARCH" in
	aarch64|x86_64) ;;
	*)
		# Disable syd-tck as it is aarch64 & x86_64 specific and other
		# architectures will fail to fetch the required tick_counter crate
		echo "Patching out syd-tck for $CARCH"
		patch -Np1 < "$srcdir"/no-syd-tck_patch
		;;
	esac

	echo "Fetching crates"
	cargo fetch --target="$CTARGET" --locked

	echo "Fetching crates for pandora"
	cd "$builddir"/pandora && cargo fetch --target="$CTARGET" --locked
}

build() {
	echo "Building sydbox release with features: $_features"
	cargo auditable build $_cargo_opts --release

	echo "Building sydbox libs"
	cd "$builddir"/lib && cargo auditable build --frozen --release

	echo "Building sydbox's pandora"
	cd "$builddir"/pandora && cargo auditable build --frozen --release
}

check() {
	# architecture specific test failures
	case "$CARCH" in
	arm*|loongarch64)
		local _skipped_tests="
		--skip ptrace::tests::test_ptrace_get_syscall_info_random_args
		" ;;
	ppc64le)
		# proc_set_at_secure failed: ENOSYS: Function not implemented
		local _skipped_tests="
		--skip proc::tests::test_proc_set_at_secure_test_native_static_pie
		" ;;
	riscv64)
		# hash::tests failing in CI with ENOENT: No such file or directory
		local _skipped_tests="
		--skip hash::tests::test_aes_ctr_setup
		--skip hash::tests::test_aes_ctr_init
		--skip hash::tests::test_aes_ctr_enc_with_more_flag
		--skip hash::tests::test_aes_ctr_enc_and_dec
		--skip hash::tests::test_aes_ctr_enc_and_dec_tmp
		" ;;
	esac

	echo "Building sydbox tests with features: $_features"
	cargo test $_cargo_opts -- $_skipped_tests \
		--skip fs::tests::test_chdir_long \
		--skip fs::tests::test_getdir_long_limit_max_components \
		--skip fs::tests::test_getdir_long_with_deep_structure \
		--skip syd_test
		# the three fs::tests fail on all architectures in CI
		# syd_test: takes forever in CI
}

package() {
	pkgdesc="$pkgdesc (main utilities)"

	make install DESTDIR="$pkgdir" PREFIX=/usr

	# journalctl convenience wrapper
	rm -f "$pkgdir"/usr/bin/syd-log "$pkgdir"/usr/share/man/man1/syd-log.1

	install -D -m644 src/esyd.sh -t "$pkgdir"/usr/libexec/
	install -D -m644 data/user.syd-3 "$pkgdir"/usr/share/doc/$pkgname/user.syd-3.sample
}

syd() {
	pkgdesc="Rock-solid user-space kernel to sandbox applications on Linux"
	depends=""

	amove usr/bin/syd
	amove usr/bin/syd-tor
	# syd invokes syd-tor itself if you set sandbox/proxy:on
}

oci() {
	pkgdesc="Syd sandboxed OCI container runtime based on Youki"
	depends="$pkgname-syd=$pkgver-r$pkgrel"

	amove usr/bin/syd-oci
}

pandora() {
	pkgdesc="Sydbox's log inspector & profile writer"

	install -Dm0755 "$builddir"/pandora/target/release/pandora \
		-t "$subpkgdir"/usr/bin/
}

utils() {
	pkgdesc="$pkgdesc (extra utilities)"

	local bin; for bin in $(ls -1 "$pkgdir"/usr/bin/); do
		case "$bin" in
			syd | \
			syd-aes  | \
			syd-aux  | \
			syd-bit  | \
			syd-cap  | \
			syd-cpu  | \
			syd-dns  | \
			syd-elf  | \
			syd-env  | \
			syd-exec | \
			syd-hex  | \
			syd-info | \
			syd-key  | \
			syd-lock | \
			syd-oci  | \
			syd-pds  | \
			syd-size | \
			syd-test | \
			syd-test-do | \
			syd-tor) ;;  # Main programs + syd-oci
			*) amove usr/bin/$bin ;; # Utilities
		esac
	done
}

vim() {
	pkgdesc="$pkgdesc (vim syntax)"

	amove usr/share/vim
}

