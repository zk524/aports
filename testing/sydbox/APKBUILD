# Contributor: Jakub Jirutka <jakub@jirutka.cz>
# Maintainer: Jakub Jirutka <jakub@jirutka.cz>
pkgname=sydbox
pkgver=3.34.0_git20250602
pkgrel=0
_commit="093cb7e42489b39440b0a8c38a69bd59e310dc4a"
pkgdesc="Rock-solid user-space kernel to sandbox applications on Linux"
url="https://gitlab.exherbo.org/sydbox/sydbox"
# ppx64le: error: literal out of range for `i32` --> src/hook.rs
# riscv64: error[E0432]: unresolved import `libc::user_regs_struct` --> src/ptrace.rs
# s390x: blocked by nix crate
arch="all !ppc64le !riscv64 !s390x"
license="GPL-3.0-or-later"
depends=""
makedepends="
	cargo
	cargo-auditable
	libseccomp-dev
	linux-headers
	scdoc
	"
checkdepends="coreutils"
subpackages="
	$pkgname-doc
	$pkgname-utils
	$pkgname-pandora
	$pkgname-vim::noarch
	"
#source="https://gitlab.exherbo.org/sydbox/sydbox/-/archive/v$pkgver/sydbox-v$pkgver.tar.gz
#	make-install-no-build.patch
#	make-fix-install.patch
#	no-systemd.patch
#	"
#builddir="$srcdir/$pkgname-v$pkgver"
source="https://gitlab.exherbo.org/sydbox/sydbox/-/archive/$_commit/sydbox-$_commit.tar.gz
	make-install-no-build.patch
	make-fix-install.patch
	no-systemd.patch
	"
builddir="$srcdir/$pkgname-$_commit"

case "$CARCH" in
armv7|loongarch64|x86)
	# Omit "oci" because "nc" crate fails to build.
	# armv7: error: cannot use register `r7`: the frame pointer (r7) cannot be used as an operand for inline asm
	# loongarch64: error[E0425]: cannot find value `SA_RESTORER` in the crate root
	# x86: error: inline assembly requires more registers than available
	_features="log,utils" ;;
*)
	_features="log,oci,utils"
	subpackages="$subpackages $pkgname-oci" ;;
esac
_cargo_opts="--frozen --no-default-features --features $_features"

prepare() {
	default_prepare

	# NOTE: --targetu="$CTARGET" doesn't work here.
	cargo fetch --locked

	cd "$builddir"/pandora && cargo fetch --locked
}

build() {
	cargo auditable build $_cargo_opts --release

	cd "$builddir"/lib && cargo auditable build --frozen --release

	cd "$builddir"/pandora && cargo auditable build --frozen --release
}

check() {
	cargo test $_cargo_opts -- \
		--skip fs::tests::test_chdir_long \
		--skip fs::tests::test_getdir_long_limit_max_components \
		--skip fs::tests::test_getdir_long_with_deep_structure \
		--skip fs::tests::test_canonicalize_non_directory_with_slash \
		--skip ptrace::tests::test_ptrace_get_syscall_info_random_args \
		--skip syd_test

		# tests failing in CI, first three are common
		# x86: fs::tests::test_canonicalize_non_directory_with_slash
		# arm*: ptrace::tests::test_ptrace_get_syscall_info_random_args
		# syd_test: takes forever in CI
}

package() {
	make install DESTDIR="$pkgdir" PREFIX=/usr

	# Delete utils for running integration tests.
	rm -rf "$pkgdir"/usr/bin/syd-test*

	install -D -m644 src/esyd.sh -t "$pkgdir"/usr/libexec/
	install -D -m644 data/user.syd-3 "$pkgdir"/usr/share/doc/$pkgname/user.syd-3.sample
}

oci() {
	pkgdesc="OCI container runtime from sydbox"
	depends="$pkgname=$pkgver-r$pkgrel"

	amove usr/bin/syd-oci
}

pandora() {
	pkgdesc="Sydbox's log inspector & profile writer"

	install -Dm0755 "$builddir"/pandora/target/release/pandora \
		-t "$subpkgdir"/usr/bin/
}

utils() {
	pkgdesc="Sydbox utilities"

	local bin; for bin in $(ls -1 "$pkgdir"/usr/bin/); do
		case "$bin" in
			syd | \
			syd-aes  | \
			syd-aux  | \
			syd-bit  | \
			syd-cap  | \
			syd-cpu  | \
			syd-dns  | \
			syd-elf  | \
			syd-env  | \
			syd-exec | \
			syd-hex  | \
			syd-info | \
			syd-key  | \
			syd-lock | \
			syd-oci  | \
			syd-pds  | \
			syd-size | \
			syd-test | \
			syd-test-do | \
			syd-tor) ;;  # Main programs + syd-oci
			*) amove usr/bin/$bin ;; # Utilities
		esac
	done
}

vim() {
	pkgdesc="$pkgdesc (vim syntax)"

	amove usr/share/vim
}

