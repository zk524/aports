maintainer="Hoang Nguyen <folliekazetani@protonmail.com>"
pkgname=tetragon-client
pkgver=1.5.0
pkgrel=0
pkgdesc="CLI client for eBPF-based Security Observability and Runtime Enforcement"
url="https://github.com/cilium/tetragon"
arch="x86_64 aarch64" # fails to build on other platforms
license="Apache-2.0"
makedepends="go bash clang linux-headers"
subpackages="
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/cilium/tetragon/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/tetragon-$pkgver"

# TODO: build and add OpenRC service for tetragon
# Ref: https://tetragon.io/docs/installation/package/

export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"
export GOTMPDIR="${GOTMPDIR:-"$srcdir"}"
export GOMODCACHE="${GOMODCACHE:-"$srcdir/go"}"

build() {
	go build -v \
		-ldflags "-X github.com/cilium/tetragon/pkg/version.Version=v$pkgver" \
		./cmd/tetra

	for shell in bash fish zsh; do
		./tetra completion $shell > tetra.$shell
	done

	# Compile bpf programs (needed for tetragon binary)
	make -C bpf all

	# Compile helper programs used in check phase
	make -C contrib/tester-progs test-helper raisesigkill
}

check() {
	# Tests access files inside the repo relative to runtime.Caller(), so no -trimpath.
	# /bpf/tests: requires root privilege to run
	# /cmd/tetragon: tests timeout while starting tetragon process
	# /tests/e2e: we only run unittest
	# /pkg/bugtool: requires bpftool program, needs access to /sys/fs/bpf
	# /pkg/cgtracker/test: tries to create subdir /sys/fs/bpf/testcgtracker-test
	# /pkg/pidfile: tries to create /var/run/tetragon directory
	# /pkg/sensors/{exec,test,tracing}: tries to create subdir inside /sys/fs/bpf/
	# /pkg/sensors/exec/procevents, /pkg/cgroups: fail on CI (lacking cgroup controller "pids")
	# /pkg/tracepoint: tries to access /sys/kernel/debug/tracing/events/task/task_newtask/format
	# /contrib/verify: verify the existence of /var/lib/tetragon
	# TestProcessCgroup: fails to create cgroup map
	# TestGetPid1Status: reads /proc/1/status expecting uid=0
	# TestNamespaceValueStr: reads host_ns PID namespace value, expecting to be root
	# TestSpecs: insufficient permissions while reading kernel symbols
	# shellcheck disable=2046
	GOFLAGS="${GOFLAGS/-trimpath/}" go test \
		-skip 'Test(ProcessCgroup|GetPid1Status|NamespaceValueStr|Specs)' \
		$(go list ./... | grep -v \
		-e '/bpf/tests$' \
		-e '/cmd/tetragon$' \
		-e '/pkg/bugtool$' \
		-e '/pkg/cgroups$' \
		-e '/pkg/cgtracker/test$' \
		-e '/pkg/pidfile$' \
		-e '/pkg/sensors/exec$' \
		-e '/pkg/sensors/exec/procevents$' \
		-e '/pkg/sensors/test$' \
		-e '/pkg/sensors/tracing$' \
		-e '/pkg/tracepoint$' \
		-e '/tests/e2e/tests' \
		-e '/contrib/verify$' \
		)
}

package() {
	install -Dm755 tetra -t "$pkgdir"/usr/bin/

	install -Dm644 tetra.bash \
		"$pkgdir"/usr/share/bash-completion/completions/tetra
	install -Dm644 tetra.fish \
		"$pkgdir"/usr/share/fish/vendor_completions.d/tetra.fish
	install -Dm644 tetra.zsh \
		"$pkgdir"/usr/share/zsh/site-functions/_tetra
}

