# For referrence, upstream uses the following for official builds:
# https://gitlab.torproject.org/tpo/applications/tor-browser-build/
maintainer="Hugo Osvaldo Barrera <hugo@whynothugo.nl>"
pkgname=tor-browser
pkgver=14.5.5
pkgrel=0
pkgdesc="Modified Firefox ESR for browsing over Tor"
url="https://www.torproject.org"
# x86: error with libgkrust.a, needs research
# armhf: build error in encoding_rs (unresolved import)
# armv7: build fails
# ppc64le: build fails
# s390x: security/sandbox/linux/reporter/SandboxReporter.cpp: "unrecognized architecture"
# riscv64: security/sandbox/chromium/sandbox/linux/system_headers/linux_signal.h: "Unsupported platform"
# loongarch64: libc crate
arch="all !x86 !armhf !armv7 !ppc64le !s390x !riscv64 !loongarch64"
license="GPL-3.0-only AND LGPL-2.1-only AND LGPL-3.0-only AND MPL-2.0"
depends="
	tor
	obfs4proxy
	snowflake
"
_llvmver=20
makedepends="
	alsa-lib-dev
	cargo
	cbindgen
	clang$_llvmver
	clang$_llvmver-libclang
	gtk+3.0-dev
	jq
	libice-dev
	libsm-dev
	lld
	llvm$_llvmver-dev
	m4
	nasm
	nodejs
	pulseaudio-dev
	py3-setuptools
	wasi-sdk
"
# https://gitlab.torproject.org/tpo/applications/tor-browser/-/archive/base-browser-128.13.0esr-14.5-1-build2/tor-browser-base-browser-128.13.0esr-14.5-1-build2.tar.gz
source="
	https://dist.torproject.org/torbrowser/$pkgver/src-firefox-tor-browser-128.13.0esr-${pkgver%.*}-1-build2.tar.xz
	https://dist.torproject.org/torbrowser/$pkgver/tor-browser-linux-x86_64-$pkgver.tar.xz
	fix-rust-target.patch
	rust-lto-thin.patch
	force-can-use-pack-relative-relocs.patch
	distribution.ini
	system-tor.patch
	no-relative-dir.patch
	tor-browser.desktop
"
options="!check" # tests are not easily portable/adaptable
builddir="$srcdir/firefox-tor-browser-128.13.0esr-${pkgver%.*}-1-build2/"
sonameprefix="$pkgname:"

case "$CARCH" in
	armhf|armv7) makedepends="$makedepends perl";;
esac

# Define app prefix
_appname="tor-browser"
_prefix="/usr/lib/$_appname"

prepare() {
	default_prepare

	case "$CARCH" in
		aarch64|x86_64) _mozarch=$CARCH;;
		armhf|armv7) _mozarch=arm;;
		x86) _mozarch=i686;;
		# Conservative/generic fallback:
		*) _mozarch=aarch64;;
	esac

	cat mozconfig-linux-$_mozarch - <<-EOF > .mozconfig
	mk_add_options RUSTFLAGS="$RUSTFLAGS"
	mk_add_options MOZ_OBJDIR="$builddir/obj"

	# disable unwanted things
	ac_add_options --disable-bootstrap
	ac_add_options --disable-cargo-incremental
	ac_add_options --disable-debug
	ac_add_options --disable-debug-symbols
	ac_add_options --disable-install-strip
	ac_add_options --disable-jemalloc
	ac_add_options --disable-strip
	ac_add_options --disable-tests
	ac_add_options --disable-updater

	# fingerprint convergence
	ac_add_options --enable-system-pixman

	# buildopts
	ac_add_options --host=$CBUILD
	ac_add_options --target=$CHOST
	ac_add_options --enable-release
	ac_add_options --enable-lto=thin
	ac_add_options --enable-linker=lld
	ac_add_options --enable-optimize="$CFLAGS"
	ac_add_options --with-libclang-path=/usr/lib/llvm$_llvmver/lib

	# misc
	ac_add_options --prefix=/usr
	ac_add_options --with-app-name=$_appname
	ac_add_options --with-base-browser-version=$pkgver
	ac_add_options --enable-update-channel=release
	ac_add_options --with-branding=browser/branding/tb-release
	ac_add_options --enable-release
	ac_add_options --enable-sandbox
	ac_add_options --enable-forkserver
EOF
}

build() {
	export MOZ_BUILD_DATE="$(date ${SOURCE_DATE_EPOCH:+ -d@${SOURCE_DATE_EPOCH}} "+%Y%m%d%H%M%S")"
	export MOZBUILD_STATE_PATH="$srcdir"/mozbuild

	export CC="clang-$_llvmver"
	export CXX="clang++-$_llvmver"
	export RUST_TARGET="$CTARGET"
	export CFLAGS="${CFLAGS/-fstack-clash-protection/} -g0 -O2"
	export CXXFLAGS="${CXXFLAGS/-fstack-clash-protection/} -g0 -O2 -Wno-deprecated-builtins -Wno-deprecated-declarations"
	export LDFLAGS="$LDFLAGS -Wl,-rpath,$_prefix"

	# build handles this already
	unset CARGO_PROFILE_RELEASE_OPT_LEVEL
	unset CARGO_PROFILE_RELEASE_LTO

	# build fails when this is set
	unset RUSTFLAGS

	# Building in the source directory is disallowed.
	cd "$srcdir"
	python "$builddir/configure.py"
	make
}

package() {
	DESTDIR="$pkgdir" make -C "$srcdir" install

	# Install icons
	for size in 16 22 24 32 48 64 128 256; do
		install -Dm644 "browser/branding/tb-release/default${size}.png" \
			"$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$_appname.png"
	done
	install -Dm644 "browser/branding/tb-release/content/about-logo.svg" \
		"$pkgdir/usr/share/icons/hicolor/scalable/apps/$_appname.svg"

	install -Dm644 "$srcdir"/distribution.ini \
		"$pkgdir"/$_prefix/distribution/distribution.ini

	install -Dm 644 "$srcdir/dist/bin/browser/defaults/preferences/000-tor-browser.js" \
		-t "$pkgdir/$_prefix/browser/defaults/preferences/"

	install -Dm 644 "$srcdir/dist/bin/browser/chrome/browser/content/browser/default-bookmarks.html" \
		-t "$pkgdir/$_prefix//browser/defaults/profile/"

	install -Dm 644 "$srcdir/tor-browser/Browser/TorBrowser/Data/Tor/torrc-defaults" \
		-t "$pkgdir/usr/share/tor-browser/"

	install -Dm 644 "$srcdir/tor-browser.desktop" \
		-t "$pkgdir/usr/share/applications/"

	cd "$srcdir/tor-browser/Browser"
	find fonts -type f -exec install -Dm644 {} "$pkgdir/$_prefix/{}" \;
}


