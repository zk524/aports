# Maintainer: The Artifex (4r7if3x) <the.artifex@proton.me>
pkgname=treegen
pkgver=1.1.0
pkgrel=0
pkgdesc="ASCII Tree Directory and File Structure Generator"
url="https://github.com/bilbilak/treegen"
arch="all"
license="GPL-3.0-only"
makedepends="go"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/bilbilak/treegen/archive/refs/tags/v$pkgver.tar.gz"
options="net" # go dependencies

build() {
	go build -ldflags "-X github.com/bilbilak/treegen/config.Version=$pkgver" -o "$pkgname"
}

check() {
	./treegen --version
}

package() {
	install -Dm755 "$pkgname" -t "$pkgdir/usr/bin/"
	install -Dm644 "$pkgname.1" -t "$pkgdir/usr/share/man/man1/"
	install -Dm644 LICENSE.md -t "$pkgdir/usr/share/licenses/$pkgname/"
}

sha512sums="
858783cc02b1a5ac67436ac3bd4096e1a8bf831c11f5685aa895e28e1b6c282013a251f1fbbd655b412e753fa756e5f8110ebee7bb0919a5407dc9c041bdb307  treegen-1.1.0.tar.gz
"
