# Contributor: Lucas Ieks <lucas@ieks.cc>
# Maintainer: Lucas Ieks <lucas@ieks.cc>
pkgname=trenchbroom
pkgver=2025.3
pkgrel=0
pkgdesc="Cross-platform level editor"
url="https://trenchbroom.github.io/"
# most are blocked by pandoc, aarch64 doesn't build because of a header conflict
arch="x86_64"
license="GPL-3.0-or-later"
makedepends="cmake
	samurai
	assimp-dev
	freeimage-dev
	freetype-dev
	miniz-dev
	catch2
	fmt-dev
	glew-dev
	tinyxml2-dev
	qt6-qtbase-dev
	qt6-qtsvg-dev
	gtest-dev
	pandoc"
subpackages="$pkgname-doc"
source="trenchbroom-$pkgver.tar.gz::https://github.com/TrenchBroom/TrenchBroom/archive/refs/tags/v$pkgver.tar.gz
	musl.patch
	wayland.patch
	version.patch
	remove-vcpkg.patch"
builddir="$srcdir/TrenchBroom-$pkgver"

build() {
	export OVERRIDE_VERSION="v$pkgver"
	export QT_QPA_PLATFORM=offscreen
	cmake -B "$srcdir/build" -DCMAKE_INSTALL_PREFIX=/usr
	cmake --build "$srcdir/build"
}

check() {
	export QT_QPA_PLATFORM=offscreen
	# adapted from CI-linux.sh
	cd "$srcdir/build/lib/vm/test"
	./vm-test
	cd "$srcdir/build/lib/kdl/test"
	./kdl-test
	cd "$srcdir/build/common/test"
	./common-test
	./common-regression-test
}

package() {
	DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}

doc() {
	default_doc
	amove usr/share/TrenchBroom/manual
}

