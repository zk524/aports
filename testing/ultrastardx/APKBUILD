# Maintainer: Marco Schröder <marco.schroeder96@gmail.com>
pkgname=ultrastardx
pkgver=2025.1.0
pkgrel=0
pkgdesc="free and open source karaoke singing game"
url="https://usdx.eu"
# No fpc package availavle on some architectures
arch="all !ppc64le !loongarch64 !s390x !riscv64"
license="GPL-2.0-only"
makedepends="fpc ffmpeg-dev freetype-dev lua-dev sdl2_image-dev sqlite-dev automake autoconf"
source="usdx-$pkgver.tar.gz::https://github.com/UltraStar-Deluxe/USDX/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/USDX-$pkgver"
options="!check" # No Tests

prepare() {
	default_prepare
	./autogen.sh
}

build() {
	./configure --prefix=/usr
	# define srcdir again, as the variable is used in the Makefile and reset by rootbld
	make LDFLAGS="-O1 --sort-common --as-needed -z relro" srcdir=.
}

package() {
	# define srcdir again, as the variable is used in the Makefile and reset by rootbld
	make DESTDIR="$pkgdir/" srcdir=. install
	install -Dm644 dists/ultrastardx.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"
	install -Dm644 game/resources/icons/ultrastardx-icon.png "$pkgdir/usr/share/pixmaps/ultrastardx.png"
}

sha512sums="
384d626b3df7f4d0a04935a00d8a4ad6ff33d65a3d7ed76e325840870ec81eaf2d780a1e4289043854139d485b7e78eb8bc13723115732a0ddfb1f799ff214c0  usdx-2025.1.0.tar.gz
"
