# Maintainer: Luis Henriques <henrix@camandro.org>
pkgname=unrar-free
pkgver=0.3.2
pkgrel=0
pkgdesc="Free software version of the non-free unrar utility"
url="https://gitlab.com/bgermann/unrar-free"
arch="all"
license="GPL-2.0-only"
depends="libarchive"
makedepends="autoconf libtool automake libarchive-dev argp-standalone"
subpackages="$pkgname-doc"
source="https://gitlab.com/bgermann/unrar-free/-/archive/$pkgver/unrar-free-$pkgver.tar.gz"

prepare() {
	default_prepare
	autoreconf -vif
}

build() {
	LIBS=-largp \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
6d633607a5c588d2994b16f8f775a4e7ee0020999c9347174e00ea8b50a90c49c974ffedca5567ff58487936d7ecd6b49e070224ee08823d3fe90ff522f16412  unrar-free-0.3.2.tar.gz
"
