# Contributor: Adam Thiede <me@adamthiede.com>
# Maintainer: Adam Thiede <me@adamthiede.com>
pkgname=uptime-kuma
pkgver=1.23.16
pkgrel=0
pkgdesc="A fancy self-hosted monitoring tool"
url="https://uptime.kuma.pet"
# armhf builds depend on libc.musl-armv7.so.1; disabling
arch="all !armhf"
license="MIT"
depends="nodejs"
makedepends="npm python3"
subpackages="$pkgname-openrc"
pkgusers="uptimekuma"
install="$pkgname.pre-install"
source="$pkgname-$pkgver.tar.gz::https://github.com/louislam/uptime-kuma/archive/refs/tags/$pkgver.tar.gz
	$pkgname-$pkgver-dist.tar.gz::https://github.com/louislam/uptime-kuma/releases/download/$pkgver/dist.tar.gz
	uptime-kuma.initd
"
options="net !check" # npm install needs net, cypress tests only run on arm64/x86_64
case "$CARCH" in
	x86_64|aarch64)
		options="net";;
esac


build() {
	npm ci --omit dev
}

check() {
	# don't want to include dev/test dependencies in node_modules
	mv node_modules "$srcdir"/node_modules
	npm install cross-env
	npm run test
	rm -rf node_modules && mv "$srcdir"/node_modules .
}

package() {
	mv "$srcdir"/dist "$builddir"/dist
	mkdir -p "$pkgdir"/usr/lib
	cp -r "$builddir" "$pkgdir"/usr/lib/uptime-kuma
	chown -R uptimekuma "$pkgdir"/usr/lib/uptime-kuma
	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
}

