782ae5b21e52d09d22f95801f2766f1354e09d5ae5bf9db638f58aea8116c760906b148a04726a2155ecb5246b4d6cf2aad498d18fe2df5fba0a3b24035a2d51  pebble-loong64_patch
ef209819fdce382c5b171e21838e3f6b16c7261a63d9a15e96e5b4212b05c44e473a3357c5bf8186e3eb27ac403c03555cebdccdce16425699bba111709f8e88  go-ole-riscv64-loong64_patch
"
