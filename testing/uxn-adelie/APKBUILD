pkgname=uxn-adelie
pkgver=0_git20240820
_commit=7af4a28763058ebc518d65ed983e0fca5007ef4c
pkgrel=0
pkgdesc="Slideshow program written in uxntal"
url="https://git.sr.ht/~rabbits/adelie"
arch="noarch"
license="ISC"
depends="uxnemu"
makedepends="uxnasm"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://git.sr.ht/~rabbits/adelie/archive/$_commit.tar.gz
	adelie"
builddir="$srcdir/adelie-$_commit"
options="!check" # no tests available

build() {
	uxnasm src/adelie.tal adelie.rom
}

package() {
	install -Dm644 -t "$pkgdir"/usr/share/uxn/roms adelie.rom*
	install -Dm755 -t "$pkgdir"/usr/bin "$srcdir"/adelie
	install -Dm644 -t "$pkgdir"/usr/share/doc/uxn-adelie slides
	install -Dm644 -t "$pkgdir"/usr/share/doc/uxn-adelie/etc etc/*.tga
	install -Dm644 -t "$pkgdir"/usr/share/doc/uxn-adelie README.md
}

