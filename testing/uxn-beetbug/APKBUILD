pkgname=uxn-beetbug
pkgver=0_git20240101
_commit=3dd82acaa2d2c04b10acd93b55a32e031d418c6f
pkgrel=0
pkgdesc="Step debugger for Uxn"
url="https://git.sr.ht/~rabbits/beetbug"
arch="noarch"
license="ISC"
depends="uxnemu"
makedepends="uxnasm"
source="$pkgname-$pkgver.tar.gz::https://git.sr.ht/~rabbits/beetbug/archive/$_commit.tar.gz
	beetbug"
builddir="$srcdir/beetbug-$_commit"
options="!check" # no automatic tests available

build() {
	uxnasm src/beetbug.tal beetbug.rom
}

package() {
	install -Dm644 -t "$pkgdir"/usr/share/uxn/roms beetbug.rom*
	install -Dm755 -t "$pkgdir"/usr/bin "$srcdir"/beetbug
}

