pkgname=uxn-drifblim
pkgver=0_git20250119
_commit="8e8252a31719763689745f63610a9b2c8f10b70e"
pkgrel=0
pkgdesc="UXN assembler written in uxntal"
url="https://git.sr.ht/~rabbits/drifblim"
arch="noarch"
license="ISC"
depends="uxncli"
makedepends="uxnasm"
source="$pkgname-$pkgver.tar.gz::https://git.sr.ht/~rabbits/drifblim/archive/$_commit.tar.gz
	drifblim"
builddir="$srcdir/drifblim-$_commit"

build() {
	make
}

check() {
	# drifblim should work the same as uxnasm
	uxncli bin/drifblim.rom src/drifblim.tal bin/drifblim2.rom
	cmp bin/drifblim.rom bin/drifblim2.rom
}

package() {
	install -Dm644 -t "$pkgdir"/usr/share/uxn/roms bin/drifblim.rom*
	install -Dm755 -t "$pkgdir"/usr/bin "$srcdir"/drifblim
}

sha512sums="
