# Maintainer: Waweic <waweic@activ.ism.rocks>
pkgname=uxn
pkgver=1.0_git20250131
_commit=5829f7da504f77dbc44037250871befd64da79b3
pkgrel=2
pkgdesc="the Uxn stack-machine"
url="https://wiki.xxiivv.com/site/uxn.html"
arch="all"
license="MIT"
makedepends="sdl2-dev"
subpackages="$pkgname-doc uxnasm uxncli uxnemu"
depends="uxnasm uxncli uxnemu"
options="!check" #Tests not working yet
source="$pkgname-$pkgver.tar.gz::https://git.sr.ht/~rabbits/uxn/archive/$_commit.tar.gz"
builddir="$srcdir/uxn-$_commit"

build() {
	HOME=$(mktemp -d) ./build.sh --no-run

	for dir in projects/software projects/examples/demos; do
		local category=${dir/*\//}
		mkdir -p roms/$category
		for file in $(cd "$dir"; echo *); do
			bin/uxnasm "$dir/$file" roms/$category/"${file/.tal/.rom}"
		done
	done
}

package() {
	install -Dm755 -t "$pkgdir"/usr/bin/ "bin/uxnasm"
	install -Dm755 -t "$pkgdir"/usr/bin/ "bin/uxnemu"
	install -Dm755 -t "$pkgdir"/usr/bin/ "bin/uxncli"

	install -Dm644 -t "$pkgdir"/usr/share/uxn/roms/software roms/software/*
	install -Dm644 -t "$pkgdir"/usr/share/uxn/roms/demos roms/demos/*

	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

uxnasm() {
	pkgdesc="assembler for $pkgdesc"
	depends=""

	amove /usr/bin/uxnasm
}

uxnemu() {
	pkgdesc="SDL emulator for $pkgdesc"
	depends=""

	amove /usr/bin/uxnemu
}

uxncli() {
	pkgdesc="command line emulator for $pkgdesc"
	depends=""

	amove /usr/bin/uxncli
}

sha512sums="
