pkgname=uxnbal
pkgver=0_git20240317
_commit=17b04291f34e1b2da2f4ea2a081612f4261ae004
pkgrel=0
pkgdesc="Stack effect checker for the Uxntal programming language"
url="https://git.sr.ht/~rabbits/uxnbal"
arch="noarch"
license="MIT"
depends="uxncli"
makedepends="uxnasm"
source="$pkgname-$pkgver.tar.gz::https://git.sr.ht/~rabbits/uxnbal/archive/$_commit.tar.gz
	uxnbal"
builddir="$srcdir/uxnbal-$_commit"

build() {
	uxnasm src/uxnbal.tal uxnbal.rom
}

check() {
	# check basic functionality
	echo "@test ( -> ) 42 JMP2r" > test.tal
	uxncli uxnbal.rom test.tal 2>&1 | grep Imbalance
}

package() {
	install -Dm644 -t "$pkgdir"/usr/share/uxn/roms uxnbal.rom*
	install -Dm755 -t "$pkgdir"/usr/bin "$srcdir"/uxnbal
}

