pkgname=uxnfor
pkgver=0_git20241223
_commit=e3c95927b19e25c95f379995b4b2481d3c26d35a
pkgrel=0
pkgdesc="Formatter for the Uxntal programming language"
url="https://git.sr.ht/~rabbits/uxnfor"
arch="noarch"
license="ISC"
depends="uxncli"
makedepends="uxnasm"
source="$pkgname-$pkgver.tar.gz::https://git.sr.ht/~rabbits/uxnfor/archive/$_commit.tar.gz
	uxnfor"
builddir="$srcdir/uxnfor-$_commit"

build() {
	uxnasm src/uxnfor.tal uxnfor.rom
}

check() {
	# check basic functionality
	echo "@test ( x -> x' ) ADD JMP2r" > test.tal
	cat > expect.tal <<EOF


@test ( x -> x' )
	ADD JMP2r

EOF
	uxncli uxnfor.rom test.tal
	diff -u expect.tal test.tal
}

package() {
	install -Dm644 -t "$pkgdir"/usr/share/uxn/roms uxnfor.rom*
	install -Dm755 -t "$pkgdir"/usr/bin "$srcdir"/uxnfor
}

