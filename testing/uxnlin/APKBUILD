pkgname=uxnlin
pkgver=0_git20250119
_commit=90c456d17aba6f6414044c99ef1e80106239d74b
pkgrel=0
pkgdesc="Linter for the Uxntal programming language"
url="https://git.sr.ht/~rabbits/uxnlin"
arch="noarch"
license="MIT"
depends="uxncli"
makedepends="uxnasm"
source="$pkgname-$pkgver.tar.gz::https://git.sr.ht/~rabbits/uxnlin/archive/$_commit.tar.gz
	uxnlin"
builddir="$srcdir/uxnlin-$_commit"

build() {
	uxnasm src/uxnlin.tal uxnlin.rom
}

check() {
	# check basic functionality
	echo "@test #02 ADD" > test.tal
	uxncli uxnlin.rom test.tal 2>&1 | grep "INC INC"
}

package() {
	install -Dm644 -t "$pkgdir"/usr/share/uxn/roms uxnlin.rom*
	install -Dm755 -t "$pkgdir"/usr/bin "$srcdir"/uxnlin
}

