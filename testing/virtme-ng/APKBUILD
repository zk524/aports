45b48d052894d58d47be6beaaa8abe0e532d48a3ae06a4f189442cb3e83cd9e8aacd3ab93c05cb617e6ffdff23160b675e71eb57b3e8405b7efa1713f45e1d45  virtme-commands-run-also-identify-static-PIE-busybox.patch
"
