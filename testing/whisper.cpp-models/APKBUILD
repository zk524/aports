# Maintainer: Marian Buschsieweke <marian.buschsieweke@posteo.net>
pkgname=whisper.cpp-models
pkgver=0_git20231010
_commit=d15393806e24a74f60827e23e986f0c10750b358
pkgrel=0
pkgdesc="OpenAI's Whisper models converted for use with whisper.cpp"
url="https://huggingface.co/ggerganov/whisper.cpp"
# s390x: limited by whisper.cpp
arch="noarch !s390x"
# From https://github.com/openai/whisper:
# > Whisper's code and model weights are released under the MIT License. See LICENSE for further details.
# These are the model weights repackaged for whisper.cpp
license="MIT"
depends="whisper.cpp"

# Quantized models are smaller and faster to process
_quantization="q5_1"
# Models above small are huge and slow. Users can still download them
# by hand.
_models="
	tiny
	tiny.en
	base
	base.en
	small
	small.en
	"

for model in $_models; do
	source="$source $pkgname-$model-$_commit.bin::https://huggingface.co/ggerganov/whisper.cpp/resolve/$_commit/ggml-$model-$_quantization.bin?download=true"
	subpackages="$subpackages whisper.cpp-model-$model:_subpkg"
done

options="!check" # no unit tests provided

package() {
	for model in $_models; do
		depends="$depends whisper.cpp-model-$model"
	done

	mkdir -p "$pkgdir"/usr/share/whisper.cpp
	mkdir -p "$pkgdir"/usr/bin
	for model in $_models; do
		cp "$srcdir/$pkgname-$model-$_commit.bin" "$pkgdir/usr/share/whisper.cpp/ggml-$model-$_quantization.bin"
		cat > "$pkgdir/usr/bin/whisper.cpp-$model" << EOF
#!/bin/sh
exec whisper.cpp -m /usr/share/whisper.cpp/ggml-$model-$_quantization.bin "\$@"
EOF
		chmod +x "$pkgdir/usr/bin/whisper.cpp-$model"
	done
}

_subpkg() {
	local model
	model="${subpkgname#whisper.cpp-model-}"
	pkgdesc="$model model for whisper.cpp"
	amove "usr/share/whisper.cpp/ggml-$model-$_quantization.bin"
	amove "usr/bin/whisper.cpp-$model"
}

