# Maintainer: Marian Buschsieweke <marian.buschsieweke@posteo.net>
pkgname=whisper.cpp
pkgver=1.5.4
pkgrel=0
pkgdesc="Port of OpenAI's Whisper model in C/C++"
url="https://github.com/ggerganov/whisper.cpp"
# s390x: not big-endian safe, see https://github.com/ggerganov/whisper.cpp/issues/1877
arch="all !s390x"
license="MIT"
makedepends="
	cmake
	samurai
	chrpath
	"
source="
	whisper-cpp-$pkgver.tar.gz::https://github.com/ggerganov/whisper.cpp/archive/refs/tags/v$pkgver.tar.gz
	"
subpackages="
	$pkgname-dev
	$pkgname-libs
	$pkgname-utils
	"

build() {
	local cmake_extra_opts
	case "$CARCH" in
		x86_64)
			;;
		*)
			cmake_extra_opts="
				-DWHISPER_NO_AVX=ON
				-DWHISPER_NO_AVX2=ON
				-DWHISPER_NO_FMA=ON
				-DWHISPER_NO_F16C=ON
				"
			;;
	esac
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		$cmake_extra_opts

	cmake --build build
}

check() {
	local exclude_tests
	case "$CARCH" in
		arm*|x86)
			# large model doesn't into virtual address space on 32-bit archs
			exclude_tests="-E test-main-large*"
			;;
		ppc64le)
			# test are slooooow on ppc64le, so only run the quick ones
			exclude_tests="-E test-main-large|test-main-medium*"
			;;
	esac
	cd build
	CTEST_OUTPUT_ON_FAILURE=TRUE ctest $exclude_tests
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	mkdir -p "$pkgdir"/usr/bin

	cp build/bin/main "$pkgdir"/usr/bin/whisper.cpp
	cp build/bin/server "$pkgdir"/usr/bin/whisper.cpp-server
	cp build/bin/quantize "$pkgdir"/usr/bin/whisper.cpp-quantize

	# drop $builddir rpath
	find "$pkgdir"/usr/bin -name 'whisper.cpp*' -exec chrpath -d {} \;
}

utils() {
	pkgdesc="Utilities for whisper.cpp"
	depends="$pkgname"
	amove usr/bin/whisper.cpp-server
	amove usr/bin/whisper.cpp-quantize
}

libs() {
	default_libs

	amove usr/lib/libwhisper.so
}

sha512sums="
