pkgname=widle
pkgver=20250820
pkgrel=0
pkgdesc="Run a command upon becoming idle"
url="https://codeberg.org/sewn/widle"
arch="all"
license="GPL-3.0-or-later"
depends="wayland-libs-client"
makedepends="pkgconf wayland-protocols wayland-dev"
checkdepends=""
install=""
subpackages="$pkgname-doc"
source="${pkgname}-${pkgver}.tar.gz::https://codeberg.org/sewn/${pkgname}/archive/master.tar.gz"
builddir="$srcdir/$pkgname"

build() {
	export CFLAGS="$CFLAGS -Wno-incompatible-pointer-types"
	make
}

check() {
	:
}

package() {
	make PREFIX=/usr DESTDIR="$pkgdir" install
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

