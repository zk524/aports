pkgname=widle
pkgver=20250820
pkgrel=0
pkgdesc="Run a command upon becoming idle"
url="https://codeberg.org/sewn/widle"
arch="all"
license="GPL-3.0-or-later"
makedepends="wayland-protocols wayland-dev"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://codeberg.org/sewn/widle/archive/63a040494ec022612d32ee1f958753657dd363f2.tar.gz"
builddir="$srcdir/$pkgname"
options="!check"
	# no tests in project, so no checks in packaging

build() {
	export CFLAGS="$CFLAGS -Wno-incompatible-pointer-types"
	make
}

package() {
	make PREFIX=/usr DESTDIR="$pkgdir" install
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

