# Contributor: Kurt H Maier <khm@sciops.net>
# Maintainer: Kurt H Maier <khm@sciops.net>
pkgname=wlock
pkgver=20250820
pkgrel=0
pkgdesc="Itsy-bitsy session locker"
url="https://codeberg.org/sewn/wlock"
arch="all"
license="GPL-3.0-or-later"
makedepends="wayland-protocols wayland-dev libxkbcommon-dev"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://codeberg.org/sewn/$pkgname/archive/be975445fa0da7252f8e13b610c518dd472652d0.tar.gz"
builddir="$srcdir/$pkgname"
options="suid !check"
	# uses suid instead of PAM to validate passwd
	# no tests in source, so no check phase in packaging

build() {
	export CFLAGS="$CFLAGS -Wno-incompatible-pointer-types"
	make
}

package() {
	make PREFIX=/usr DESTDIR="$pkgdir" install
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

sha512sums="
