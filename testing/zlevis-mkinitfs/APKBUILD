maintainer="Luc Bijl <6msemf7ov@mozmail.com>"
pkgname=zlevis-mkinitfs
pkgver=1.2
pkgrel=0
pkgdesc="A mkinitfs module that implements automatic decryption of a ZFS rpool in the initramfs with zlevis"
url="https://git.ampel.dev/ampel/zlevis-mkinitfs"
arch="noarch"
license="GPL-2.0-only"
depends="zlevis mkinitfs"
makedepends="meson"
replaces="mkinitfs"
source="https://git.ampel.dev/ampel/zlevis-mkinitfs/releases/download/$pkgver/zlevis-mkinitfs-$pkgver.tar.xz"

build() {
	abuild-meson . output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

